# name: test/sql/algorithms/shortest_path_lengths.test
# description: shortest_path_lengths(graph, vertex label, edge label, source key): BFS hop distances from one
#              vertex; vertices it cannot reach are left out (= networkx.single_source_shortest_path_length).
# group: [algorithms]

require duckpgq

statement ok
SET active_grammar_extensions = ['duckpgq'];

statement ok
CREATE TABLE v (id BIGINT);

statement ok
INSERT INTO v VALUES (6), (5), (4), (3), (2), (1);

# 1 -> 2 -> 3 -> 4 and 1 -> 3; 5 -> 1 only reaches 1's side backwards; 6 isolated; a self-loop and a parallel edge.
statement ok
CREATE TABLE e (src BIGINT, dst BIGINT);

statement ok
INSERT INTO e VALUES (1, 2), (2, 3), (3, 4), (1, 3), (5, 1), (3, 3), (1, 2);

statement ok
CREATE PROPERTY GRAPH g VERTEX TABLES (v) EDGE TABLES (e SOURCE KEY (src) REFERENCES v (id) DESTINATION KEY (dst) REFERENCES v (id));

query II
SELECT id, distance FROM shortest_path_lengths('g', 'v', 'e', 1) ORDER BY id;
----
1	0
2	1
3	1
4	2

query II
SELECT id, distance FROM shortest_path_lengths('g', 'v', 'e', 1, directed := false) ORDER BY id;
----
1	0
2	1
3	1
4	2
5	1

query II
SELECT id, distance FROM shortest_path_lengths('g', 'v', 'e', 4) ORDER BY id;
----
4	0

query II
SELECT id, distance FROM shortest_path_lengths('g', 'v', 'e', 6, directed := false) ORDER BY id;
----
6	0

statement error
FROM shortest_path_lengths('g', 'v', 'e', 42);
----
Invalid Input Error: shortest_path_lengths: no vertex has the source key 42

statement error
FROM shortest_path_lengths('g', 'v', 'e', NULL);
----
Invalid Input Error: shortest_path_lengths: the source vertex key must not be NULL

# String keys, and no edges at all.
statement ok
CREATE TABLE sv (name VARCHAR);

statement ok
INSERT INTO sv VALUES ('b'), ('a'), ('it''s');

statement ok
CREATE TABLE se (a VARCHAR, b VARCHAR);

statement ok
CREATE PROPERTY GRAPH sg VERTEX TABLES (sv) EDGE TABLES (se SOURCE KEY (a) REFERENCES sv (name) DESTINATION KEY (b) REFERENCES sv (name));

query II
FROM shortest_path_lengths('sg', 'sv', 'se', 'it''s');
----
it's	0

statement ok
INSERT INTO se VALUES ('it''s', 'a'), ('a', 'b');

query II
FROM shortest_path_lengths('sg', 'sv', 'se', 'it''s') ORDER BY distance;
----
it's	0
a	1
b	2

# A long chain: one BFS level per hop.
statement ok
CREATE TABLE cv AS SELECT range AS id FROM range(100000);

statement ok
CREATE TABLE ce AS SELECT range AS src, range + 1 AS dst FROM range(99999);

statement ok
CREATE PROPERTY GRAPH cg VERTEX TABLES (cv) EDGE TABLES (ce SOURCE KEY (src) REFERENCES cv (id) DESTINATION KEY (dst) REFERENCES cv (id));

query III
SELECT count(*), max(distance), sum(distance) FROM shortest_path_lengths('cg', 'cv', 'ce', 0);
----
100000	99999	4999950000
