# name: test/sql/algorithms/betweenness_centrality.test
# description: betweenness_centrality: Brandes, exact or over k sampled sources, scaled as
#              networkx.betweenness_centrality (3.5). Parallel edges collapse, self-loops are ignored.
# group: [algorithms]

require duckpgq

statement ok
SET active_grammar_extensions = ['duckpgq'];

statement ok
CREATE TABLE v (id BIGINT);

statement ok
INSERT INTO v VALUES (7), (6), (5), (4), (3), (2), (1);

# A diamond 1 -> {2, 3} -> 4 (two shortest paths from 1 to 4), then 4 -> 5 -> 6; a parallel 1 -> 2, a self-loop on 4,
# and an isolated 7.
statement ok
CREATE TABLE e (src BIGINT, dst BIGINT);

statement ok
INSERT INTO e VALUES (1, 2), (1, 3), (2, 4), (3, 4), (4, 5), (1, 2), (4, 4), (5, 6);

statement ok
CREATE PROPERTY GRAPH g VERTEX TABLES (v) EDGE TABLES (e SOURCE KEY (src) REFERENCES v (id) DESTINATION KEY (dst) REFERENCES v (id));

# The values networkx.betweenness_centrality gives on this graph.
query II
SELECT id, round(betweenness_centrality, 9) FROM betweenness_centrality('g', 'v', 'e') ORDER BY id;
----
1	0.0
2	0.05
3	0.05
4	0.2
5	0.133333333
6	0.0
7	0.0

query II
SELECT id, round(betweenness_centrality, 9) FROM betweenness_centrality('g', 'v', 'e', normalized := false) ORDER BY id;
----
1	0.0
2	1.5
3	1.5
4	6.0
5	4.0
6	0.0
7	0.0

query II
SELECT id, round(betweenness_centrality, 9) FROM betweenness_centrality('g', 'v', 'e', directed := false) ORDER BY id;
----
1	0.033333333
2	0.1
3	0.1
4	0.433333333
5	0.266666667
6	0.0
7	0.0

query II
SELECT id, round(betweenness_centrality, 9) FROM betweenness_centrality('g', 'v', 'e', directed := false, normalized := false) ORDER BY id;
----
1	0.5
2	1.5
3	1.5
4	6.5
5	4.0
6	0.0
7	0.0

# Sampling every vertex is the exact computation.
query I
SELECT count(*) FROM betweenness_centrality('g', 'v', 'e') a JOIN betweenness_centrality('g', 'v', 'e', k := 7, seed := 42) b USING (id) WHERE abs(a.betweenness_centrality - b.betweenness_centrality) < 1e-12;
----
7

# The same seed samples the same sources.
query I
SELECT count(*) FROM betweenness_centrality('g', 'v', 'e', k := 3, seed := 9) a JOIN betweenness_centrality('g', 'v', 'e', k := 3, seed := 9) b USING (id) WHERE a.betweenness_centrality = b.betweenness_centrality;
----
7

# One sampled source says nothing about itself (networkx gives NaN): exactly one NULL.
query I
SELECT count(*) FILTER (WHERE betweenness_centrality IS NULL) FROM betweenness_centrality('g', 'v', 'e', k := 1);
----
1

statement error
FROM betweenness_centrality('g', 'v', 'e', k := 0);
----
Invalid Input Error: betweenness_centrality: k must be between 1 and the number of vertices (7), not 0

statement error
FROM betweenness_centrality('g', 'v', 'e', k := 8);
----
Invalid Input Error: betweenness_centrality: k must be between 1 and the number of vertices (7), not 8

statement error
FROM betweenness_centrality('g', 'v', 'e', nosuchoption := 1);
----
nosuchoption

# An explicit NULL means "not given".
query I
SELECT count(*) FROM betweenness_centrality('g', 'v', 'e', k := NULL, normalized := NULL) WHERE betweenness_centrality IS NOT NULL;
----
7

# No edges: zero everywhere, k still checked against the vertex count.
statement ok
CREATE TABLE ne (src BIGINT, dst BIGINT);

statement ok
CREATE PROPERTY GRAPH ng VERTEX TABLES (v) EDGE TABLES (ne SOURCE KEY (src) REFERENCES v (id) DESTINATION KEY (dst) REFERENCES v (id));

query II
SELECT count(*), sum(betweenness_centrality) FROM betweenness_centrality('ng', 'v', 'ne', k := 4);
----
7	0.0

statement error
FROM betweenness_centrality('ng', 'v', 'ne', k := 8);
----
k must be between 1 and the number of vertices (7), not 8

# Deleted vertex rows leave rowid gaps; they are not vertices, so the normalisation (and k) count 6 vertices.
statement ok
DELETE FROM v WHERE id = 7;

query II
SELECT id, round(betweenness_centrality, 9) FROM betweenness_centrality('g', 'v', 'e') ORDER BY id;
----
1	0.0
2	0.075
3	0.075
4	0.3
5	0.2
6	0.0

statement error
FROM betweenness_centrality('g', 'v', 'e', k := 7);
----
k must be between 1 and the number of vertices (6), not 7

# Exact betweenness is O(n * m); it stops at max_execution_time.
statement ok
CREATE TABLE cv AS SELECT range AS id FROM range(40000);

statement ok
CREATE TABLE ce AS SELECT range AS src, range + 1 AS dst FROM range(39999);

statement ok
CREATE PROPERTY GRAPH cg VERTEX TABLES (cv) EDGE TABLES (ce SOURCE KEY (src) REFERENCES cv (id) DESTINATION KEY (dst) REFERENCES cv (id));

statement ok
SET max_execution_time = 500;

statement error
FROM betweenness_centrality('cg', 'cv', 'ce');
----
maximum execution time

statement ok
SET max_execution_time = 0;

# Sampled, the same graph is quick.
query I
SELECT count(*) FROM betweenness_centrality('cg', 'cv', 'ce', k := 20, seed := 1);
----
40000
