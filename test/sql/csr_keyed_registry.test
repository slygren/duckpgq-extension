# name: test/sql/csr_keyed_registry.test
# description: Each CSR gets its own registry slot, so two of them can coexist in one query
# group: [sql]

# Every call site used to pass a hardcoded csr_id of 0, so all CSRs in a connection shared
# ONE registry slot. A second CSR built in the same query found initialized_v already true,
# skipped initialisation, and then had its edges appended to the FIRST CSR's arrays --
# running the bump pointers past the end.
#
# Measured on the build before this change, the joined query below died with:
#   INTERNAL Error: Attempted to access index 2 within vector of size 2
#   ... duckdb::CreateCsrEdgeFunction(...)
#
# Ids now come from DuckPGQState::AllocateCSRId(), monotonic and never reused while a slot
# is live, so a slot always means exactly one CSR.

require duckpgq


statement ok
SET active_grammar_extensions = ['duckpgq'];

statement ok
CREATE TABLE person(id BIGINT, name VARCHAR);

statement ok
INSERT INTO person VALUES (0, 'a'), (1, 'b'), (2, 'c'), (3, 'd');

# Two edge relations with deliberately different shapes, so a collision between their CSRs
# would change the numbers rather than happening to agree.
statement ok
CREATE TABLE knows(src BIGINT, dst BIGINT);

statement ok
INSERT INTO knows VALUES (0, 1), (1, 2), (2, 0);

statement ok
CREATE TABLE likes(src BIGINT, dst BIGINT);

statement ok
INSERT INTO likes VALUES (0, 3), (3, 0);

statement ok
CREATE PROPERTY GRAPH g
VERTEX TABLES ( person PROPERTIES (id, name) LABEL P )
EDGE TABLES (
    knows SOURCE KEY (src) REFERENCES person(id)
          DESTINATION KEY (dst) REFERENCES person(id)
          LABEL Knows,
    likes SOURCE KEY (src) REFERENCES person(id)
          DESTINATION KEY (dst) REFERENCES person(id)
          LABEL Likes
);

# Baselines, one CSR per query.
query IR
select id, round(pagerank, 4) from pagerank(g, p, knows) ORDER BY id;
----
0	0.3175
1	0.3175
2	0.3175
3	0.0476

query IR
select id, round(pagerank, 4) from pagerank(g, p, likes) ORDER BY id;
----
0	0.4348
1	0.0652
2	0.0652
3	0.4348

# Two CSRs in one query. Each column must equal its baseline above -- that equality is the
# assertion; a shared slot cannot produce it.
query IRR
select k.id, round(k.pagerank, 4) AS pr_knows, round(l.pagerank, 4) AS pr_likes
from pagerank(g, p, knows) k join pagerank(g, p, likes) l on k.id = l.id ORDER BY k.id;
----
0	0.3175	0.4348
1	0.3175	0.0652
2	0.3175	0.0652
3	0.0476	0.4348

# Two DIFFERENT algorithms, each needing its own CSR.
#
# Asserts the component SIZE rather than the componentId. The id is an arbitrary
# representative -- which vertex wins the race labels the component -- so it comes
# back as 1 or 2 for the {0,1,2} component depending on scheduling. Asserting it
# made this test fail roughly 1 run in 10, which manual `make test` hid (you just
# re-run) and the pre-push hook surfaced immediately. The partition is what the
# algorithm is being tested for, and the partition is stable.
query IIR
select w.id, count(*) OVER (PARTITION BY w.componentId) AS component_size,
       round(p.pagerank, 4) AS pr
from weakly_connected_component(g, p, knows) w join pagerank(g, p, likes) p on w.id = p.id ORDER BY w.id;
----
0	3	0.4348
1	3	0.0652
2	3	0.0652
3	1	0.4348

# Sequential queries in one connection must not inherit a previous query's CSR either.
query IR
select id, round(pagerank, 4) from pagerank(g, p, knows) ORDER BY id;
----
0	0.3175
1	0.3175
2	0.3175
3	0.0476
