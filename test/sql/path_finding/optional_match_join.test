# name: test/sql/path_finding/optional_match_join.test
# description: OPTIONAL MATCH is the left join of the whole optional pattern onto the bindings so far, for every shape
# group: [path_finding]

# Each case materialises the reference -- the mandatory GRAPH_TABLE LEFT JOIN the optional pattern's own
# GRAPH_TABLE on the shared variable -- and compares it both ways (EXCEPT ALL) with the OPTIONAL MATCH. The two
# sides are computed in separate statements on purpose: several GRAPH_TABLEs in one statement can trip DuckDB's
# common_subplan optimizer (a separate, pre-existing problem).

require duckpgq

statement ok
SET active_grammar_extensions = ['duckpgq'];

# 1 -> 2 (twice), 2 -> 3, 1 -> 3, 3 -> 4, 2 -> 4, 4 -> 1, 2 -> 1, 3 -> 5; 6 is isolated
statement ok
CREATE TABLE P(id BIGINT PRIMARY KEY, name VARCHAR);

statement ok
CREATE TABLE K(src BIGINT, dst BIGINT);

statement ok
INSERT INTO P VALUES (1,'a'),(2,'b'),(3,'c'),(4,'d'),(5,'e'),(6,'f');

statement ok
INSERT INTO K VALUES (1,2),(1,2),(2,3),(1,3),(3,4),(2,4),(4,1),(2,1),(3,5);

statement ok
CREATE PROPERTY GRAPH g VERTEX TABLES (P LABEL P)
EDGE TABLES (K SOURCE KEY (src) REFERENCES P (id) DESTINATION KEY (dst) REFERENCES P (id) LABEL K);

# The same graph with edges to a vertex that does not exist (6 -> 9, 9 -> 6, 1 -> 9)
statement ok
CREATE TABLE KD AS SELECT * FROM K UNION ALL VALUES (6, 9), (9, 6), (1, 9);

statement ok
CREATE PROPERTY GRAPH gd VERTEX TABLES (P LABEL P)
EDGE TABLES (KD SOURCE KEY (src) REFERENCES P (id) DESTINATION KEY (dst) REFERENCES P (id) LABEL K);

statement ok
SET pgq_disable_abi_rewrite = true;

# (t)-[e:K]->(x:P)  WHERE true
statement ok
CREATE OR REPLACE TABLE m AS SELECT * FROM GRAPH_TABLE (g MATCH (t:P) WHERE true COLUMNS (t.id AS t));

statement ok
CREATE OR REPLACE TABLE o AS SELECT * FROM GRAPH_TABLE (g MATCH (t:P)-[e:K]->(x:P) COLUMNS (t.id AS t, x.id AS x));

statement ok
CREATE OR REPLACE TABLE ref AS SELECT m.t, o.x FROM m LEFT JOIN o ON m.t = o.t;

statement ok
CREATE OR REPLACE TABLE act AS SELECT * FROM GRAPH_TABLE (g MATCH (t:P) OPTIONAL MATCH (t)-[e:K]->(x:P) WHERE true COLUMNS (t.id AS t, x.id AS x));

query III
SELECT (SELECT count(*) FROM ref) > 0, (SELECT count(*) FROM (FROM act EXCEPT ALL FROM ref)), (SELECT count(*) FROM (FROM ref EXCEPT ALL FROM act));
----
true	0	0

# (t)-[e:K]->(x:P)  WHERE t.id = 1
statement ok
CREATE OR REPLACE TABLE m AS SELECT * FROM GRAPH_TABLE (g MATCH (t:P) WHERE t.id = 1 COLUMNS (t.id AS t));

statement ok
CREATE OR REPLACE TABLE o AS SELECT * FROM GRAPH_TABLE (g MATCH (t:P)-[e:K]->(x:P) COLUMNS (t.id AS t, x.id AS x));

statement ok
CREATE OR REPLACE TABLE ref AS SELECT m.t, o.x FROM m LEFT JOIN o ON m.t = o.t;

statement ok
CREATE OR REPLACE TABLE act AS SELECT * FROM GRAPH_TABLE (g MATCH (t:P) OPTIONAL MATCH (t)-[e:K]->(x:P) WHERE t.id = 1 COLUMNS (t.id AS t, x.id AS x));

query III
SELECT (SELECT count(*) FROM ref) > 0, (SELECT count(*) FROM (FROM act EXCEPT ALL FROM ref)), (SELECT count(*) FROM (FROM ref EXCEPT ALL FROM act));
----
true	0	0

