# Hand-checked: the whole pattern matches or the row keeps NULLs. 3 -> 4 -> 1 matches, so 3 has no
# (3, 5, NULL) row although 3 -> 5 leads nowhere; 5 and 6 have no match at all.
query III
FROM GRAPH_TABLE (g MATCH (t:P) OPTIONAL MATCH (t)-[:K]->(x:P)-[:K]->(y:P) WHERE t.id >= 3
    COLUMNS (t.id AS t, x.id AS x, y.id AS y)) ORDER BY ALL;
----
3	4	1
4	1	2
4	1	2
4	1	3
5	NULL	NULL
6	NULL	NULL

# An edge to a missing vertex is no match: 1 keeps its three real edges and gets no NULL row for 1 -> 9,
# and 6 (only dangling edges) is kept once.
query II
FROM GRAPH_TABLE (gd MATCH (t:P) OPTIONAL MATCH (t)-[:K]->(x:P) WHERE t.id IN (1, 6)
    COLUMNS (t.id AS t, x.id AS x)) ORDER BY ALL;
----
1	2
1	2
1	3
6	NULL

# Undirected: the edge's own columns read as in a MATCH (oriented along the traversal)
query III
FROM GRAPH_TABLE (g MATCH (t:P) OPTIONAL MATCH (t)-[e:K]-(x:P) WHERE t.id IN (5, 6)
    COLUMNS (t.id AS t, e.src AS s, e.dst AS d)) ORDER BY ALL;
----
5	5	3
6	NULL	NULL

query IIII
FROM GRAPH_TABLE (g MATCH (t:P) OPTIONAL MATCH ANY SHORTEST (t)<-[:K]-+(x:P) WHERE t.id = 5
    COLUMNS (t.id AS t, x.id AS x, x.name AS n, t.name AS tn)) ORDER BY ALL;
----
5	1	a	e
5	2	b	e
5	3	c	e
5	4	d	e

# A self-loop is one undirected edge, read once as in a MATCH
statement ok
CREATE TABLE KL AS SELECT * FROM K UNION ALL VALUES (6, 6);

statement ok
CREATE PROPERTY GRAPH gl VERTEX TABLES (P LABEL P)
EDGE TABLES (KL SOURCE KEY (src) REFERENCES P (id) DESTINATION KEY (dst) REFERENCES P (id) LABEL K);

query II
FROM GRAPH_TABLE (gl MATCH (t:P) OPTIONAL MATCH (t)-[:K]-(x:P) WHERE t.id = 6 COLUMNS (t.id AS t, x.id AS x));
----
6	6

query I
SELECT count(*) FROM GRAPH_TABLE (gl MATCH (t:P)-[:K]-(x:P) WHERE t.id = 6 COLUMNS (t.id AS t));
----
1

# A path variable of the optional pattern is not carried out of it yet
statement error
FROM GRAPH_TABLE (g MATCH (t:P) OPTIONAL MATCH p = (t)-[:K]->{1,2}(x:P) COLUMNS (t.id AS t, path_length(p) AS l));
----
path variable 'p' of an OPTIONAL MATCH pattern

# An unused path variable is fine: 23 paths of 1 or 2 hops, and NULL rows for 5 and 6
query I
SELECT count(*) FROM GRAPH_TABLE (g MATCH (t:P) OPTIONAL MATCH p = (t)-[:K]->{1,2}(x:P) COLUMNS (t.id AS t, x.id AS x));
----
25

# ── With ABI artifacts: the optional pattern takes the artifact routes a MATCH of it would ──────────────
statement ok
SET pgq_disable_abi_rewrite = false;

statement ok
CREATE TABLE T(id BIGINT PRIMARY KEY, name VARCHAR);

statement ok
CREATE TABLE H(child BIGINT, parent BIGINT);

statement ok
INSERT INTO T VALUES (1,'root'),(2,'a'),(3,'b'),(4,'a1'),(5,'a2'),(6,'b1'),(7,'lonely');

statement ok
INSERT INTO H VALUES (2,1),(3,1),(4,2),(5,2),(6,3);

statement ok
CREATE PROPERTY GRAPH h VERTEX TABLES (T LABEL T)
EDGE TABLES (H SOURCE KEY (child) REFERENCES T (id) DESTINATION KEY (parent) REFERENCES T (id) LABEL H);

statement ok
SELECT count(*) FROM pgq_abi_build('h', exclude_self_referential := false, closures := ['H']);

query T
SELECT status = 'match' FROM pgq_verify_abi_rewrite('FROM GRAPH_TABLE (h MATCH (t:T) OPTIONAL MATCH ANY SHORTEST (t)-[:H]->+(x:T) COLUMNS (t.id AS t, x.id AS x))');
----
true

query T
SELECT status = 'match' FROM pgq_verify_abi_rewrite('FROM GRAPH_TABLE (h MATCH (t:T) OPTIONAL MATCH ALL SHORTEST (t)-[:H]->+(x:T) COLUMNS (t.id AS t, x.id AS x))');
----
true

query T
SELECT status = 'match' FROM pgq_verify_abi_rewrite('FROM GRAPH_TABLE (h MATCH (t:T) OPTIONAL MATCH (t)-[:H]->(x:T)-[:H]->(y:T) COLUMNS (t.id AS t, x.id AS x, y.id AS y))');
----
true

query T
SELECT status = 'match' FROM pgq_verify_abi_rewrite('FROM GRAPH_TABLE (h MATCH (t:T) OPTIONAL MATCH (t)-[:H]->{1,3}(x:T) COLUMNS (t.id AS t, x.id AS x))');
----
true

query T
SELECT status IN ('match', 'unverified') FROM pgq_verify_abi_rewrite('FROM GRAPH_TABLE (h MATCH (t:T) OPTIONAL MATCH ANY SHORTEST (t)<-[:H]-+(x:T) COLUMNS (t.id AS t, x.id AS x))');
----
true

query T
