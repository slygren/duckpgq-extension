----
true

query T
SELECT status = 'match' FROM pgq_verify_abi_rewrite('FROM GRAPH_TABLE (h MATCH (t:T) OPTIONAL MATCH (t)-[e:H]->(x:T), (t)<-[f:H]-(y:T) COLUMNS (t.id AS t, x.id AS x, y.id AS y))');
----
true

query II
SELECT status, rewrite_fired FROM pgq_verify_abi_rewrite('FROM GRAPH_TABLE (h MATCH (t:T) OPTIONAL MATCH ANY SHORTEST (t)-[:H]->+(x:T) WHERE t.id = 4 COLUMNS (t.id AS t, x.id AS x))');
----
match	true

query II
FROM GRAPH_TABLE (h MATCH (t:T) OPTIONAL MATCH ANY SHORTEST (t)-[:H]->+(x:T) WHERE t.id IN (4, 7) COLUMNS (t.id AS t, x.id AS x)) ORDER BY ALL;
----
4	1
4	2
7	NULL
