# name: test/sql/path_finding/union_aggregates.test
# description: Aggregates and window functions in a COLUMNS shared by path pattern union operands or UNION ALL blocks are computed once over all rows
# group: [path_finding]

# Each query is compared with the explicit outer aggregate over the same GRAPH_TABLE without it, each side
# materialised in its own statement.

require duckpgq

statement ok
SET active_grammar_extensions = ['duckpgq'];

statement ok
CREATE TABLE P(id BIGINT PRIMARY KEY, name VARCHAR);

statement ok
CREATE TABLE K(src BIGINT, dst BIGINT);

statement ok
INSERT INTO P VALUES (1, 'a'), (2, 'b'), (3, 'c'), (4, 'd'), (5, 'e'), (6, 'f');

statement ok
INSERT INTO K VALUES (1, 2), (1, 2), (2, 3), (1, 3), (3, 4), (2, 4), (4, 1), (2, 1), (3, 5);

statement ok
CREATE PROPERTY GRAPH g VERTEX TABLES (P LABEL P)
EDGE TABLES (K SOURCE KEY (src) REFERENCES P (id) DESTINATION KEY (dst) REFERENCES P (id) LABEL K);

# The reported case: |+| with count(*) gave one count per operand (9, 9)
query I
FROM GRAPH_TABLE (g MATCH (a:P)-[:K]->(b:P) |+| (a:P)<-[:K]-(b:P) COLUMNS (count(*)));
----
18

# (a:P)-[:K]->(b:P) |+| (a:P)<-[:K]-(b:P) 
statement ok
CREATE OR REPLACE TABLE act AS FROM GRAPH_TABLE (g MATCH (a:P)-[:K]->(b:P) |+| (a:P)<-[:K]-(b:P)  COLUMNS (count(*) AS n, sum(b.id) AS s, min(a.id) AS mi, max(b.name) AS mx));

statement ok
CREATE OR REPLACE TABLE ref AS SELECT count(*), sum(b), min(a), max(bn) FROM GRAPH_TABLE (g MATCH (a:P)-[:K]->(b:P) |+| (a:P)<-[:K]-(b:P)  COLUMNS (a.id AS a, b.id AS b, b.name AS bn));

query III
SELECT (SELECT count(*) FROM act), (SELECT count(*) FROM (FROM act EXCEPT ALL FROM ref)), (SELECT count(*) FROM (FROM ref EXCEPT ALL FROM act));
----
1	0	0

# (a:P)-[:K]->(b:P) | (a:P)-[:K]->(b:P) 
statement ok
CREATE OR REPLACE TABLE act AS FROM GRAPH_TABLE (g MATCH (a:P)-[:K]->(b:P) | (a:P)-[:K]->(b:P)  COLUMNS (count(*) AS n, count(DISTINCT b.id) AS d));

statement ok
CREATE OR REPLACE TABLE ref AS SELECT count(*), count(DISTINCT b) FROM GRAPH_TABLE (g MATCH (a:P)-[:K]->(b:P) | (a:P)-[:K]->(b:P)  COLUMNS (a.id AS a, b.id AS b));

query III
SELECT (SELECT count(*) FROM act), (SELECT count(*) FROM (FROM act EXCEPT ALL FROM ref)), (SELECT count(*) FROM (FROM ref EXCEPT ALL FROM act));
----
1	0	0

# (a:P)-[:K]->(b:P) | (a:P)<-[:K]-(b:P) WHERE a.id < 4
statement ok
CREATE OR REPLACE TABLE act AS FROM GRAPH_TABLE (g MATCH (a:P)-[:K]->(b:P) | (a:P)<-[:K]-(b:P) WHERE a.id < 4 COLUMNS (count(*) AS n, list(b.id ORDER BY a.id, b.id) AS l));

statement ok
CREATE OR REPLACE TABLE ref AS SELECT count(*), list(b ORDER BY a, b) FROM GRAPH_TABLE (g MATCH (a:P)-[:K]->(b:P) | (a:P)<-[:K]-(b:P) WHERE a.id < 4 COLUMNS (a.id AS a, b.id AS b));

query III
SELECT (SELECT count(*) FROM act), (SELECT count(*) FROM (FROM act EXCEPT ALL FROM ref)), (SELECT count(*) FROM (FROM ref EXCEPT ALL FROM act));
----
1	0	0

# (a:P)-[:K]->?(b:P) 
statement ok
CREATE OR REPLACE TABLE act AS FROM GRAPH_TABLE (g MATCH (a:P)-[:K]->?(b:P)  COLUMNS (count(*) AS n, max(b.id) + count(DISTINCT a.id) AS m));

statement ok
CREATE OR REPLACE TABLE ref AS SELECT count(*), max(b) + count(DISTINCT a) FROM GRAPH_TABLE (g MATCH (a:P)-[:K]->?(b:P)  COLUMNS (a.id AS a, b.id AS b));

query III
SELECT (SELECT count(*) FROM act), (SELECT count(*) FROM (FROM act EXCEPT ALL FROM ref)), (SELECT count(*) FROM (FROM ref EXCEPT ALL FROM act));
----
1	0	0

# (a:P)-[:K]->{0,1}(b:P) WHERE a.id = 1
statement ok
CREATE OR REPLACE TABLE act AS FROM GRAPH_TABLE (g MATCH (a:P)-[:K]->{0,1}(b:P) WHERE a.id = 1 COLUMNS (count(*) AS n, string_agg(b.name, ',' ORDER BY b.name) AS s));

statement ok
CREATE OR REPLACE TABLE ref AS SELECT count(*), string_agg(bn, ',' ORDER BY bn) FROM GRAPH_TABLE (g MATCH (a:P)-[:K]->{0,1}(b:P) WHERE a.id = 1 COLUMNS (a.id AS a, b.name AS bn));

query III
SELECT (SELECT count(*) FROM act), (SELECT count(*) FROM (FROM act EXCEPT ALL FROM ref)), (SELECT count(*) FROM (FROM ref EXCEPT ALL FROM act));
----
1	0	0

# p = (a:P)-[:K]->{1,2}(b:P) |+| (a:P)<-[:K]-(b:P) 
statement ok
CREATE OR REPLACE TABLE act AS FROM GRAPH_TABLE (g MATCH p = (a:P)-[:K]->{1,2}(b:P) |+| (a:P)<-[:K]-(b:P)  COLUMNS (sum(path_length(p)) AS s, avg(path_length(p)) AS v));

statement ok
CREATE OR REPLACE TABLE ref AS SELECT sum(l), avg(l) FROM GRAPH_TABLE (g MATCH p = (a:P)-[:K]->{1,2}(b:P) |+| (a:P)<-[:K]-(b:P)  COLUMNS (path_length(p) AS l));

query III
SELECT (SELECT count(*) FROM act), (SELECT count(*) FROM (FROM act EXCEPT ALL FROM ref)), (SELECT count(*) FROM (FROM ref EXCEPT ALL FROM act));
----
1	0	0

# (a:P)-[:K]->(b:P) |+| (a:P)<-[:K]-(b:P) 
statement ok
CREATE OR REPLACE TABLE act AS FROM GRAPH_TABLE (g MATCH (a:P)-[:K]->(b:P) |+| (a:P)<-[:K]-(b:P)  COLUMNS (count(*) FILTER (WHERE a.id < 3) AS f, sum(b.id) / count(*) AS r));

statement ok
CREATE OR REPLACE TABLE ref AS SELECT count(*) FILTER (WHERE a < 3), sum(b) / count(*) FROM GRAPH_TABLE (g MATCH (a:P)-[:K]->(b:P) |+| (a:P)<-[:K]-(b:P)  COLUMNS (a.id AS a, b.id AS b));

query III
SELECT (SELECT count(*) FROM act), (SELECT count(*) FROM (FROM act EXCEPT ALL FROM ref)), (SELECT count(*) FROM (FROM ref EXCEPT ALL FROM act));
----
1	0	0

# MATCH (a:P)-[:K]->(b:P) UNION ALL MATCH (a:P)<-[:K]-(b:P)
statement ok
CREATE OR REPLACE TABLE act AS FROM GRAPH_TABLE (g MATCH (a:P)-[:K]->(b:P) UNION ALL MATCH (a:P)<-[:K]-(b:P) COLUMNS (count(*) AS n, sum(b.id) AS s, list(a.id ORDER BY a.id, b.id) AS l));

statement ok
CREATE OR REPLACE TABLE ref AS SELECT count(*), sum(b), list(a ORDER BY a, b) FROM GRAPH_TABLE (g MATCH (a:P)-[:K]->(b:P) UNION ALL MATCH (a:P)<-[:K]-(b:P) COLUMNS (a.id AS a, b.id AS b));

query III
SELECT (SELECT count(*) FROM act), (SELECT count(*) FROM (FROM act EXCEPT ALL FROM ref)), (SELECT count(*) FROM (FROM ref EXCEPT ALL FROM act));
----
1	0	0

# MATCH (a:P)-[:K]->(b:P) |+| (a:P)-[:K]-(b:P) UNION ALL MATCH (a:P)<-[:K]-(b:P)
statement ok
CREATE OR REPLACE TABLE act AS FROM GRAPH_TABLE (g MATCH (a:P)-[:K]->(b:P) |+| (a:P)-[:K]-(b:P) UNION ALL MATCH (a:P)<-[:K]-(b:P) COLUMNS (count(*) AS n, max(a.id) AS m));

statement ok
CREATE OR REPLACE TABLE ref AS SELECT count(*), max(a) FROM GRAPH_TABLE (g MATCH (a:P)-[:K]->(b:P) |+| (a:P)-[:K]-(b:P) UNION ALL MATCH (a:P)<-[:K]-(b:P) COLUMNS (a.id AS a));

query III
SELECT (SELECT count(*) FROM act), (SELECT count(*) FROM (FROM act EXCEPT ALL FROM ref)), (SELECT count(*) FROM (FROM ref EXCEPT ALL FROM act));
----
1	0	0

# A window function numbers the rows of both operands as one set
statement ok
CREATE OR REPLACE TABLE act AS FROM GRAPH_TABLE (g MATCH (a:P)-[:K]->(b:P) |+| (a:P)<-[:K]-(b:P)
    COLUMNS (a.id AS a, b.id AS b, row_number() OVER (ORDER BY a.id, b.id) AS r, count(*) OVER () AS c));

statement ok
CREATE OR REPLACE TABLE ref AS SELECT a, b, row_number() OVER (ORDER BY a, b) AS r, count(*) OVER () AS c FROM GRAPH_TABLE (g
    MATCH (a:P)-[:K]->(b:P) |+| (a:P)<-[:K]-(b:P) COLUMNS (a.id AS a, b.id AS b));

query III
SELECT (SELECT max(r) FROM act), (SELECT count(*) FROM (SELECT a, b, c FROM act EXCEPT ALL SELECT a, b, c FROM ref)), (SELECT count(DISTINCT r) FROM act);
----
18	0	18

# Each block with its own COLUMNS aggregates its own rows, as in a SQL UNION (9 edges; 4 into 1 or 2)
query I
FROM GRAPH_TABLE (g MATCH (a:P)-[:K]->(b:P) COLUMNS (count(*)) UNION ALL MATCH (a:P)<-[:K]-(b:P) WHERE a.id < 3 COLUMNS (count(*)))
ORDER BY ALL;
----
4
9

# ... but not when such a block is itself a path pattern union: refused
statement error
FROM GRAPH_TABLE (g MATCH (a:P)-[:K]->(b:P) |+| (a:P)<-[:K]-(b:P) COLUMNS (count(*)) UNION ALL MATCH (a:P)<-[:K]-(b:P) COLUMNS (count(*)));
----
path pattern union

# UNION without ALL: which rows it removes before aggregating is not defined, refused
statement error
FROM GRAPH_TABLE (g MATCH (a:P)-[:K]->(b:P) UNION MATCH (a:P)<-[:K]-(b:P) COLUMNS (count(*)));
----
UNION (without ALL) is not supported

# Without a union nothing changes
query I
FROM GRAPH_TABLE (g MATCH (a:P)-[:K]->(b:P) COLUMNS (count(*)));
----
9
