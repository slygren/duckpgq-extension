# name: test/sql/path_finding/top_k.test
# description: SHORTEST k (top-k shortest paths); its semantics are checked in shortest_k.test
# group: [path_finding]

require duckpgq

# The SQL/PGQ grammar is connection-local and must be activated explicitly.
statement ok
SET active_grammar_extensions = ['duckpgq'];

statement ok
CREATE TABLE Student(id BIGINT, name VARCHAR); INSERT INTO Student VALUES (0, 'Daniel'), (1, 'Tavneet'), (2, 'Gabor'), (3, 'Peter'), (4, 'David');

statement ok
CREATE TABLE know(src BIGINT, dst BIGINT, createDate BIGINT); INSERT INTO know VALUES (0,1, 10), (0,2, 11), (0,3, 12), (3,0, 13), (1,2, 14), (1,3, 15), (2,3, 16), (4,3, 17);

statement ok
CREATE PROPERTY GRAPH pg
VERTEX TABLES (
    Student LABEL person
    )
EDGE TABLES (
    know    SOURCE KEY ( src ) REFERENCES Student ( id )
            DESTINATION KEY ( dst ) REFERENCES Student ( id )
            label knows
    );

statement error
FROM GRAPH_TABLE (pg
    MATCH
    p = ANY SHORTEST 5 WALK (a:Person)-[k:knows]-> *(b:Person)
    WHERE a.name = 'Daniel'
    COLUMNS (p, a.name as name, b.name as school)
    ) study;
----
Parser Error: syntax error at or near "5"


# The five shortest walks from Daniel to each student, the empty walk to Daniel included (David is not reachable)
query II
SELECT b, count(*) FROM GRAPH_TABLE (pg
        MATCH
        p =  SHORTEST 5 (a:Person)-[k:knows]-> *(b:Person)
        WHERE a.name = 'Daniel'
        COLUMNS (b.name AS b)) GROUP BY ALL ORDER BY ALL;
----
Daniel	5
Gabor	5
Peter	5
Tavneet	5

query III
FROM GRAPH_TABLE (pg
        MATCH
        p =  SHORTEST 2 WALK (a:Person)-[k:knows]-> *(b:Person)
        WHERE a.name = 'Daniel' AND b.name = 'Peter'
        COLUMNS (b.name AS b, path_length(p) AS l, vertices(p) AS vs)) ORDER BY ALL;
----
Peter	1	[0, 3]
Peter	2	[0, 1, 3]

statement error
FROM GRAPH_TABLE (pg
        MATCH
        p =  ANY SHORTEST 5 WALK (a:Person)-[k:knows]-> *(b:Person)
        WHERE a.name = 'Daniel');
----
Parser Error: syntax error at or near "5"
