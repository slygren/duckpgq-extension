# name: test/sql/path_finding/selectors_syntax.test
# description: The SQL/PGQ search prefixes as the standard writes them -- ANY [k], SHORTEST [k] [mode] [PATH|PATHS]
#              GROUP(S), ALL, and PATH / PATHS after a selector or mode -- over quantified and fixed-length patterns,
#              with OPTIONAL MATCH, the budget and the refusals. Brute-force comparisons are in
#              selectors_any_groups.test.
# group: [path_finding]

require duckpgq

statement ok
SET active_grammar_extensions = ['duckpgq'];

# 1 -> 2 (twice), 2 -> 3, 1 -> 3, 3 -> 4, 2 -> 4, 4 -> 1, 2 -> 1, 3 -> 5, 5 -> 5
statement ok
CREATE TABLE P(id BIGINT PRIMARY KEY, name VARCHAR);

statement ok
INSERT INTO P VALUES (1, 'a'), (2, 'b'), (3, 'c'), (4, 'd'), (5, 'e'), (6, 'f');

statement ok
CREATE TABLE K(src BIGINT, dst BIGINT);

statement ok
INSERT INTO K VALUES (1, 2), (1, 2), (2, 3), (1, 3), (3, 4), (2, 4), (4, 1), (2, 1), (3, 5), (5, 5);

statement ok
CREATE PROPERTY GRAPH g VERTEX TABLES (P LABEL P)
EDGE TABLES (K SOURCE KEY (src) REFERENCES P (id) DESTINATION KEY (dst) REFERENCES P (id) LABEL K);

statement ok
SET pgq_disable_abi_rewrite = true;

# --- ANY k: k paths per pair, the ones SHORTEST k returns

query II
FROM GRAPH_TABLE (g MATCH p = ANY 2 (a:P WHERE a.id = 1)-[e:K]->+(b:P WHERE b.id = 4) COLUMNS (path_length(p) AS l, edges(p) AS es)) ORDER BY ALL;
----
2	[0, 5]
2	[1, 5]

# ANY is ANY 1
query II
FROM GRAPH_TABLE (g MATCH p = ANY (a:P WHERE a.id = 1)-[e:K]->+(b:P) COLUMNS (b.id AS b, edges(p) AS es)) ORDER BY ALL;
----
1	[0, 7]
2	[0]
3	[3]
4	[0, 5]
5	[3, 8]

query II
FROM GRAPH_TABLE (g MATCH p = ANY ACYCLIC PATHS (a:P WHERE a.id = 1)-[e:K]->+(b:P WHERE b.id = 5) COLUMNS (path_length(p) AS l, edges(p) AS es));
----
2	[3, 8]

# --- SHORTEST k GROUP(S): every path of the k shortest lengths

query II
FROM GRAPH_TABLE (g MATCH p = SHORTEST 2 GROUPS (a:P WHERE a.id = 1)-[e:K]->+(b:P WHERE b.id = 4) COLUMNS (path_length(p) AS l, edges(p) AS es)) ORDER BY ALL;
----
2	[0, 5]
2	[1, 5]
2	[3, 4]
3	[0, 2, 4]
3	[1, 2, 4]

# GROUP and GROUPS, without k (one group), with the mode before GROUP, with PATH / PATHS
query I
SELECT count(*) FROM GRAPH_TABLE (g MATCH SHORTEST GROUP (a:P WHERE a.id = 1)-[e:K]->+(b:P WHERE b.id = 4) COLUMNS (a.id));
----
3

query I
SELECT count(*) FROM GRAPH_TABLE (g MATCH SHORTEST 1 PATH GROUP (a:P WHERE a.id = 1)-[e:K]->+(b:P WHERE b.id = 4) COLUMNS (a.id));
----
3

query I
SELECT count(*) FROM GRAPH_TABLE (g MATCH SHORTEST 3 ACYCLIC PATHS GROUPS (a:P WHERE a.id = 1)-[e:K]->+(b:P WHERE b.id = 5) COLUMNS (a.id));
----
3

# walks: the self-loop on 5 gives a walk of every length, and the search still ends
query II
FROM GRAPH_TABLE (g MATCH p = SHORTEST 3 GROUPS (a:P WHERE a.id = 3)-[e:K]->+(b:P WHERE b.id = 5) COLUMNS (path_length(p) AS l, edges(p) AS es)) ORDER BY ALL;
----
1	[8]
2	[8, 9]
3	[8, 9, 9]

query I
SELECT count(*) FROM GRAPH_TABLE (g MATCH SHORTEST 4 GROUPS (a:P)-[e:K]-+(b:P) COLUMNS (a.id));
----
3553

# the same from an enumeration of the undirected walks
query II
WITH RECURSIVE st AS (SELECT src s, dst t FROM K UNION ALL SELECT dst, src FROM K WHERE src <> dst),
w(src, cur, d) AS (SELECT s, t, 1 FROM st UNION ALL SELECT w.src, st.t, w.d + 1 FROM w JOIN st ON st.s = w.cur WHERE w.d < 8)
SELECT count(*), max(d) < 8 FROM (SELECT * FROM w QUALIFY dense_rank() OVER (PARTITION BY src, cur ORDER BY d) <= 4);
----
3553	true

# fewer lengths than asked for: all of them
query II
FROM GRAPH_TABLE (g MATCH p = SHORTEST 5 ACYCLIC GROUPS (a:P WHERE a.id = 1)-[e:K]->+(b:P WHERE b.id = 5) COLUMNS (path_length(p) AS l, edges(p) AS es)) ORDER BY ALL;
----
2	[3, 8]
3	[0, 2, 8]
3	[1, 2, 8]

# ONE ROW PER and OPTIONAL MATCH
query III
FROM GRAPH_TABLE (g MATCH SHORTEST 2 GROUPS (a:P WHERE a.id = 3)-[e:K]->+(b:P WHERE b.id = 5) ONE ROW PER STEP (v1, x, v2)
                  COLUMNS (v1.id AS v1, x.rowid AS x, v2.id AS v2)) ORDER BY ALL;
----
3	8	5
3	8	5
5	9	5

query II
FROM GRAPH_TABLE (g MATCH (t:P) OPTIONAL MATCH SHORTEST 2 GROUPS (t)-[e:K]->{1,2}(x:P WHERE x.id = 5) WHERE t.id IN (2, 5, 6)
                  COLUMNS (t.id AS t, x.id AS x)) ORDER BY ALL;
----
2	5
5	5
5	5
6	NULL

# the search is reported
query I
SELECT count(*) FROM GRAPH_TABLE (g MATCH SHORTEST 2 GROUPS (a:P WHERE a.id = 1)-[e:K]->+(b:P) COLUMNS (b.id AS b));
----
23

query TT
SELECT rewrite_type, reason FROM pgq_last_rewrite_diagnostics() WHERE rewrite_type = 'path_search';
----
path_search	native path search: the 2 shortest lengths per pair, walk, steps 1..1073741824

# --- fixed-length patterns: every path has the one length

# ANY k / SHORTEST k: the first k per pair of endpoints by element row ids (1 -> 2 has two parallel edges)
query II
FROM GRAPH_TABLE (g MATCH ANY 1 (a:P WHERE a.id = 1)-[e:K]->(b:P) COLUMNS (b.id AS b, e.rowid AS e)) ORDER BY ALL;
----
2	0
3	3

query II
FROM GRAPH_TABLE (g MATCH SHORTEST 2 (a:P WHERE a.id = 1)-[e:K]->(b:P) COLUMNS (b.id AS b, e.rowid AS e)) ORDER BY ALL;
----
2	0
2	1
3	3

# SHORTEST k GROUP: all of them
query I
SELECT count(*) FROM GRAPH_TABLE (g MATCH SHORTEST 2 GROUPS (a:P)-[e:K]->(b:P)-[f:K]->(c:P) COLUMNS (a.id));
----
20

# one vertex: its zero-length path
query I
SELECT count(*) FROM GRAPH_TABLE (g MATCH ANY 3 (a:P) COLUMNS (a.id));
----
6

# --- ALL: every path, as without a prefix; PATH / PATHS after a mode

query I
SELECT count(*) FROM GRAPH_TABLE (g MATCH ALL (a:P)-[e:K]->{1,2}(b:P) WHERE a.id = 1 COLUMNS (a.id));
----
9

query I
SELECT count(*) FROM GRAPH_TABLE (g MATCH (a:P)-[e:K]->{1,2}(b:P) WHERE a.id = 1 COLUMNS (a.id));
----
9

query I
SELECT count(*) FROM GRAPH_TABLE (g MATCH ALL TRAIL PATHS (a:P)-[e:K]->{1,2}(b:P) WHERE a.id = 1 COLUMNS (a.id));
----
9

query I
SELECT count(*) FROM GRAPH_TABLE (g MATCH ANY SHORTEST PATH (a:P)-[e:K]->+(b:P) WHERE a.id = 1 COLUMNS (a.id));
----
5

query I
SELECT count(*) FROM GRAPH_TABLE (g MATCH ALL (a:P)-[:K]->(b:P) |+| (a:P)<-[:K]-(b:P) WHERE a.id = 1 COLUMNS (a.id));
----
5

# a path variable may be called path
query I
SELECT count(*) FROM GRAPH_TABLE (g MATCH path = ANY 2 (a:P WHERE a.id = 1)-[e:K]->+(b:P WHERE b.id = 4) COLUMNS (path_length(path)));
----
2

# --- the budget counts the search

statement ok
SET pgq_max_vl_fallback_rows = 40;

statement error
FROM GRAPH_TABLE (g MATCH SHORTEST 3 GROUPS (a:P)-[e:K]-+(b:P) COLUMNS (a.id AS a, b.id AS b));
----
exceeding pgq_max_vl_fallback_rows (40)

statement ok
RESET pgq_max_vl_fallback_rows;

# --- refusals

statement error
FROM GRAPH_TABLE (g MATCH SHORTEST 2 GROUPS (a:P)-[e:K]->+(b:P)-[f:K]->(c:P) COLUMNS (a.id AS a));
----
SHORTEST k GROUPS is supported for one quantified edge between two vertices

statement error
FROM GRAPH_TABLE (g MATCH ANY 2 (a:P)-[e:K]->(b:P)-[f:K]->+(c:P) COLUMNS (a.id AS a));
----
ANY k is supported for one quantified edge between two vertices

statement error
FROM GRAPH_TABLE (g MATCH SHORTEST 2 TRAIL GROUPS ACYCLIC (a:P)-[e:K]->+(b:P) COLUMNS (a.id AS a));
----
A path pattern has one path mode

statement error
FROM GRAPH_TABLE (g MATCH PATHS (a:P)-[e:K]->+(b:P) COLUMNS (a.id AS a));
----
PATH / PATHS follows a search prefix or a path mode

statement error
FROM GRAPH_TABLE (g MATCH ANY 0 (a:P)-[e:K]->+(b:P) COLUMNS (a.id AS a));
----
ANY k requires a positive k

statement error
FROM GRAPH_TABLE (g MATCH SHORTEST 0 GROUPS (a:P)-[e:K]->+(b:P) COLUMNS (a.id AS a));
----
SHORTEST k GROUP requires a positive k

statement error
FROM GRAPH_TABLE (g MATCH ANY 2 (a:P)-[e:K]->+(b:P) |+| (a:P)<-[e:K]-(b:P) COLUMNS (a.id AS a));
----
over a path pattern union is not supported

# --- with ABI artifacts: no artifact holds the k shortest lengths, so the search answers

statement ok
SET pgq_disable_abi_rewrite = false;

statement ok
SELECT count(*) FROM pgq_abi_build('g', exclude_self_referential := false, closures := ['K']);

query I
SELECT count(*) FROM GRAPH_TABLE (g MATCH SHORTEST 2 GROUPS (a:P WHERE a.id = 1)-[e:K]->+(b:P WHERE b.id = 4) COLUMNS (a.id));
----
5

statement ok
SET pgq_require_abi_paths = true;

statement error
FROM GRAPH_TABLE (g MATCH ANY 2 (a:P)-[e:K]->+(b:P) WHERE a.id = 1 COLUMNS (a.id AS a, b.id AS b));
----
pgq_require_abi_paths

statement ok
SET pgq_require_abi_paths = false;
