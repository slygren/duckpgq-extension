# name: test/sql/path_finding/abi_closure_semantics.test
# description: Closure and expansion artifacts answer a variable-length pattern only where they give the traversal's paths
# group: [path_finding]

# The traversal returns simple paths: no vertex twice, never back to the start. The closure artifacts hold
# less: tc one row per (v0, v1, depth), tc_witness one shortest path per pair, tc_chain the longest chain per
# source. They used to answer every shape regardless, so e.g. a walk pattern answered from tc_chain lost every
# path but the longest one per source. A closure now answers only what it can prove: pgq_abi_build measures
# preserves_multiplicity (acyclic, depth cap not reached, one path per row; tc_chain also out-degree <= 1),
# and without that proof only ANY SHORTEST from depth 1 is taken from it. The rest is traversed.

require duckpgq

statement ok
SET active_grammar_extensions = ['duckpgq'];

# =====================================================================================================================
# The reported shapes: a chain 1 -> 2 -> 3 -> 4
# =====================================================================================================================

statement ok
CREATE TABLE cp(id BIGINT PRIMARY KEY);

statement ok
CREATE TABLE ck(src BIGINT, dst BIGINT);

statement ok
INSERT INTO cp VALUES (1), (2), (3), (4);

statement ok
INSERT INTO ck VALUES (1, 2), (2, 3), (3, 4);

statement ok
CREATE PROPERTY GRAPH chain_g VERTEX TABLES (cp LABEL Person)
EDGE TABLES (ck SOURCE KEY (src) REFERENCES cp (id) DESTINATION KEY (dst) REFERENCES cp (id) LABEL Knows);

statement ok
FROM pgq_abi_build('chain_g', exclude_self_referential := false, closures := ['Knows']);

# A chain is exact for every closure kind
query TT
SELECT path_kind, preserves_multiplicity FROM graph.__pgq_path_catalog
WHERE graph_name = 'chain_g' AND path_kind IN ('transitive_closure', 'tc_witness', 'tc_chain') ORDER BY ALL;
----
tc_chain	true
tc_witness	true
transitive_closure	true

# Every walk, not one per source (was 3 rows: only each source's longest prefix)
query III rowsort
FROM GRAPH_TABLE (chain_g MATCH p = (a:Person)-[k:Knows]->{1,2}(b:Person) COLUMNS (a.id AS a, b.id AS b, path_length(p)));
----
1	2	1
1	3	2
2	3	1
2	4	2
3	4	1

query T
SELECT rewrite_type FROM pgq_last_rewrite_diagnostics() WHERE status = 'selected';
----
tc_chain_named_path

# ANY SHORTEST from one source: every reachable vertex (was only the end of the longest chain)
query II rowsort
FROM GRAPH_TABLE (chain_g MATCH p = ANY SHORTEST (a:Person)-[:Knows]->{1,3}(b:Person) WHERE a.id = 1
    COLUMNS (b.id AS b, path_length(p)));
----
2	1
3	2
4	3

query TT
SELECT status, rewrite_fired FROM pgq_verify_abi_rewrite('FROM GRAPH_TABLE (chain_g MATCH p = (a:Person)-[k:Knows]->{1,2}(b:Person)
    COLUMNS (a.id AS a, b.id AS b, path_length(p)))');
----
match	true

query TT
SELECT status, rewrite_fired FROM pgq_verify_abi_rewrite('FROM GRAPH_TABLE (chain_g MATCH p = ANY SHORTEST (a:Person)-[:Knows]->{1,3}(b:Person)
    WHERE a.id = 1 COLUMNS (b.id AS b, path_length(p)))');
----
match	true

query TT
SELECT status, rewrite_fired FROM pgq_verify_abi_rewrite('FROM GRAPH_TABLE (chain_g MATCH (a:Person)-[:Knows]->{2,3}(b:Person)
    ONE ROW PER STEP (v1, e, v2) WHERE a.id = 1 COLUMNS (b.id AS b, v1.id AS x, v2.id AS y))');
----
match	true

query TT
SELECT status, rewrite_fired FROM pgq_verify_abi_rewrite('FROM GRAPH_TABLE (chain_g MATCH (a:Person)-[:Knows]->{1,3}(b:Person)
    ONE ROW PER VERTEX (v) WHERE b.id = 4 COLUMNS (a.id AS a, v.id AS v))');
----
match	true

# =====================================================================================================================
# A diamond with a cycle: 1 -> {2, 3} -> 4 -> 5 -> 1, and 4 -> 6. No closure is exact here.
# =====================================================================================================================

statement ok
CREATE TABLE dp(id BIGINT PRIMARY KEY);

statement ok
CREATE TABLE dk(src BIGINT, dst BIGINT);

statement ok
INSERT INTO dp VALUES (1), (2), (3), (4), (5), (6);

statement ok
INSERT INTO dk VALUES (1, 2), (1, 3), (2, 4), (3, 4), (4, 5), (5, 1), (4, 6);

statement ok
CREATE PROPERTY GRAPH dia_g VERTEX TABLES (dp LABEL Person)
EDGE TABLES (dk SOURCE KEY (src) REFERENCES dp (id) DESTINATION KEY (dst) REFERENCES dp (id) LABEL Knows);

statement ok
FROM pgq_abi_build('dia_g', exclude_self_referential := false, closures := ['Knows']);

query TT
SELECT path_kind, preserves_multiplicity FROM graph.__pgq_path_catalog
WHERE graph_name = 'dia_g' AND path_kind IN ('transitive_closure', 'tc_witness', 'tc_chain') ORDER BY ALL;
----
tc_chain	false
tc_witness	false
transitive_closure	false

# Walks: two paths 1 -> 4. Traversed (tc would collapse them, tc_chain would keep one per source)
query I
SELECT count(*) FROM GRAPH_TABLE (dia_g MATCH (a:Person)-[:Knows]->{1,3}(b:Person) COLUMNS (a.id AS a, b.id AS b));
----
26

query I
SELECT count(*) FROM pgq_last_rewrite_diagnostics() WHERE status = 'selected' AND rewrite_type = 'transitive_closure';
----
0

query TT
SELECT status, rewrite_fired FROM pgq_verify_abi_rewrite('FROM GRAPH_TABLE (dia_g MATCH p = (a:Person)-[:Knows]->{1,3}(b:Person)
    WHERE a.id = 1 COLUMNS (a.id AS a, b.id AS b, path_length(p)))');
----
match	true

# ANY SHORTEST from depth 1 is answerable from the closures on any graph: a shortest walk is a simple path.
# The closure must still leave out the pair that only closes the cycle (1 -> ... -> 1).
query II rowsort
FROM GRAPH_TABLE (dia_g MATCH ANY SHORTEST (a:Person)-[:Knows]->{1,4}(b:Person) WHERE a.id = 1 COLUMNS (b.id AS b, a.id AS a));
----
2	1
3	1
4	1
5	1
6	1

query T
SELECT rewrite_type FROM pgq_last_rewrite_diagnostics() WHERE status = 'selected';
----
transitive_closure

query TT
SELECT status, rewrite_fired FROM pgq_verify_abi_rewrite('FROM GRAPH_TABLE (dia_g MATCH ANY SHORTEST (a:Person)-[:Knows]->{1,4}(b:Person)
    COLUMNS (a.id AS a, b.id AS b))');
----
match	true

query TT
SELECT status, rewrite_fired FROM pgq_verify_abi_rewrite('FROM GRAPH_TABLE (dia_g MATCH p = ANY SHORTEST (a:Person)-[:Knows]->{1,3}(b:Person)
    WHERE b.id = 4 COLUMNS (a.id AS a, path_length(p)))');
----
match	true

# From depth 2 the shortest path within the bounds may be one the closure does not hold, and ALL SHORTEST
# counts tied paths, which a closure does not hold either. Neither takes the closure; the expansion over the
# 1-hop artifacts answers them.
statement ok
FROM GRAPH_TABLE (dia_g MATCH ANY SHORTEST (a:Person)-[:Knows]->{2,3}(b:Person) COLUMNS (a.id AS a, b.id AS b));

query T
SELECT rewrite_type FROM pgq_last_rewrite_diagnostics() WHERE status = 'selected';
----
abi_context_expansion

query TT
SELECT status, rewrite_fired FROM pgq_verify_abi_rewrite('FROM GRAPH_TABLE (dia_g MATCH ANY SHORTEST (a:Person)-[:Knows]->{2,3}(b:Person)
    COLUMNS (a.id AS a, b.id AS b))');
----
match	true

statement ok
FROM GRAPH_TABLE (dia_g MATCH ALL SHORTEST (a:Person)-[:Knows]->{1,3}(b:Person) COLUMNS (a.id AS a, b.id AS b));

query T
SELECT rewrite_type FROM pgq_last_rewrite_diagnostics() WHERE status = 'selected';
----
abi_context_expansion

query TT
SELECT status, rewrite_fired FROM pgq_verify_abi_rewrite('FROM GRAPH_TABLE (dia_g MATCH ALL SHORTEST (a:Person)-[:Knows]->{1,3}(b:Person)
    COLUMNS (a.id AS a, b.id AS b))');
----
match	true

# Walk-mode ONE ROW PER: traversed
query TT
SELECT status, rewrite_fired FROM pgq_verify_abi_rewrite('FROM GRAPH_TABLE (dia_g MATCH (a:Person)-[:Knows]->{1,3}(b:Person)
    ONE ROW PER STEP (v1, e, v2) WHERE a.id = 1 COLUMNS (b.id AS b, v1.id AS x, v2.id AS y))');
----
unverified	false

# ANY SHORTEST + ONE ROW PER is answered from the witness: one path per pair, so a path's steps are its own.
# (The traversal currently disagrees here: it repeats rows and mixes the steps of both tied 1 -> 4 paths. The
# answer below is the correct one; see the traversal note in docs.)
query I
SELECT count(*) FROM GRAPH_TABLE (dia_g MATCH ANY SHORTEST (a:Person)-[:Knows]->{1,3}(b:Person)
    ONE ROW PER VERTEX (v) WHERE a.id = 1 COLUMNS (b.id AS b, v.id AS v));
----
15

query I
SELECT count(*) FROM (
    SELECT b FROM GRAPH_TABLE (dia_g MATCH ANY SHORTEST (a:Person)-[:Knows]->{1,3}(b:Person)
        ONE ROW PER VERTEX (v) WHERE a.id = 1 COLUMNS (b.id AS b, v.id AS v))
    GROUP BY b HAVING count(*) <> count(DISTINCT v));
----
0

# =====================================================================================================================
# A tree: every closure is exact, and every route answers from it
# =====================================================================================================================

statement ok
CREATE TABLE tp(id BIGINT PRIMARY KEY);

statement ok
CREATE TABLE tk(child BIGINT, parent BIGINT);

statement ok
INSERT INTO tp VALUES (1), (2), (3), (4), (5), (6), (7);

statement ok
INSERT INTO tk VALUES (2, 1), (3, 1), (4, 2), (5, 2), (6, 3), (7, 6);

statement ok
CREATE PROPERTY GRAPH tree_g VERTEX TABLES (tp LABEL Node)
EDGE TABLES (tk SOURCE KEY (child) REFERENCES tp (id) DESTINATION KEY (parent) REFERENCES tp (id) LABEL HasParent);

statement ok
FROM pgq_abi_build('tree_g', exclude_self_referential := false, closures := ['HasParent']);

query TT
SELECT path_kind, preserves_multiplicity FROM graph.__pgq_path_catalog
WHERE graph_name = 'tree_g' AND path_kind IN ('transitive_closure', 'tc_witness', 'tc_chain') ORDER BY ALL;
----
tc_chain	true
tc_witness	true
transitive_closure	true

statement ok
FROM GRAPH_TABLE (tree_g MATCH (a:Node)-[:HasParent]->{1,3}(b:Node) COLUMNS (a.id AS a, b.id AS b));

query T
SELECT rewrite_type FROM pgq_last_rewrite_diagnostics() WHERE status = 'selected';
----
transitive_closure

query TT
SELECT status, rewrite_fired FROM pgq_verify_abi_rewrite('FROM GRAPH_TABLE (tree_g MATCH (a:Node)-[:HasParent]->{1,3}(b:Node)
    COLUMNS (a.id AS a, b.id AS b))');
----
match	true

query TT
SELECT status, rewrite_fired FROM pgq_verify_abi_rewrite('FROM GRAPH_TABLE (tree_g MATCH ALL SHORTEST (a:Node)-[:HasParent]->{2,3}(b:Node)
    COLUMNS (a.id AS a, b.id AS b))');
----
match	true

query TT
SELECT status, rewrite_fired FROM pgq_verify_abi_rewrite('FROM GRAPH_TABLE (tree_g MATCH p = (a:Node)-[:HasParent]->{1,3}(b:Node)
    COLUMNS (a.id AS a, b.id AS b, path_length(p), vertex_labels(p)))');
----
match	true

query TT
SELECT status, rewrite_fired FROM pgq_verify_abi_rewrite('FROM GRAPH_TABLE (tree_g MATCH p = (a:Node)-[:HasParent]->{2,3}(b:Node)
    WHERE b.id = 1 COLUMNS (a.id AS a, path_length(p)))');
----
match	true

query TT
SELECT status, rewrite_fired FROM pgq_verify_abi_rewrite('FROM GRAPH_TABLE (tree_g MATCH (a:Node)-[:HasParent]->{1,3}(b:Node)
    ONE ROW PER STEP (v1, e, v2) COLUMNS (a.id AS a, b.id AS b, v1.id AS x, v2.id AS y))');
----
match	true

query TT
SELECT status, rewrite_fired FROM pgq_verify_abi_rewrite('FROM GRAPH_TABLE (tree_g MATCH (a:Node)-[:HasParent]->{1,3}(b:Node)
    ONE ROW PER VERTEX (v) WHERE b.id = 1 COLUMNS (a.id AS a, v.id AS v))');
----
match	true

# The paths themselves agree, not only their number (row id = id - 1 in tp)
query I
SELECT count(*) FROM (
    SELECT a, b, list_transform(vs, lambda x: x - 1) AS vs
    FROM GRAPH_TABLE (tree_g MATCH p = (a:Node)-[:HasParent]->{1,3}(b:Node) COLUMNS (a.id AS a, b.id AS b, vertices(p) AS vs))
    EXCEPT ALL
    SELECT a, b, vs FROM (VALUES (2, 1, [1, 0]), (3, 1, [2, 0]), (4, 2, [3, 1]), (4, 1, [3, 1, 0]), (5, 2, [4, 1]),
        (5, 1, [4, 1, 0]), (6, 3, [5, 2]), (6, 1, [5, 2, 0]), (7, 6, [6, 5]), (7, 3, [6, 5, 2]), (7, 1, [6, 5, 2, 0]))
        t(a, b, vs));
----
0

# =====================================================================================================================
# Expansion over 1-hop and k-hop artifacts (no closures)
# =====================================================================================================================

# ANY SHORTEST / ALL SHORTEST keep one / all shortest paths per pair (both used to return every walk)
query TT
SELECT status, rewrite_fired FROM pgq_verify_abi_rewrite('FROM GRAPH_TABLE (dia_g MATCH p = ANY SHORTEST (a:Person)-[:Knows]->{1,3}(b)
    COLUMNS (a.id AS a, path_length(p) AS len, label(b) AS l))');
----
match	true

query I
SELECT count(*) FROM GRAPH_TABLE (dia_g MATCH p = ALL SHORTEST (a:Person)-[:Knows]->{1,3}(b) WHERE a.id = 1
    COLUMNS (a.id AS a, path_length(p) AS len));
----
8

# A 2-cycle: the 2-hop artifact holds 1 -> 2 -> 1, which is not a path
statement ok
CREATE TABLE yp(id BIGINT PRIMARY KEY);

statement ok
CREATE TABLE yk(src BIGINT, dst BIGINT);

statement ok
INSERT INTO yp VALUES (1), (2), (3);

statement ok
INSERT INTO yk VALUES (1, 2), (2, 1), (2, 3);

statement ok
CREATE PROPERTY GRAPH cyc_g VERTEX TABLES (yp LABEL Person)
EDGE TABLES (yk SOURCE KEY (src) REFERENCES yp (id) DESTINATION KEY (dst) REFERENCES yp (id) LABEL Knows);

statement ok
FROM pgq_abi_build('cyc_g', exclude_self_referential := false, max_hops := 2);

query III rowsort
FROM GRAPH_TABLE (cyc_g MATCH p = (a:Person)-[:Knows]->{2,2}(b) COLUMNS (a.id AS a, path_length(p), vertex_labels(p)));
----
1	2	[Person, Person, Person]

query TT
SELECT status, rewrite_fired FROM pgq_verify_abi_rewrite('FROM GRAPH_TABLE (cyc_g MATCH p = (a:Person)-[:Knows]->{1,2}(b)
    COLUMNS (a.id AS a, path_length(p) AS len))');
----
match	true
