# name: test/sql/path_finding/verify_abi_rewrite.test
# description: pgq_verify_abi_rewrite runs a query with and without the ABI rewrite and reports whether they agree
# group: [path_finding]

require duckpgq


statement ok
SET active_grammar_extensions = ['duckpgq'];

statement ok
CREATE TABLE person(id INTEGER, name VARCHAR);

statement ok
INSERT INTO person VALUES (1,'Alice'),(2,'Bob'),(3,'Carol');

statement ok
CREATE TABLE knows(src INTEGER, dst INTEGER);

statement ok
INSERT INTO knows VALUES (1,2),(2,3);

statement ok
CREATE SCHEMA graph;

# GOOD: ABI edge table faithfully mirrors the bridge (1->2, 2->3).
statement ok
CREATE TABLE graph.__pg_good__custom_edge AS
SELECT src AS v0, hash('e' || src || dst) AS e1, dst AS v1 FROM knows;

# BAD: ABI edge table diverges from the bridge (claims 1->3, which is not a real edge).
statement ok
CREATE TABLE graph.__pg_bad__custom_edge AS
SELECT 1 AS v0, hash('synthetic') AS e1, 3 AS v1;

statement ok
CREATE TABLE graph.__pgq_path_catalog AS
SELECT * FROM (VALUES
  ('good_graph','__pg_good__custom_edge','edge',1,'Person','Person','Person,Person','Knows',true,true,2,now(),true,1,1,'knows'),
  ('bad_graph', '__pg_bad__custom_edge', 'edge',1,'Person','Person','Person,Person','Knows',true,true,1,now(),true,1,1,'knows')
) t(graph_name,path_table_name,path_kind,hop_count,src_label,dst_label,vertex_label_sequence,edge_label_sequence,
    supports_one_row_per_step,is_deduplicated,estimated_rows,last_refreshed_at,is_sorted_by_v0,min_depth,max_depth,bridge_table_names);

# Hand-made catalog standing in for one pgq_abi_build wrote: its artifacts are planted (they need not agree
# with the bridges -- that is how these tests see which table the rewrite reads), so the binder must take their
# preserves_multiplicity as stored rather than measure it, which it does only for pgq_abi_build's rows.
statement ok
ALTER TABLE graph.__pgq_path_catalog ADD COLUMN preserves_multiplicity BOOLEAN DEFAULT true;

statement ok
ALTER TABLE graph.__pgq_path_catalog ADD COLUMN built_by VARCHAR DEFAULT 'pgq_abi_build';

statement ok
CREATE PROPERTY GRAPH good_graph
VERTEX TABLES (person PROPERTIES (id, name) LABEL Person)
EDGE TABLES (knows SOURCE KEY (src) REFERENCES person(id) DESTINATION KEY (dst) REFERENCES person(id) LABEL Knows);

statement ok
CREATE PROPERTY GRAPH bad_graph
VERTEX TABLES (person PROPERTIES (id, name) LABEL Person)
EDGE TABLES (knows SOURCE KEY (src) REFERENCES person(id) DESTINATION KEY (dst) REFERENCES person(id) LABEL Knows);

# Sanity: the ABI rewrite really is used for good_graph (returns the bridge edges).
query II rowsort
FROM GRAPH_TABLE (good_graph MATCH (a:Person)-[:Knows]->(b:Person) COLUMNS (a.id AS aid, b.id AS bid));
----
1	2
2	3

# The verify function confirms the good ABI table equals the fallback: match, no diffs.
# rewrite_fired must be true for 'match' to mean anything -- see the block at the end.
query TIIIIT
SELECT status, abi_rows, fallback_rows, only_in_abi, only_in_fallback, rewrite_fired
FROM pgq_verify_abi_rewrite('FROM GRAPH_TABLE (good_graph MATCH (a:Person)-[:Knows]->(b:Person) COLUMNS (a.id AS aid, b.id AS bid))');
----
match	2	2	0	0	true

# The verify function CATCHES the divergent bad ABI table: MISMATCH.
# ABI says 1->3 (1 row); fallback bridge says 1->2, 2->3 (2 rows).
query TIIIIT
SELECT status, abi_rows, fallback_rows, only_in_abi, only_in_fallback, rewrite_fired
FROM pgq_verify_abi_rewrite('FROM GRAPH_TABLE (bad_graph MATCH (a:Person)-[:Knows]->(b:Person) COLUMNS (a.id AS aid, b.id AS bid))');
----
MISMATCH	1	2	1	2	true

# A query with no ABI coverage runs the SAME fallback plan both ways, so the two
# results agree no matter what. That used to be reported as 'match' -- a guaranteed
# pass, from the one function whose entire job is to not hand out guaranteed passes.
# It is now 'unverified' with rewrite_fired=false. (A lower bound of 0 is a shape no artifact
# answers: none holds the empty path.)
query TIIIIT
SELECT status, abi_rows, fallback_rows, only_in_abi, only_in_fallback, rewrite_fired
FROM pgq_verify_abi_rewrite('FROM GRAPH_TABLE (good_graph MATCH (a:Person)-[:Knows]->{0,2}(b:Person) COLUMNS (a.id AS aid, b.id AS bid))');
----
unverified	6	6	0	0	false

query T
SELECT detail LIKE 'no ABI rewrite fired%'
FROM pgq_verify_abi_rewrite('FROM GRAPH_TABLE (good_graph MATCH (a:Person)-[:Knows]->{0,2}(b:Person) COLUMNS (a.id AS aid, b.id AS bid))');
----
true

# The same pattern from depth 1 is answered by the expansion over the edge artifact, and agrees
query TIIIIT
SELECT status, abi_rows, fallback_rows, only_in_abi, only_in_fallback, rewrite_fired
FROM pgq_verify_abi_rewrite('FROM GRAPH_TABLE (good_graph MATCH (a:Person)-[:Knows]->{1,2}(b:Person) COLUMNS (a.id AS aid, b.id AS bid))');
----
match	3	3	0	0	true

# ── The two failures that are not a verdict, and the one that is ───────────────
# These used to be a single status, 'error', which meant a sweep could not tell
# "the rewrite emits something broken" from "there is no reference answer to
# compare against". The second is a hole in the ORACLE, not a fault in the
# rewrite, and conflating them is how an unverifiable shape gets read as noise
# and quietly stays unverified. On the real lake every negated-edge-label shape
# lands in that second bucket.

statement ok
CREATE TABLE lonely(src INTEGER, dst INTEGER);

statement ok
INSERT INTO lonely VALUES (1,2),(2,3);

# Faithful artifact for the edge below.
statement ok
CREATE TABLE graph.__pg_lonely_graph__custom_edge AS
SELECT src AS v0, hash('l' || src || dst) AS e1, dst AS v1 FROM lonely;

# ... and one missing the v1 column the rewrite will project.
statement ok
CREATE TABLE graph.__pg_broken_graph__custom_edge AS
SELECT src AS v0, hash('b') AS e1 FROM lonely;

statement ok
INSERT INTO graph.__pgq_path_catalog BY NAME
SELECT * FROM (VALUES
  ('lonely_graph','__pg_lonely_graph__custom_edge','edge',1,'Person','Person','Person,Person','Lonely',true,true,2,now(),true,1,1,'lonely'),
  ('broken_graph','__pg_broken_graph__custom_edge','edge',1,'Person','Person','Person,Person','Lonely',true,true,2,now(),true,1,1,'lonely')
) t(graph_name,path_table_name,path_kind,hop_count,src_label,dst_label,vertex_label_sequence,edge_label_sequence,
    supports_one_row_per_step,is_deduplicated,estimated_rows,last_refreshed_at,is_sorted_by_v0,min_depth,max_depth,bridge_table_names);

statement ok
CREATE PROPERTY GRAPH lonely_graph
VERTEX TABLES (person PROPERTIES (id, name) LABEL Person)
EDGE TABLES (lonely SOURCE KEY (src) REFERENCES person(id)
                    DESTINATION KEY (dst) REFERENCES person(id) LABEL Lonely);

statement ok
CREATE PROPERTY GRAPH broken_graph
VERTEX TABLES (person PROPERTIES (id, name) LABEL Person)
EDGE TABLES (lonely SOURCE KEY (src) REFERENCES person(id)
                    DESTINATION KEY (dst) REFERENCES person(id) LABEL Lonely);

# The rewrite reads the artifact and never touches the edge table; the fallback
# scans the edge table and cannot run at all. Standing in here for "only the
# rewrite can bind this shape", which is what a negated edge label does for real.
statement ok
DROP TABLE lonely;

# Both no-oracle and no-rewrite report 'unverified'; rewrite_fired is what tells them
# apart. Here the rewrite DID fire and only the reference answer is missing, so
# fired=true -- the opposite of the no-coverage case above.
query TIIT
SELECT status, abi_rows, fallback_rows, rewrite_fired
FROM pgq_verify_abi_rewrite('FROM GRAPH_TABLE (lonely_graph MATCH (a:Person)-[:Lonely]->(b:Person) COLUMNS (a.id AS aid, b.id AS bid))');
----
unverified	2	NULL	true

# abi_rows is carried deliberately: the reader can see the rewrite DID run and
# what it returned, so 'unverified' reads as "unchecked", not as "broken".
query T
SELECT detail LIKE 'no reference answer%'
FROM pgq_verify_abi_rewrite('FROM GRAPH_TABLE (lonely_graph MATCH (a:Person)-[:Lonely]->(b:Person) COLUMNS (a.id AS aid, b.id AS bid))');
----
true

# The other direction: the artifact has no v1, so the REWRITE emits a query that
# will not bind. That IS a verdict on the thing under test, and keeps its own status.
query TT
SELECT status, rewrite_fired
FROM pgq_verify_abi_rewrite('FROM GRAPH_TABLE (broken_graph MATCH (a:Person)-[:Lonely]->(b:Person) COLUMNS (a.id AS aid, b.id AS bid))');
----
abi_error	true

# ── REGRESSION: a graph with NO catalogue row at all ──────────────────────────
# This is the shape that was reported from the field: a property graph over data
# whose ABI artifacts had never been generated. The function returned
# status='match', abi_rows=fallback_rows, only_in_*=0 -- indistinguishable from a
# genuine verification -- while pgq_require_abi_paths=true on the same graph said
# "no matching ABI path table rewrite was available". Anyone using this function to
# sign off such a graph got a meaningless green.

statement ok
CREATE TABLE uncovered(src INTEGER, dst INTEGER);

statement ok
INSERT INTO uncovered VALUES (1,2),(2,3);

statement ok
CREATE PROPERTY GRAPH uncovered_graph
VERTEX TABLES (person PROPERTIES (id, name) LABEL Person)
EDGE TABLES (uncovered SOURCE KEY (src) REFERENCES person(id)
                       DESTINATION KEY (dst) REFERENCES person(id) LABEL Uncovered);

query TIIIIT
SELECT status, abi_rows, fallback_rows, only_in_abi, only_in_fallback, rewrite_fired
FROM pgq_verify_abi_rewrite('FROM GRAPH_TABLE (uncovered_graph MATCH (a:Person)-[:Uncovered]->(b:Person) COLUMNS (a.id AS aid, b.id AS bid))');
----
unverified	2	2	0	0	false

# DISCRIMINATION: the guard must not simply report 'unverified' for everything.
# good_graph, verified in the same session, still reaches 'match' with fired=true --
# so a green is still reachable and this test would catch a guard stuck on.
query TT
SELECT status, rewrite_fired
FROM pgq_verify_abi_rewrite('FROM GRAPH_TABLE (good_graph MATCH (a:Person)-[:Knows]->(b:Person) COLUMNS (a.id AS aid, b.id AS bid))');
----
match	true

statement ok
DROP PROPERTY GRAPH uncovered_graph;

statement ok
DROP PROPERTY GRAPH lonely_graph;

statement ok
DROP PROPERTY GRAPH broken_graph;

statement ok
DROP PROPERTY GRAPH good_graph;

statement ok
DROP PROPERTY GRAPH bad_graph;
