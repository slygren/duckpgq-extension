# The fixed-length bidirectional pattern and the {1,1} quantifier are the same matches
statement ok
CREATE OR REPLACE TABLE fixed AS SELECT * FROM GRAPH_TABLE (g MATCH (a:P)<-[e:K]->(b:P) COLUMNS (a.id AS a, b.id AS b, e.rowid AS e));

statement ok
CREATE OR REPLACE TABLE quantified AS SELECT a, b, es[1] FROM GRAPH_TABLE (g MATCH p = (a:P)<-[e:K]->{1,1}(b:P) COLUMNS (a.id AS a, b.id AS b, edges(p) AS es));

query III
SELECT (SELECT count(*) FROM fixed), (SELECT count(*) FROM (FROM fixed EXCEPT ALL FROM quantified)), (SELECT count(*) FROM (FROM quantified EXCEPT ALL FROM fixed));
----
6	0	0

# Hand-checked: 2 <- 1 <- 4 <- 3 <- {1, 2} against the edges from 4; ONE ROW PER STEP in traversal order
query IIII
FROM GRAPH_TABLE (g MATCH ANY SHORTEST (a:P)<-[e:K]-+(b:P) ONE ROW PER STEP (v1, x, v2) WHERE a.id = 4 AND b.id = 3
    COLUMNS (b.id AS b, v1.id AS v1, x.src AS s, v2.id AS v2)) ORDER BY v1;
----
3	4	3	3

# Unbounded <- and <-> with no search prefix (a path mode only), or with a lower bound above 1, are refused rather
# than answered from the CSR, which finds one shortest path per pair
statement error
FROM GRAPH_TABLE (g MATCH ACYCLIC (a:P)<-[e:K]-+(b:P) COLUMNS (a.id AS a, b.id AS b));
----
with a path mode and no search prefix

statement error
FROM GRAPH_TABLE (g MATCH ANY SHORTEST (a:P)<-[e:K]->{2,}(b:P) COLUMNS (a.id AS a, b.id AS b));
----
lower bound above 1

# ── With ABI artifacts: no artifact route may answer these differently ──────────────────────────────────
statement ok
SET pgq_disable_abi_rewrite = false;

statement ok
SELECT count(*) FROM pgq_abi_build('g', exclude_self_referential := false, closures := ['K']);

query I
SELECT status IN ('match', 'unverified') FROM pgq_verify_abi_rewrite('FROM GRAPH_TABLE (g MATCH ANY SHORTEST (a:P)<-[e:K]-+(b:P)  WHERE a.id = 1 COLUMNS (a.id AS a, b.id AS b))');
----
true

