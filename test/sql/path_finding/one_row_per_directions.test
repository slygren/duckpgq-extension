# name: test/sql/path_finding/one_row_per_directions.test
# description: Named paths, ONE ROW PER and unnamed patterns for unbounded left-directed and for bidirectional quantifiers
# group: [path_finding]

# A bidirectional step (a)<-[e]->(b) is what the fixed-length pattern matches: e runs from b back to a, with an edge
# from a to b beside it, and each such pair is one step (e is the edge it reports). Reference semantics as in
# traversal_selectors.test: simple paths (no vertex twice, never back to the start), one per edge taken; ANY
# SHORTEST one shortest per endpoint pair, ALL SHORTEST every shortest. The named paths are compared both ways
# (EXCEPT ALL) with a brute-force enumeration (ref_paths); ONE ROW PER and the unnamed pattern with the named path
# of the same query, unnested. Each side is materialised in its own statement.

require duckpgq

statement ok
SET active_grammar_extensions = ['duckpgq'];

# 1 -> 2 (twice), 2 -> 3, 1 -> 3, 3 -> 4, 2 -> 4, 4 -> 1, 2 -> 1, 3 -> 5, 3 -> 2; reciprocal pairs: 1 <-> 2, 2 <-> 3
statement ok
CREATE TABLE P(id BIGINT PRIMARY KEY);

statement ok
CREATE TABLE K(src BIGINT, dst BIGINT);

statement ok
INSERT INTO P VALUES (1), (2), (3), (4), (5), (6);

statement ok
INSERT INTO K VALUES (1, 2), (1, 2), (2, 3), (1, 3), (3, 4), (2, 4), (4, 1), (2, 1), (3, 5), (3, 2);

statement ok
CREATE PROPERTY GRAPH g VERTEX TABLES (P LABEL P)
EDGE TABLES (K SOURCE KEY (src) REFERENCES P (id) DESTINATION KEY (dst) REFERENCES P (id) LABEL K);

# Simple paths of every direction up to length 5 (row ids are id - 1 in P, edge row ids are K's)
statement ok
CREATE TABLE ref_paths AS
WITH RECURSIVE steps(dir, s, t, e) AS (
    SELECT '->', src, dst, rowid FROM K
    UNION ALL SELECT '<-', dst, src, rowid FROM K
    UNION ALL SELECT '-', src, dst, rowid FROM K
    UNION ALL SELECT '-', dst, src, rowid FROM K WHERE src <> dst
    UNION ALL SELECT '<->', k.dst, k.src, k.rowid FROM K k JOIN K r ON r.src = k.dst AND r.dst = k.src),
w(dir, src, cur, depth, vs, es) AS (
    SELECT d, id, id, 0, [id], []::BIGINT[] FROM P, (VALUES ('->'), ('<-'), ('-'), ('<->')) t(d)
    UNION ALL
    SELECT w.dir, w.src, steps.t, w.depth + 1, list_append(w.vs, steps.t), list_append(w.es, steps.e)
    FROM w JOIN steps ON steps.dir = w.dir AND steps.s = w.cur
    WHERE w.depth < 5 AND NOT list_contains(w.vs, steps.t))
SELECT * FROM w;

statement ok
SET pgq_disable_abi_rewrite = true;

# ANY SHORTEST (a:P)<-[e:K]-+(b:P) WHERE a.id = 1
statement ok
CREATE OR REPLACE TABLE named AS SELECT a, b, list_transform(vs0, lambda x: x + 1) AS vs, es FROM GRAPH_TABLE (g
    MATCH p = ANY SHORTEST (a:P)<-[e:K]-+(b:P) WHERE a.id = 1 COLUMNS (a.id AS a, b.id AS b, vertices(p) AS vs0, edges(p) AS es));

statement ok
CREATE OR REPLACE TABLE ref AS SELECT src AS a, cur AS b, vs, es FROM ref_paths WHERE dir = '<-' AND depth BETWEEN 1 AND 5 AND src = 1;

# one path per pair, a shortest one of the reference's
query III
SELECT (SELECT count(*) FROM named) = (SELECT count(DISTINCT (a, b)) FROM ref),
    (SELECT count(*) FROM (SELECT a, b FROM named GROUP BY ALL HAVING count(*) > 1)),
    (SELECT count(*) FROM named n WHERE NOT EXISTS (SELECT 1 FROM ref r WHERE r.a = n.a AND r.b = n.b AND r.vs = n.vs
        AND r.es = n.es AND len(r.es) = (SELECT min(len(es)) FROM ref r2 WHERE r2.a = n.a AND r2.b = n.b)));
----
true	0	0

statement ok
CREATE OR REPLACE TABLE orp AS SELECT * FROM GRAPH_TABLE (g MATCH ANY SHORTEST (a:P)<-[e:K]-+(b:P) ONE ROW PER VERTEX (v) WHERE a.id = 1 COLUMNS (a.id AS a, b.id AS b, v.id AS v));

query I
SELECT count(*) FROM ((SELECT a, b, count(*) FROM orp GROUP BY ALL) EXCEPT ALL (SELECT a, b, len(vs) FROM named WHERE true));
----
0

statement ok
CREATE OR REPLACE TABLE orp AS SELECT * FROM GRAPH_TABLE (g MATCH ANY SHORTEST (a:P)<-[e:K]-+(b:P) ONE ROW PER EDGE (x) WHERE a.id = 1 COLUMNS (a.id AS a, b.id AS b, x.rowid AS x));

query I
SELECT count(*) FROM ((SELECT a, b, count(*) FROM orp GROUP BY ALL) EXCEPT ALL (SELECT a, b, len(es) FROM named WHERE len(es) > 0));
----
0

statement ok
CREATE OR REPLACE TABLE orp AS SELECT * FROM GRAPH_TABLE (g MATCH ANY SHORTEST (a:P)<-[e:K]-+(b:P) ONE ROW PER STEP (v1, x, v2) WHERE a.id = 1 COLUMNS (a.id AS a, b.id AS b, v1.id AS v1, x.rowid AS x, v2.id AS v2));

query I
SELECT count(*) FROM ((SELECT a, b, count(*) FROM orp GROUP BY ALL) EXCEPT ALL (SELECT a, b, len(es) FROM named WHERE len(es) > 0));
----
0

statement ok
CREATE OR REPLACE TABLE unnamed AS SELECT * FROM GRAPH_TABLE (g MATCH ANY SHORTEST (a:P)<-[e:K]-+(b:P) WHERE a.id = 1 COLUMNS (a.id AS a, b.id AS b));

query II
SELECT (SELECT count(*) FROM (FROM unnamed EXCEPT ALL SELECT a, b FROM named)), (SELECT count(*) FROM (SELECT a, b FROM named EXCEPT ALL FROM unnamed));
----
0	0

