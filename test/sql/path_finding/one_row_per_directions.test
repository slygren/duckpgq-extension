# one path per pair, a shortest one of the reference's
query III
SELECT (SELECT count(*) FROM named) = (SELECT count(DISTINCT (a, b)) FROM ref),
    (SELECT count(*) FROM (SELECT a, b FROM named GROUP BY ALL HAVING count(*) > 1)),
    (SELECT count(*) FROM named n WHERE NOT EXISTS (SELECT 1 FROM ref r WHERE r.a = n.a AND r.b = n.b AND r.vs = n.vs
        AND r.es = n.es AND len(r.es) = (SELECT min(len(es)) FROM ref r2 WHERE r2.a = n.a AND r2.b = n.b)));
----
