# name: test/sql/path_finding/csr_deleted_vertices.test
# description: A CSR over a vertex table with deleted rows. Rowids keep their gaps after a DELETE, and the CSR and
#              the path searches index their arrays by rowid, so they are sized by max(rowid) + 1, not the row count
#              (which wrote past the arrays). On cdc0934d the ANY SHORTEST query below failed with "INTERNAL Error:
#              Attempted to access index 8 within vector of size 8" (iterativelength), or crashed the process
#              (exit 139 in the CLI): the write past create_csr_vertex's offset array is unchecked.
# group: [path_finding]

require duckpgq

statement ok
SET active_grammar_extensions = ['duckpgq'];

statement ok
CREATE TABLE v AS SELECT range AS id FROM range(10);

statement ok
CREATE TABLE e AS SELECT range AS src, (range + 1) % 10 AS dst FROM range(10);

statement ok
DELETE FROM v WHERE id IN (2, 3);

statement ok
DELETE FROM e WHERE src IN (1, 2, 3) OR dst IN (2, 3);

statement ok
CREATE PROPERTY GRAPH g VERTEX TABLES (v) EDGE TABLES (e SOURCE KEY (src) REFERENCES v (id) DESTINATION KEY (dst) REFERENCES v (id));

# The chain 4 -> 5 -> ... -> 9 -> 0 -> 1 survives.
query II
FROM GRAPH_TABLE (g MATCH p = ANY SHORTEST (a:v WHERE a.id = 4)-[x:e]->+(b:v) COLUMNS (b.id, path_length(p) AS len)) ORDER BY 1;
----
0	6
1	7
5	1
6	2
7	3
8	4
9	5

query I
SELECT count(DISTINCT componentId) FROM weakly_connected_component('g', 'v', 'e');
----
1

# The deleted rows' slots are vertices without edges that no row asks about.
query II
SELECT id, b FROM GRAPH_TABLE (g MATCH (a:v WHERE a.id = 9)-[x:e]->{1,3}(b:v) COLUMNS (a.id, b.id AS b)) ORDER BY b;
----
9	0
9	1

# The step CSR (<-, undirected ALL SHORTEST) and SHORTEST k's search are sized the same way.
query II
FROM GRAPH_TABLE (g MATCH p = ANY SHORTEST (a:v WHERE a.id = 1)<-[x:e]-+(b:v) COLUMNS (b.id, path_length(p) AS len)) ORDER BY 1;
----
0	1
4	7
5	6
6	5
7	4
8	3
9	2

query II
FROM GRAPH_TABLE (g MATCH p = ALL SHORTEST (a:v WHERE a.id = 4)-[x:e]-+(b:v) COLUMNS (b.id, path_length(p) AS len)) ORDER BY 1;
----
0	6
1	7
4	2
5	1
6	2
7	3
8	4
9	5

query II
FROM GRAPH_TABLE (g MATCH p = SHORTEST 2 (a:v WHERE a.id = 9)-[x:e]->+(b:v) COLUMNS (b.id, path_length(p) AS len)) ORDER BY 1;
----
0	1
1	2
