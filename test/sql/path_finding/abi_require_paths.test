# name: test/sql/path_finding/abi_require_paths.test
# description: pgq_require_abi_paths fails fast when a MATCH would use fallback traversal
# group: [path_finding]

require duckpgq


statement ok
SET active_grammar_extensions = ['duckpgq'];

statement ok
CREATE TABLE tag(id INTEGER, name VARCHAR);

statement ok
INSERT INTO tag VALUES (1, 'Pump A');

statement ok
CREATE TABLE workorder(id INTEGER, title VARCHAR);

statement ok
INSERT INTO workorder VALUES (10, 'WO-10');

statement ok
CREATE TABLE notification(id INTEGER, title VARCHAR);

statement ok
INSERT INTO notification VALUES (20, 'N-20');

statement ok
CREATE TABLE has_workorder(tag_id INTEGER, wo_id INTEGER);

statement ok
INSERT INTO has_workorder VALUES (1, 10);

statement ok
CREATE TABLE has_notification(tag_id INTEGER, notification_id INTEGER);

statement ok
INSERT INTO has_notification VALUES (1, 20);

statement ok
CREATE SCHEMA graph;

statement ok
CREATE TABLE graph.__pg_test_graph__Tag__HasWorkorder__Workorder AS
SELECT 1 AS v0, hash('wo') AS e1, 10 AS v1;

statement ok
CREATE TABLE graph.__pgq_path_catalog AS
SELECT
    'test_graph' AS graph_name,
    '__pg_test_graph__Tag__HasWorkorder__Workorder' AS path_table_name,
    'edge' AS path_kind,
    1 AS hop_count,
    'Tag' AS src_label,
    'Workorder' AS dst_label,
    'Tag,Workorder' AS vertex_label_sequence,
    'HasWorkorder' AS edge_label_sequence,
    true AS supports_one_row_per_step,
    true AS is_deduplicated,
    (SELECT count(*) FROM graph.__pg_test_graph__Tag__HasWorkorder__Workorder) AS estimated_rows,
    current_timestamp AS last_refreshed_at,
    true AS is_sorted_by_v0,
    1 AS min_depth,
    1 AS max_depth,
    'has_workorder' AS bridge_table_names;

# Hand-made catalog standing in for one pgq_abi_build wrote: its artifacts are planted (they need not agree
# with the bridges -- that is how these tests see which table the rewrite reads), so the binder must take their
# preserves_multiplicity as stored rather than measure it, which it does only for pgq_abi_build's rows.
statement ok
ALTER TABLE graph.__pgq_path_catalog ADD COLUMN preserves_multiplicity BOOLEAN DEFAULT true;

statement ok
ALTER TABLE graph.__pgq_path_catalog ADD COLUMN built_by VARCHAR DEFAULT 'pgq_abi_build';

statement ok
CREATE PROPERTY GRAPH test_graph
VERTEX TABLES (
    tag PROPERTIES (id, name) LABEL Tag,
    workorder PROPERTIES (id, title) LABEL Workorder,
    notification PROPERTIES (id, title) LABEL Notification
)
EDGE TABLES (
    has_workorder SOURCE KEY (tag_id) REFERENCES tag(id)
                  DESTINATION KEY (wo_id) REFERENCES workorder(id)
                  LABEL HasWorkorder,
    has_notification SOURCE KEY (tag_id) REFERENCES tag(id)
                     DESTINATION KEY (notification_id) REFERENCES notification(id)
                     LABEL HasNotification
);

statement ok
SET pgq_require_abi_paths = true;

query I
FROM GRAPH_TABLE (
    test_graph
    MATCH (t:Tag)
    COLUMNS (t.name AS tag_name)
);
----
Pump A

query II
FROM GRAPH_TABLE (
    test_graph
    MATCH (t:Tag)-[:HasWorkorder]->(w:Workorder)
    COLUMNS (t.name AS tag_name, w.title AS workorder_title)
);
----
Pump A	WO-10

statement error
FROM GRAPH_TABLE (
    test_graph
    MATCH (t:Tag)-[:HasNotification]->(n:Notification)
    COLUMNS (t.name AS tag_name, n.title AS notification_title)
);
----
DuckPGQ ABI path required by pgq_require_abi_paths

statement ok
SET pgq_require_abi_paths = false;

query II
FROM GRAPH_TABLE (
    test_graph
    MATCH (t:Tag)-[:HasNotification]->(n:Notification)
    COLUMNS (t.name AS tag_name, n.title AS notification_title)
);
----
Pump A	N-20
