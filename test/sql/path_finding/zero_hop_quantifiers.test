# name: test/sql/path_finding/zero_hop_quantifiers.test
# description: Quantifiers that admit zero hops ({0,1}, ?, {0,0}, {0,k}) return the zero-hop matches, in every
#              direction, with and without a path variable, traversed and with ABI artifacts. {0,1} and ? were
#              taken as one hop (zero-hop rows lost) and {0,0} as exactly one hop. Checked against brute-force walks.
# group: [path_finding]

require duckpgq

statement ok
SET active_grammar_extensions = ['duckpgq'];

statement ok
CREATE TABLE tag(id INTEGER PRIMARY KEY, name VARCHAR);

statement ok
INSERT INTO tag VALUES (1, 'a'), (2, 'b'), (3, 'c'), (4, 'd'), (5, 'e'), (6, 'f');

# A diamond with a cycle back to 1, and a vertex (6) without edges
statement ok
CREATE TABLE hp(src INTEGER, dst INTEGER);

statement ok
INSERT INTO hp VALUES (1, 2), (2, 3), (4, 2), (1, 5), (5, 3), (3, 1);

statement ok
CREATE PROPERTY GRAPH g VERTEX TABLES (tag LABEL Tag)
EDGE TABLES (hp SOURCE KEY (src) REFERENCES tag (id) DESTINATION KEY (dst) REFERENCES tag (id) LABEL HP);

# Brute force: every walk of 0 to 4 hops that visits no vertex twice, read forwards (r), backwards (l) or either way (a)
statement ok
CREATE TABLE walks AS
WITH RECURSIVE w(dir, src, cur, vs, depth) AS (
    SELECT d, id, id, [id], 0 FROM tag, (VALUES ('r'), ('l'), ('a')) t(d)
    UNION ALL
    SELECT w.dir, w.src, n.nxt, list_append(w.vs, n.nxt), w.depth + 1
    FROM w, LATERAL (SELECT dst AS nxt FROM hp WHERE w.dir IN ('r', 'a') AND hp.src = w.cur
                     UNION ALL
                     SELECT src FROM hp WHERE w.dir IN ('l', 'a') AND hp.dst = w.cur) n
    WHERE w.depth < 4 AND NOT list_contains(w.vs, n.nxt))
SELECT * FROM w;

query II rowsort
FROM GRAPH_TABLE (g MATCH (a:Tag)-[:HP]->{0,1}(b:Tag) WHERE a.id = 1 COLUMNS (a.id AS a, b.id AS b));
----
1	1
1	2
1	5

query II rowsort
FROM GRAPH_TABLE (g MATCH (a:Tag)-[:HP]->{0,0}(b:Tag) WHERE a.id = 1 COLUMNS (a.id AS a, b.id AS b));
----
1	1

query III rowsort
FROM GRAPH_TABLE (g MATCH p = (a:Tag)-[:HP]->?(b:Tag) WHERE a.id = 6 COLUMNS (a.id AS a, b.id AS b, path_length(p)));
----
6	6	0

# ---------------------------------------------------------------------------------------------------------------------
# Traversed
# ---------------------------------------------------------------------------------------------------------------------

statement ok
SET pgq_abi_mode = 'off';

statement ok
CREATE OR REPLACE TABLE actual AS FROM GRAPH_TABLE (g MATCH (a:Tag)-[:HP]->{0,1}(b:Tag) COLUMNS (a.id AS a, b.id AS b));

statement ok
CREATE OR REPLACE TABLE expected AS SELECT src AS a, cur AS b FROM walks WHERE dir = 'r' AND depth BETWEEN 0 AND 1;

query I
SELECT count(*) FROM ((FROM actual EXCEPT ALL FROM expected) UNION ALL (FROM expected EXCEPT ALL FROM actual));
----
0

