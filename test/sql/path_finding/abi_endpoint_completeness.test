# =====================================================================================================================
# B. A catalog without the proof whose artifacts hold edges to a vertex that is gone: measured, declined, traversed
# =====================================================================================================================
statement ok
CREATE TABLE Person2 AS FROM Person;

statement ok
CREATE TABLE likes2 AS FROM likes;

statement ok
CREATE TABLE knows2 AS FROM knows;

statement ok
CREATE PROPERTY GRAPH h VERTEX TABLES (Person2 LABEL Person, Tag LABEL Tag)
EDGE TABLES (likes2 SOURCE KEY (personId) REFERENCES Person2 (id) DESTINATION KEY (tagId) REFERENCES Tag (id) LABEL Likes,
             knows2 SOURCE KEY (src) REFERENCES Person2 (id) DESTINATION KEY (dst) REFERENCES Person2 (id) LABEL Knows);

statement ok
SELECT count(*) FROM pgq_abi_build('h', schema := 'abi_h', exclude_self_referential := false, closures := ['Knows'],
    branch_summaries := [{'anchor': 'Person', 'branches': ['Likes', 'Knows']}]);

# Person 3 is deleted after the build: every artifact over an edge of 3 now holds an edge the graph does not have.
# The rows look like another builder's: no built_by, no endpoints_complete.
statement ok
DELETE FROM Person2 WHERE id = 3;

statement ok
UPDATE abi_h.__pgq_path_catalog SET built_by = NULL, endpoints_complete = NULL WHERE graph_name = 'h';

# B: edge, keys only
statement ok
SET pgq_disable_abi_rewrite = true;

statement ok
CREATE OR REPLACE TABLE t_trav AS FROM GRAPH_TABLE (h MATCH (p:Person)-[:Likes]->(t:Tag) COLUMNS (p.id AS p, t.id AS t));

statement ok
SET pgq_disable_abi_rewrite = false;

statement ok
CREATE OR REPLACE TABLE t_abi AS FROM GRAPH_TABLE (h MATCH (p:Person)-[:Likes]->(t:Tag) COLUMNS (p.id AS p, t.id AS t));

query I
SELECT count(*) FROM ((FROM t_abi EXCEPT ALL FROM t_trav) UNION ALL (FROM t_trav EXCEPT ALL FROM t_abi));
----
0

