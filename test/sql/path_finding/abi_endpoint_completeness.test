# =====================================================================================================================
# C. A catalog without the proof over complete data: measured once, and the artifacts still answer
# =====================================================================================================================
statement ok
CREATE TABLE likes3 AS SELECT * FROM likes WHERE personId IN (SELECT id FROM Person) AND tagId IN (SELECT id FROM Tag);

statement ok
CREATE TABLE knows3 AS SELECT * FROM knows WHERE src IN (SELECT id FROM Person) AND dst IN (SELECT id FROM Person);

statement ok
CREATE PROPERTY GRAPH c VERTEX TABLES (Person LABEL Person, Tag LABEL Tag)
EDGE TABLES (likes3 SOURCE KEY (personId) REFERENCES Person (id) DESTINATION KEY (tagId) REFERENCES Tag (id) LABEL Likes,
             knows3 SOURCE KEY (src) REFERENCES Person (id) DESTINATION KEY (dst) REFERENCES Person (id) LABEL Knows);

statement ok
SELECT count(*) FROM pgq_abi_build('c', schema := 'abi_c', exclude_self_referential := false, closures := ['Knows']);

statement ok
UPDATE abi_c.__pgq_path_catalog SET built_by = NULL, endpoints_complete = false WHERE graph_name = 'c';

statement ok
FROM GRAPH_TABLE (c MATCH (p:Person)-[:Likes]->(t:Tag) COLUMNS (p.id AS p, t.id AS t));

query II
SELECT (SELECT count(*) FROM pgq_last_rewrite_diagnostics() WHERE status = 'selected') > 0,
       (SELECT count(*) FROM pgq_last_rewrite_diagnostics() WHERE rewrite_type = 'multiplicity_probe' AND reason LIKE 'far_ends|%' AND status = 'exact') > 0;
----
true	true

