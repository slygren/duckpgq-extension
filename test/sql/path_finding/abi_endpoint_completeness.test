# name: test/sql/path_finding/abi_endpoint_completeness.test
# description: An ABI artifact never answers with an edge whose endpoint is no vertex. pgq_abi_build copied such edges
#              into its artifacts (person(1,2), likes(1,2),(2,9): two rows from the edge artifact, one traversed); it
#              now reads the edge tables through their vertex keys and records endpoints_complete. For a catalog
#              without that proof (another builder, an older one) the binder measures the artifact's ends (or its edge
#              tables) once, and traverses where they are incomplete. Every shape is compared with the traversal.
# group: [path_finding]

require duckpgq

load __TEST_DIR__/abi_endpoint_completeness.db

statement ok
SET active_grammar_extensions = ['duckpgq'];

statement ok
CREATE TABLE Person(id BIGINT, name VARCHAR);

statement ok
INSERT INTO Person VALUES (1, 'a'), (2, 'b'), (3, 'c'), (4, 'd');

statement ok
CREATE TABLE Tag(id BIGINT, name VARCHAR);

statement ok
INSERT INTO Tag VALUES (10, 't10'), (11, 't11');

# Dangling: likes (2, 99), (9, 11), (NULL, 10); knows (2, 9), (9, 3), (3, NULL)
statement ok
CREATE TABLE likes(personId BIGINT, tagId BIGINT);

statement ok
INSERT INTO likes VALUES (1, 10), (2, 10), (2, 99), (9, 11), (NULL, 10), (3, 11);

statement ok
CREATE TABLE knows(src BIGINT, dst BIGINT);

statement ok
INSERT INTO knows VALUES (1, 2), (2, 3), (2, 9), (9, 3), (3, NULL), (3, 4);

statement ok
CREATE PROPERTY GRAPH g VERTEX TABLES (Person LABEL Person, Tag LABEL Tag)
EDGE TABLES (likes SOURCE KEY (personId) REFERENCES Person (id) DESTINATION KEY (tagId) REFERENCES Tag (id) LABEL Likes,
             knows SOURCE KEY (src) REFERENCES Person (id) DESTINATION KEY (dst) REFERENCES Person (id) LABEL Knows);

# The reported repro, traversed
statement ok
SET pgq_disable_abi_rewrite = true;

query II
FROM GRAPH_TABLE (g MATCH (p:Person)-[:Likes]->(t:Tag) COLUMNS (p.id AS p, t.id AS t)) ORDER BY ALL;
----
1	10
2	10
3	11

# =====================================================================================================================
# A. pgq_abi_build: the artifacts hold the complete edges only, and say so
# =====================================================================================================================
statement ok
SELECT count(*) FROM pgq_abi_build('g', exclude_self_referential := false, closures := ['Knows'],
    branch_summaries := [{'anchor': 'Person', 'branches': ['Likes', 'Knows']}]);

query I
SELECT count(*) FROM graph.__pg_g__Person__Likes__Tag;
----
3

query I
SELECT count(*) FROM graph.__pg_g__Person__Knows__Person;
----
3

query II
SELECT count(*), bool_and(endpoints_complete) FROM graph.__pgq_path_catalog WHERE graph_name = 'g';
----
8	true

statement ok
SET pgq_disable_abi_rewrite = false;

query II
FROM GRAPH_TABLE (g MATCH (p:Person)-[:Likes]->(t:Tag) COLUMNS (p.id AS p, t.id AS t)) ORDER BY ALL;
----
1	10
2	10
3	11

query I
SELECT count(*) > 0 FROM pgq_last_rewrite_diagnostics() WHERE status = 'selected';
----
true

# branch summary counts only tags that exist
query II
SELECT likes_count, knows_count FROM graph.__pg_g__branch__Person__Likes__Knows WHERE v0 = 2;
----
1	1

# A: edge, keys only
statement ok
SET pgq_disable_abi_rewrite = true;

statement ok
CREATE OR REPLACE TABLE t_trav AS FROM GRAPH_TABLE (g MATCH (p:Person)-[:Likes]->(t:Tag) COLUMNS (p.id AS p, t.id AS t));

statement ok
SET pgq_disable_abi_rewrite = false;

statement ok
CREATE OR REPLACE TABLE t_abi AS FROM GRAPH_TABLE (g MATCH (p:Person)-[:Likes]->(t:Tag) COLUMNS (p.id AS p, t.id AS t));

query I
SELECT count(*) FROM ((FROM t_abi EXCEPT ALL FROM t_trav) UNION ALL (FROM t_trav EXCEPT ALL FROM t_abi));
----
0

