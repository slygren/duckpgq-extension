# =====================================================================================================================
# E. Context expansion (every edge label but Knows; answered from artifacts only -- the traversal refuses an
#    unlabeled vertex over two vertex tables)
# =====================================================================================================================
statement ok
SET pgq_disable_abi_rewrite = false;

# Complete artifacts: person 2's complete likes are tag 10 only
query II
SELECT count(*), list(v) FROM GRAPH_TABLE (g MATCH p = (a:Person)-[:!Knows]->{1,2}(x) WHERE a.id = 2
                                           COLUMNS (vertices(p) AS v));
----
1	[[2, 10]]

query II
SELECT count(*), list(v) FROM GRAPH_TABLE (c MATCH p = (a:Person)-[:!Knows]->{1,2}(x) WHERE a.id = 2
                                           COLUMNS (vertices(p) AS v));
----
1	[[2, 10]]

# Families holding edges of the deleted person: those edges have it at their near end, which the expansion reaches
# only through a vertex on the path, so only the far ends matter -- measured complete -- and it answers what the
# complete artifacts answer
query II
SELECT count(*), list(v) FROM GRAPH_TABLE (h MATCH p = (a:Person)-[:!Knows]->{1,2}(x) WHERE a.id = 2
                                           COLUMNS (vertices(p) AS v));
----
1	[[2, 10]]

# =====================================================================================================================
# F. Keys of different types (a BIGINT vertex key referenced by a VARCHAR edge column, as some lake bridges do): the
#    build and the measurement compare them as text, so neither fails and the artifact still answers
# =====================================================================================================================
statement ok
CREATE TABLE MV(id BIGINT, name VARCHAR);

statement ok
INSERT INTO MV VALUES (1, 'a'), (2, 'b');

statement ok
CREATE TABLE MT(code VARCHAR, name VARCHAR);

statement ok
INSERT INTO MT VALUES ('x', 'tx'), ('y', 'ty');

statement ok
CREATE TABLE ME(vid VARCHAR, tcode VARCHAR);

statement ok
INSERT INTO ME VALUES ('1', 'x'), ('2', 'y'), ('9', 'x');

statement ok
CREATE PROPERTY GRAPH mg VERTEX TABLES (MV LABEL V, MT LABEL T)
EDGE TABLES (ME SOURCE KEY (vid) REFERENCES MV (id) DESTINATION KEY (tcode) REFERENCES MT (code) LABEL E);

statement ok
SELECT count(*) FROM pgq_abi_build('mg', schema := 'abi_m');

query I
SELECT count(*) FROM abi_m.__pg_mg__V__E__T;
----
2

statement ok
UPDATE abi_m.__pgq_path_catalog SET built_by = NULL, endpoints_complete = NULL WHERE graph_name = 'mg';

query II
FROM GRAPH_TABLE (mg MATCH (v:V)-[:E]->(t:T) COLUMNS (v.id AS v, t.code AS t)) ORDER BY ALL;
----
1	x
2	y

query II
SELECT (SELECT count(*) FROM pgq_last_rewrite_diagnostics() WHERE status = 'selected') > 0,
       (SELECT count(*) FROM pgq_last_rewrite_diagnostics() WHERE reason LIKE 'far_ends|%' AND status = 'exact');
----
true	2

# =====================================================================================================================
# G. A catalog with the proof but no provenance columns -- what the dwh layout compiler writes: the proof is read
# =====================================================================================================================

statement ok
CREATE TABLE GV(id VARCHAR PRIMARY KEY);

statement ok
CREATE TABLE GT(code VARCHAR PRIMARY KEY);

statement ok
CREATE TABLE GE(vid VARCHAR, tcode VARCHAR);

statement ok
INSERT INTO GV VALUES ('1'), ('2');

statement ok
INSERT INTO GT VALUES ('x'), ('y');

statement ok
INSERT INTO GE VALUES ('1', 'x'), ('2', 'y'), ('9', 'x'), ('1', 'z');

statement ok
CREATE PROPERTY GRAPH dg VERTEX TABLES (GV LABEL V, GT LABEL T)
EDGE TABLES (GE SOURCE KEY (vid) REFERENCES GV (id) DESTINATION KEY (tcode) REFERENCES GT (code) LABEL E);

statement ok
SELECT count(*) FROM pgq_abi_build('dg', schema := 'abi_dg');

# The layout compiler's catalog: endpoints_complete, none of the provenance columns
statement ok
ALTER TABLE abi_dg.__pgq_path_catalog DROP COLUMN source_snapshot;

statement ok
ALTER TABLE abi_dg.__pgq_path_catalog DROP COLUMN source_tables;

statement ok
ALTER TABLE abi_dg.__pgq_path_catalog DROP COLUMN built_by;

query II
FROM GRAPH_TABLE (dg MATCH (v:V)-[:E]->(t:T) COLUMNS (v.id AS v, t.code AS t)) ORDER BY ALL;
----
1	x
2	y

# Answered from the artifact without measuring it (the loader used to drop endpoints_complete with the provenance
# columns it did not find, and probed every artifact of such a catalog)
query II
SELECT (SELECT count(*) FROM pgq_last_rewrite_diagnostics() WHERE status = 'selected') > 0,
       (SELECT count(*) FROM pgq_last_rewrite_diagnostics() WHERE rewrite_type = 'multiplicity_probe');
----
true	0
