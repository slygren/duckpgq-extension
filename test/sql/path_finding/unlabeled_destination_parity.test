# name: test/sql/path_finding/unlabeled_destination_parity.test
# description: A vertex written without a label must behave like the labeled form or say why not
# group: [path_finding]

# Naming the destination label was hiding defects. Three separate bugs (2026-07-28) all
# bound fine as (x:Workorder) and misbehaved as (x) or ():
#
#   1. a k-hop artifact's mixed-type keys failed to bind      -> abi_context_mixed_key_types
#   2. label(x) folded an arbitrary placeholder table into a constant, silently wrong
#   3. ONE ROW PER over a compound edge label returned zero rows, silently wrong
#
# 2 and 3 are the dangerous shape: the query succeeds and the answer is untrue. So the
# rule this file encodes is not "unlabeled must work" -- sometimes it genuinely cannot --
# but "unlabeled must match the labeled answer, or refuse out loud". Never silence.

require duckpgq


statement ok
SET active_grammar_extensions = ['duckpgq'];

statement ok
CREATE TABLE tag(id VARCHAR, name VARCHAR);

statement ok
INSERT INTO tag VALUES ('T1', 'Pump A'), ('T2', 'Parent');

statement ok
CREATE TABLE workorder(id BIGINT, title VARCHAR);

statement ok
INSERT INTO workorder VALUES (10, 'WO-10'), (11, 'WO-11');

statement ok
CREATE TABLE note(id VARCHAR, body VARCHAR);

statement ok
INSERT INTO note VALUES ('N-1', 'note one');

statement ok
CREATE TABLE has_parent(src VARCHAR, dst VARCHAR);

statement ok
INSERT INTO has_parent VALUES ('T1', 'T2');

statement ok
CREATE TABLE has_workorder(src VARCHAR, dst BIGINT);

statement ok
INSERT INTO has_workorder VALUES ('T1', 10), ('T1', 11);

statement ok
CREATE TABLE has_note(src VARCHAR, dst VARCHAR);

statement ok
INSERT INTO has_note VALUES ('T1', 'N-1');

statement ok
CREATE PROPERTY GRAPH g
VERTEX TABLES (
    tag PROPERTIES (id, name) LABEL Tag,
    workorder PROPERTIES (id, title) LABEL Workorder,
    note PROPERTIES (id, body) LABEL Note
)
EDGE TABLES (
    has_parent SOURCE KEY (src) REFERENCES tag(id)
               DESTINATION KEY (dst) REFERENCES tag(id)
               LABEL HasParent,
    has_workorder SOURCE KEY (src) REFERENCES tag(id)
                  DESTINATION KEY (dst) REFERENCES workorder(id)
                  LABEL HasWorkorder,
    has_note SOURCE KEY (src) REFERENCES tag(id)
             DESTINATION KEY (dst) REFERENCES note(id)
             LABEL HasNote
);

# ── label() on an unlabeled destination ─────────────────────────────────────────
# A named edge DETERMINES the destination table, so (x) is not ambiguous here and
# label(x) must give the real answer -- not the placeholder registered for column
# validation, which is what silently produced a wrong label before.

query T rowsort
FROM GRAPH_TABLE ( g MATCH (t:Tag)-[:HasWorkorder]->(x) WHERE t.id = 'T1'
    COLUMNS (label(x) AS lbl) );
----
Workorder
Workorder

# Must equal the labeled form exactly -- that equality is the point of the file.
query T rowsort
FROM GRAPH_TABLE ( g MATCH (t:Tag)-[:HasWorkorder]->(x:Workorder) WHERE t.id = 'T1'
    COLUMNS (label(x) AS lbl) );
----
Workorder
Workorder

# Properties must resolve against the real table too, not the placeholder.
query T rowsort
FROM GRAPH_TABLE ( g MATCH (t:Tag)-[:HasWorkorder]->(x) WHERE t.id = 'T1'
    COLUMNS (x.title AS title) );
----
WO-10
WO-11

# Direction is what decides which end the vertex sits on; the left-directed form must
# resolve to the same table rather than to the edge's other endpoint.
query T rowsort
FROM GRAPH_TABLE ( g MATCH (x)<-[:HasWorkorder]-(t:Tag) WHERE t.id = 'T1'
    COLUMNS (label(x) AS lbl) );
----
Workorder
Workorder

# ── an unlabeled edge and vertex over several tables ────────────────────────────
# An unlabeled edge can reach Workorder, Note or Tag, so x has no single label: SQL/PGQ matches
# every one of them, and label(x) is each row's own (the union of one match per table).

query T rowsort
FROM GRAPH_TABLE ( g MATCH (t:Tag)-[]->(x) WHERE t.id = 'T1'
    COLUMNS (label(x) AS lbl) );
----
Note
Tag
Workorder
Workorder

# ── ONE ROW PER over a compound edge label ──────────────────────────────────────
# Named edge: works, and is the baseline the compound form is measured against.

query I rowsort
FROM GRAPH_TABLE ( g MATCH (t:Tag)-[:HasParent]->{1,2}(a:Tag) ONE ROW PER STEP (v1, e, v2)
    WHERE t.id = 'T1' COLUMNS (element_id(v1) AS a) );
----
0

# Compound edge: must NOT return zero rows as if the graph were empty.
statement error
FROM GRAPH_TABLE ( g MATCH (t:Tag)-[:!HasParent]->{1,2}(x:Workorder) ONE ROW PER STEP (v1, e, v2)
    WHERE t.id = 'T1' COLUMNS (element_id(v1) AS a) );
----
ONE ROW PER over a compound edge label

statement error
FROM GRAPH_TABLE ( g MATCH (t:Tag)-[:!HasParent]->{1,2}(x:Workorder) ONE ROW PER VERTEX (v)
    WHERE t.id = 'T1' COLUMNS (element_id(v) AS a) );
----
ONE ROW PER over a compound edge label

statement error
FROM GRAPH_TABLE ( g MATCH (t:Tag)-[:!HasParent]->{1,2}(x:Workorder) ONE ROW PER EDGE (e)
    WHERE t.id = 'T1' COLUMNS (element_id(e) AS a) );
----
ONE ROW PER over a compound edge label

# The same pattern without ONE ROW PER is answerable, which is what the error tells the
# user to fall back to -- so that claim has to be true. T1 has two Workorders, and now
# that traversal keys on the vertex key both come back.
query T
SELECT list_sort(list(title)) AS got FROM GRAPH_TABLE ( g MATCH (t:Tag)-[:HasWorkorder]->{1,2}(x:Workorder)
    WHERE t.id = 'T1' COLUMNS (x.title AS title) );
----
[WO-10, WO-11]

# A negated edge label selects every edge table but the one it names (SQL/PGQ): '!HasParent' is HasWorkorder and
# HasNote here, so T1 reaches its two Workorders in one hop. (It was resolved to has_parent itself and returned
# nothing; before traversal keyed on the vertex key it returned a phantom row from a rowid collision.)
query I rowsort
SELECT DISTINCT depth FROM GRAPH_TABLE ( g MATCH p = (t:Tag)-[:!HasParent]->{1,2}(x:Workorder)
    WHERE t.id = 'T1' COLUMNS (path_length(p) AS depth) );
----
1

# ── one hop on a graph with NO ABI artifacts ────────────────────────────────────
# The artifact-backed expansion answers an unlabeled destination per row (see
# abi_context_mixed_key_types). Without artifacts the pattern is answered per table: the
# edges that are not HasParent are HasWorkorder (to two Workorders) and HasNote (to a Note).
# (These refused before; what mattered was never to return a partial or empty result.)

query IT rowsort
FROM GRAPH_TABLE ( g MATCH p = (t:Tag)-[:!HasParent]->{1,1}(x) WHERE t.id = 'T1'
    COLUMNS (path_length(p) AS depth, label(x) AS lbl) );
----
1	Note
1	Workorder
1	Workorder

query I
FROM GRAPH_TABLE ( g MATCH p = (t:Tag)-[:!HasParent]->{1,1}() WHERE t.id = 'T1'
    COLUMNS (count(*) AS n) );
----
3

# Two further PRE-EXISTING defects were found here and deliberately left unasserted,
# because writing them down as expectations would freeze wrong behaviour in place. Both
# reproduce on a build with none of the 2026-07-28 changes:
#
#   * (fixed 2026-10-26) a negated edge label was resolved to the single table it names
#     instead of to its complement; it selects every other edge table now.
#   * (fixed 2026-07-28) the generic traversal addressed vertices by rowid, so a
#     cross-vertex-table edge leaked rows between unrelated vertices -- see
#     rowid_id_space_collision.test. It now carries vertex keys.
#
# Neither is about unlabeled destinations, so neither is fixed here.
