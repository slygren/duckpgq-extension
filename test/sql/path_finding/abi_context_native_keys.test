# name: test/sql/path_finding/abi_context_native_keys.test
# description: Context expansion from a source whose key is not VARCHAR, over families keyed by VARCHAR
# group: [path_finding]

# The expansion carried every key in the source key's type, which cannot hold a VARCHAR key: from a BIGINT or
# INTEGER source over a VARCHAR-keyed family it failed with "Cannot compare values of type VARCHAR and BIGINT".
# Each label's keys are now carried in their own type, each family joined on its own key, as the traversal joins an
# edge's key to the vertex key. The answers are checked against the traversal of every label sequence.

require duckpgq

statement ok
SET active_grammar_extensions = ['duckpgq'];

statement ok
CREATE TABLE a(id BIGINT, name VARCHAR);

statement ok
INSERT INTO a VALUES (1, 'a1'), (2, 'a2'), (7, 'a7');

statement ok
CREATE TABLE b(id VARCHAR, name VARCHAR);

statement ok
INSERT INTO b VALUES ('007', 'b007'), ('8', 'b8'), ('x', 'bx');

statement ok
CREATE TABLE c(id INTEGER, name VARCHAR);

statement ok
INSERT INTO c VALUES (10, 'c10'), (11, 'c11'), (12, 'c12');

statement ok
CREATE TABLE ab(s BIGINT, t VARCHAR);

statement ok
INSERT INTO ab VALUES (1, '007'), (1, '8'), (2, '8'), (7, 'x');

statement ok
CREATE TABLE ba(s VARCHAR, t BIGINT);

statement ok
INSERT INTO ba VALUES ('007', 2), ('8', 1), ('8', 7);

statement ok
CREATE TABLE bc(s VARCHAR, t INTEGER);

statement ok
INSERT INTO bc VALUES ('007', 10), ('8', 12);

statement ok
CREATE TABLE cc(s INTEGER, t INTEGER);

statement ok
INSERT INTO cc VALUES (10, 11), (11, 10), (11, 12), (12, 10);

statement ok
CREATE TABLE cb(s INTEGER, t VARCHAR);

statement ok
INSERT INTO cb VALUES (12, '007'), (11, 'x');

statement ok
CREATE PROPERTY GRAPH m
VERTEX TABLES (a LABEL A, b LABEL B, c LABEL C)
EDGE TABLES (
  ab SOURCE KEY (s) REFERENCES a (id) DESTINATION KEY (t) REFERENCES b (id) LABEL AB,
  ba SOURCE KEY (s) REFERENCES b (id) DESTINATION KEY (t) REFERENCES a (id) LABEL BA,
  bc SOURCE KEY (s) REFERENCES b (id) DESTINATION KEY (t) REFERENCES c (id) LABEL BC,
  cc SOURCE KEY (s) REFERENCES c (id) DESTINATION KEY (t) REFERENCES c (id) LABEL CC,
  cb SOURCE KEY (s) REFERENCES c (id) DESTINATION KEY (t) REFERENCES b (id) LABEL CB
);

# Without artifacts an unlabeled edge over five families is searched over all of them (SQL/PGQ: any edge): from the
# A vertices, 4 one-hop walks (ab) and 7 two-hop walks that visit no vertex twice (1-007-2, 1-007-10, 1-8-7, 1-8-12,
# 2-8-1, 2-8-7, 2-8-12; 1-8-1 returns to its start)
query II
SELECT len, count(*) FROM GRAPH_TABLE (m MATCH p = (s:A)-[]->{1,2}(x) COLUMNS (path_length(p) AS len)) GROUP BY len ORDER BY len;
----
1	4
2	7

statement ok
FROM pgq_abi_build('m', exclude_self_referential := false);

# ── From a BIGINT key ───────────────────────────────────────────────────────────────────────────────────────────────

query ITTT rowsort
FROM GRAPH_TABLE (m MATCH p = (s:A)-[]->{1,3}(x) WHERE s.id = 1
    COLUMNS (path_length(p) AS len, label(x) AS lbl, vertices(p) AS vs, edge_labels(p) AS els));
----
1	B	[1, 007]	[AB]
1	B	[1, 8]	[AB]
2	A	[1, 007, 2]	[AB, BA]
2	A	[1, 8, 7]	[AB, BA]
2	C	[1, 007, 10]	[AB, BC]
2	C	[1, 8, 12]	[AB, BC]
3	B	[1, 007, 2, 8]	[AB, BA, AB]
3	B	[1, 8, 12, 007]	[AB, BC, CB]
3	B	[1, 8, 7, x]	[AB, BA, AB]
3	C	[1, 007, 10, 11]	[AB, BC, CC]
3	C	[1, 8, 12, 10]	[AB, BC, CC]

query I
SELECT rewrite_type FROM pgq_last_rewrite_diagnostics() WHERE status = 'selected';
----
abi_context_expansion

# A negated edge label, every source
query ITT rowsort
FROM GRAPH_TABLE (m MATCH p = (s:A)-[:!CB]->{1,2}(x) COLUMNS (s.id AS src, label(x) AS lbl, vertices(p) AS vs));
----
1	A	[1, 007, 2]
1	A	[1, 8, 7]
1	B	[1, 007]
1	B	[1, 8]
1	C	[1, 007, 10]
1	C	[1, 8, 12]
2	A	[2, 8, 1]
2	A	[2, 8, 7]
2	B	[2, 8]
2	C	[2, 8, 12]
7	B	[7, x]

# A labelled destination binds its vertex table on the key
query TIT rowsort
FROM GRAPH_TABLE (m MATCH p = (s:A)-[]->{1,3}(x:C) WHERE s.id = 1 COLUMNS (x.name, path_length(p) AS len, vertices(p) AS vs));
----
c10	2	[1, 007, 10]
c10	3	[1, 8, 12, 10]
c11	3	[1, 007, 10, 11]
c12	2	[1, 8, 12]

query ITTT rowsort
FROM GRAPH_TABLE (m MATCH p = (s:A)-[]->{1,3}(x:B) WHERE s.id = 1 COLUMNS (s.id AS src, x.name, x.id, vertices(p) AS vs));
----
1	b007	007	[1, 007]
1	b007	007	[1, 8, 12, 007]
1	b8	8	[1, 007, 2, 8]
1	b8	8	[1, 8]
1	bx	x	[1, 8, 7, x]

query TIT rowsort
FROM GRAPH_TABLE (m MATCH p = ANY SHORTEST (s:A)-[]->{1,3}(x) WHERE s.id = 1 COLUMNS (label(x) AS lbl, path_length(p) AS len, vertices(p) AS vs));
----
A	2	[1, 007, 2]
A	2	[1, 8, 1]
A	2	[1, 8, 7]
B	1	[1, 007]
B	1	[1, 8]
B	3	[1, 8, 7, x]
C	2	[1, 007, 10]
C	2	[1, 8, 12]
C	3	[1, 007, 10, 11]

# The source key keeps its type
query TT
SELECT column_name, column_type FROM (DESCRIBE FROM GRAPH_TABLE (m MATCH p = (s:A)-[]->{1,3}(x) WHERE s.id = 1
    COLUMNS (s.id, vertices(p) AS vs)));
----
id	BIGINT
vs	VARCHAR[]

# ── From an INTEGER key ─────────────────────────────────────────────────────────────────────────────────────────────

query ITT rowsort
FROM GRAPH_TABLE (m MATCH p = (s:C)-[]->{1,2}(x) WHERE s.id = 12 COLUMNS (path_length(p) AS len, label(x) AS lbl, vertices(p) AS vs));
----
1	B	[12, 007]
1	C	[12, 10]
2	A	[12, 007, 2]
2	C	[12, 007, 10]
2	C	[12, 10, 11]

query I
SELECT rewrite_type FROM pgq_last_rewrite_diagnostics() WHERE status = 'selected';
----
abi_context_expansion

# ── The same paths from the traversal, one label sequence at a time ────────────────────────────────────────────────
# Fixed-length patterns are walks, so ALL_DIFFERENT keeps the simple paths the expansion enumerates.

statement ok
CREATE TABLE expansion AS
FROM GRAPH_TABLE (m MATCH p = (s:A)-[]->{1,3}(x) COLUMNS (s.id AS src, label(x) AS lbl, vertices(p) AS vs));

statement ok
SET pgq_abi_mode = 'off';

statement ok
CREATE TABLE traversal AS
          FROM GRAPH_TABLE (m MATCH (s:A)-[:AB]->(x:B)
              COLUMNS (s.id AS src, 'B' AS lbl, [CAST(s.id AS VARCHAR), x.id] AS vs))
UNION ALL FROM GRAPH_TABLE (m MATCH (s:A)-[:AB]->(b:B)-[:BA]->(x:A) WHERE ALL_DIFFERENT(s, x)
              COLUMNS (s.id, 'A', [CAST(s.id AS VARCHAR), b.id, CAST(x.id AS VARCHAR)]))
UNION ALL FROM GRAPH_TABLE (m MATCH (s:A)-[:AB]->(b:B)-[:BC]->(x:C)
              COLUMNS (s.id, 'C', [CAST(s.id AS VARCHAR), b.id, CAST(x.id AS VARCHAR)]))
UNION ALL FROM GRAPH_TABLE (m MATCH (s:A)-[:AB]->(b:B)-[:BA]->(a:A)-[:AB]->(x:B) WHERE ALL_DIFFERENT(s, a) AND ALL_DIFFERENT(b, x)
              COLUMNS (s.id, 'B', [CAST(s.id AS VARCHAR), b.id, CAST(a.id AS VARCHAR), x.id]))
UNION ALL FROM GRAPH_TABLE (m MATCH (s:A)-[:AB]->(b:B)-[:BC]->(c:C)-[:CB]->(x:B) WHERE ALL_DIFFERENT(b, x)
              COLUMNS (s.id, 'B', [CAST(s.id AS VARCHAR), b.id, CAST(c.id AS VARCHAR), x.id]))
UNION ALL FROM GRAPH_TABLE (m MATCH (s:A)-[:AB]->(b:B)-[:BC]->(c:C)-[:CC]->(x:C) WHERE ALL_DIFFERENT(c, x)
              COLUMNS (s.id, 'C', [CAST(s.id AS VARCHAR), b.id, CAST(c.id AS VARCHAR), CAST(x.id AS VARCHAR)]));

statement ok
SET pgq_abi_mode = 'consume';

query I
SELECT count(*) FROM expansion;
----
20

query I
SELECT count(*) FROM (FROM expansion EXCEPT ALL FROM traversal);
----
0

query I
SELECT count(*) FROM (FROM traversal EXCEPT ALL FROM expansion);
----
0

# ── A VARCHAR source over the same families answers as before ──────────────────────────────────────────────────────

query ITT rowsort
FROM GRAPH_TABLE (m MATCH p = (s:B)-[]->{1,2}(x) WHERE s.id = '007' COLUMNS (path_length(p) AS len, label(x) AS lbl, vertices(p) AS vs));
----
1	A	[007, 2]
1	C	[007, 10]
2	B	[007, 2, 8]
2	C	[007, 10, 11]
