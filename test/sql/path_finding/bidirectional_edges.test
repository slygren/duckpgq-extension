# name: test/sql/path_finding/bidirectional_edges.test
# description: <-[e]-> is an edge in either direction (SQL/PGQ "left or right"): the same matches as -[e]- in every form
# group: [path_finding]

require duckpgq

statement ok
SET active_grammar_extensions = ['duckpgq'];

# 1 -> 2 twice, 2 -> 1, 2 -> 3, 3 -> 4, 4 -> 1, a self-loop 5 -> 5; 6 isolated
statement ok
CREATE TABLE P(id BIGINT PRIMARY KEY, name VARCHAR);

statement ok
CREATE TABLE K(src BIGINT, dst BIGINT, w DOUBLE);

statement ok
INSERT INTO P VALUES (1, 'a'), (2, 'b'), (3, 'c'), (4, 'd'), (5, 'e'), (6, 'f');

statement ok
INSERT INTO K VALUES (1, 2, 1), (1, 2, 4), (2, 1, 2), (2, 3, 1), (3, 4, 1), (4, 1, 5), (5, 5, 1);

statement ok
CREATE PROPERTY GRAPH g VERTEX TABLES (P LABEL P)
EDGE TABLES (K SOURCE KEY (src) REFERENCES P (id) DESTINATION KEY (dst) REFERENCES P (id) LABEL K);

# Brute force: every edge read from either end, a self-loop once, its columns oriented along the match
statement ok
CREATE TABLE either AS SELECT src AS a, dst AS b, src AS s, dst AS d FROM K
UNION ALL SELECT dst, src, dst, src FROM K WHERE src <> dst;

statement ok
CREATE TABLE fixed AS SELECT * FROM GRAPH_TABLE (g MATCH (a:P)<-[e:K]->(b:P) COLUMNS (a.id AS a, b.id AS b, e.src AS s, e.dst AS d));

query III
SELECT (SELECT count(*) FROM fixed), (SELECT count(*) FROM (FROM fixed EXCEPT ALL FROM either)), (SELECT count(*) FROM (FROM either EXCEPT ALL FROM fixed));
----
13	0	0

# The anonymous form and the spaced forms are the same
query I
SELECT count(*) FROM GRAPH_TABLE (g MATCH (a:P)<->(b:P) COLUMNS (a.id AS a));
----
13

query I
SELECT count(*) FROM GRAPH_TABLE (g MATCH (a:P)< - >(b:P) COLUMNS (a.id AS a));
----
13

statement ok
SET pgq_disable_abi_rewrite = true;

# (a:P)<-[e:K]->{1,3}(b:P)
statement ok
CREATE OR REPLACE TABLE bi AS SELECT * FROM GRAPH_TABLE (g MATCH (a:P)<-[e:K]->{1,3}(b:P) COLUMNS (a.id AS a, b.id AS b));

statement ok
CREATE OR REPLACE TABLE un AS SELECT * FROM GRAPH_TABLE (g MATCH (a:P)-[e:K]-{1,3}(b:P) COLUMNS (a.id AS a, b.id AS b));

query III
SELECT (SELECT count(*) FROM bi) = (SELECT count(*) FROM un), (SELECT count(*) FROM (FROM bi EXCEPT ALL FROM un)), (SELECT count(*) FROM (FROM un EXCEPT ALL FROM bi));
----
true	0	0

# p = (a:P)<-[e:K]->{0,2}(b:P)
statement ok
CREATE OR REPLACE TABLE bi AS SELECT * FROM GRAPH_TABLE (g MATCH p = (a:P)<-[e:K]->{0,2}(b:P) COLUMNS (a.id AS a, b.id AS b, vertices(p) AS vs, edges(p) AS es));

statement ok
CREATE OR REPLACE TABLE un AS SELECT * FROM GRAPH_TABLE (g MATCH p = (a:P)-[e:K]-{0,2}(b:P) COLUMNS (a.id AS a, b.id AS b, vertices(p) AS vs, edges(p) AS es));

query III
SELECT (SELECT count(*) FROM bi) = (SELECT count(*) FROM un), (SELECT count(*) FROM (FROM bi EXCEPT ALL FROM un)), (SELECT count(*) FROM (FROM un EXCEPT ALL FROM bi));
----
true	0	0

# p = ANY SHORTEST (a:P)<-[e:K]->+(b:P)
statement ok
CREATE OR REPLACE TABLE bi AS SELECT * FROM GRAPH_TABLE (g MATCH p = ANY SHORTEST (a:P)<-[e:K]->+(b:P) COLUMNS (a.id AS a, b.id AS b, path_length(p) AS l));

statement ok
CREATE OR REPLACE TABLE un AS SELECT * FROM GRAPH_TABLE (g MATCH p = ANY SHORTEST (a:P)-[e:K]-+(b:P) COLUMNS (a.id AS a, b.id AS b, path_length(p) AS l));

query III
SELECT (SELECT count(*) FROM bi) = (SELECT count(*) FROM un), (SELECT count(*) FROM (FROM bi EXCEPT ALL FROM un)), (SELECT count(*) FROM (FROM un EXCEPT ALL FROM bi));
----
true	0	0

