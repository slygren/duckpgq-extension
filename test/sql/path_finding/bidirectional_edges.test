----
true	0	0

query I
SELECT status IN ('match', 'unverified') FROM pgq_verify_abi_rewrite('FROM GRAPH_TABLE (g MATCH (a:P)<-[e:K]->{1,3}(b:P) COLUMNS (a.id AS a, b.id AS b))');
----
true

