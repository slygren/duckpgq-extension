4	2	[81, 91]
4	3	[81, 91, 31]
5	1	[91, 31, 41]
5	3	[91, 31]
5	4	[91, 31, 51]
5	4	[91, 61]

# with ONE ROW PER, the list is the same on every row of a path
query TTT rowsort
FROM GRAPH_TABLE (g MATCH (a:P) -[e:K]->{1,2} (b) ONE ROW PER EDGE (z) WHERE a.id = 1 COLUMNS (b.id AS b, z.w AS zw, e.w AS ws));
----
2	11	[11]
2	21	[21]
3	11	[11, 31]
3	21	[21, 31]
3	31	[11, 31]
3	31	[21, 31]
4	11	[11, 61]
4	21	[21, 61]
4	61	[11, 61]
4	61	[21, 61]

# unbounded under ALL SHORTEST: the path search answers, e is read along each path
query TTT rowsort
FROM GRAPH_TABLE (g MATCH p = ALL SHORTEST (a:P) -[e:K]->+ (b:P) WHERE a.id = 1 COLUMNS (b.id AS b, e.w AS ws, sum(e.w) AS total));
----
2	[11]	11
2	[21]	21
3	[11, 31]	42
3	[21, 31]	52
4	[11, 61]	72
4	[21, 61]	82
5	[11, 61, 81]	153
5	[21, 61, 81]	163

# every simple path of an unbounded quantifier with a path mode
query TT rowsort
FROM GRAPH_TABLE (g MATCH p = ACYCLIC (a:P) -[e:K]->+ (b:P) WHERE a.id = 2 COLUMNS (b.id AS b, e.w AS ws));
----
1	[31, 41]
3	[31]
4	[31, 51]
4	[61]
5	[31, 51, 81]
5	[61, 81]

# label(e) alone keeps its meaning: one value, the edge label
query TT rowsort
FROM GRAPH_TABLE (g MATCH (a:P)-[e:K]->{1,2}(b:P) WHERE a.id = 1 COLUMNS (b.id AS b, label(e) AS l));
----
2	K
2	K
3	K
3	K
4	K
4	K

# ---------------------------------------------------------------------------------------------------- UNION, budget
# UNION ALL of MATCH blocks with groups
query TTT rowsort
FROM GRAPH_TABLE (g MATCH (a:P) ((x)-[e:K]->(y)){1,2} (b) WHERE a.id = 1 COLUMNS (a.id AS a, b.id AS b, len(x.id) AS n) UNION ALL MATCH (a:P) ((x)-[e:L]->(y)) (b) WHERE a.id = 1 COLUMNS (a.id AS a, b.id AS b, 1 AS n));
----
1	1	1
1	2	1
1	2	1
1	3	2
1	3	2
1	4	2
1	4	2

statement ok
SET pgq_max_vl_fallback_rows = 5;

# without a condition on a vertex outside it, a quantified pattern over budget is refused
statement error
FROM GRAPH_TABLE (g MATCH (a:P) ((x)-[e:K]->(y)){1,3} (b) COLUMNS (a.id, b.id));
----
exceeding pgq_max_vl_fallback_rows

# a condition on the vertex after the group seeds it
query TT rowsort
FROM GRAPH_TABLE (g MATCH (a:P) ((x)-[e:K]->(y)){1,3} (b) WHERE b.id = 4 COLUMNS (a.id AS a, b.id AS b));
----
1	4
1	4
1	4
1	4
2	4
2	4
3	4
3	4
3	4
5	4
5	4

statement ok
RESET pgq_max_vl_fallback_rows;

# each UNION ALL block keeps its own COLUMNS when one of them is lowered (a group, or a path pattern union)
query TT rowsort
FROM GRAPH_TABLE (g MATCH (a:P)-[:K]->(b:P) | (a:P)-[:L]->(b:Q) WHERE a.id = 1 COLUMNS (a.id AS x, 'head' AS src) UNION ALL MATCH (a:P)-[:K]->(b:P) WHERE a.id = 1 COLUMNS (b.id AS x, 'branch' AS src));
----
1	head
1	head
1	head
2	branch
2	branch

# ---------------------------------------------------------------------------------------------------- ABI artifacts
statement ok
SET pgq_disable_abi_rewrite = false;

statement ok
SELECT count(*) FROM pgq_abi_build('g', max_hops := 3, closures := ['K']);

# with artifacts the unrolled repetitions read fixed-path tables; a second pattern stays joined to the vertex after the group
query TTTT rowsort
FROM GRAPH_TABLE (g MATCH p = (a:P) ((x:P)-[e:L]->(m:Q)-[f:M]->(y)){0,2} (b), (b) -[k2:K]-> (c) WHERE a.id = 4 COLUMNS (a.id AS a, b.id AS b, c.id AS c, m.name AS ms));
----
4	1	2	[q3]
4	1	2	[q3]
4	3	1	[q3, q1]
4	3	4	[q3, q1]
4	4	4	[]
4	4	5	[]
4	5	2	[q3, q1]

# the same without a group: a named path answered by a fixed-path table keeps its join to the second pattern
query TTT rowsort
FROM GRAPH_TABLE (g MATCH p = (a:P)-[e:L]->(m:Q)-[f:M]->(b:P), (b:P)-[k2:K]->(c) WHERE a.id = 4 COLUMNS (a.id AS a, b.id AS b, c.id AS c));
----
4	1	2
4	1	2

# a group over one edge with artifacts
query TTT rowsort
FROM GRAPH_TABLE (g MATCH (a:P) ((x)-[e:K]->(y)){1,3} (b) WHERE a.id = 1 COLUMNS (a.id AS a, b.id AS b, e.w AS ws));
----
1	2	[11]
1	2	[21]
1	3	[11, 31]
1	3	[21, 31]
1	4	[11, 31, 51]
1	4	[11, 61]
1	4	[21, 31, 51]
1	4	[21, 61]
1	5	[11, 61, 81]
1	5	[21, 61, 81]

statement ok
SELECT count(*) FROM pgq_abi_drop('g');

# ---------------------------------------------------------------------------------------------------- refused
# nested quantified groups
statement error
FROM GRAPH_TABLE (g MATCH (a:P) (((x)-[:K]->(y)){2} (z)){1,2} (b) COLUMNS (a.id));
----
Nested quantified path patterns are not supported

# a quantified edge inside a group
statement error
FROM GRAPH_TABLE (g MATCH (a:P) ((x)-[:K]->{1,2}(y)){1,2} (b) COLUMNS (a.id));
----
A quantified edge inside a quantified path pattern is not supported

# a union inside a group
statement error
FROM GRAPH_TABLE (g MATCH (a:P) ((x)-[:K]->(y) | (x)-[:L]->(y)){1,2} (b) COLUMNS (a.id));
----
A path pattern union ('|' or '|+|') inside a parenthesized path pattern is not supported

# a path variable inside a group
statement error
FROM GRAPH_TABLE (g MATCH (a:P) (q = (x)-[:K]->(y)){1,2} (b) COLUMNS (a.id));
----
A path variable inside a parenthesized path pattern

# a search prefix inside a group
statement error
FROM GRAPH_TABLE (g MATCH (a:P) (ANY SHORTEST (x)-[:K]->(y)){1,2} (b) COLUMNS (a.id));
----
A search prefix (ANY / ALL SHORTEST, SHORTEST k, CHEAPEST) cannot be written inside a parenthesized path pattern

# a group in OPTIONAL MATCH
statement error
FROM GRAPH_TABLE (g MATCH (a:P) OPTIONAL MATCH (a) ((x)-[:K]->(y)){1,2} (b) COLUMNS (a.id));
----
A parenthesized path pattern in OPTIONAL MATCH is not supported

# a variable inside and outside a group
statement error
FROM GRAPH_TABLE (g MATCH (a:P) ((x)-[:K]->(y)){1,2} (x) COLUMNS (a.id));
----
is declared both inside a parenthesized path pattern and outside it

# a group variable read as a whole
statement error
FROM GRAPH_TABLE (g MATCH (a:P) ((x)-[:K]->(y)){1,2} (b) COLUMNS (x));
----
is a group variable (declared in a quantified path pattern) and stands for a list of elements

# x.* of a group variable
statement error
FROM GRAPH_TABLE (g MATCH (a:P) ((x)-[:K]->(y)){1,2} (b) COLUMNS (x.*));
----
cannot be returned

# a group variable inside EXISTS
statement error
FROM GRAPH_TABLE (g MATCH (a:P) ((x)-[:K]->(y)){1,2} (b) WHERE EXISTS { (x)-[:L]->() } COLUMNS (a.id));
----
EXISTS { } cannot refer to

# SHORTEST k over a group
statement error
FROM GRAPH_TABLE (g MATCH SHORTEST 2 (a:P) ((x)-[:K]->(y)){1,2} (b) COLUMNS (a.id));
----
SHORTEST k over a quantified path pattern is not supported

# CHEAPEST over a group
statement error
FROM GRAPH_TABLE (g MATCH ANY CHEAPEST (a:P) ((x)-[:K]->(y)){1,2} (b) COLUMNS (a.id));
----
CHEAPEST over a parenthesized path pattern is not supported

# an unbounded group without a path mode or selector
statement error
FROM GRAPH_TABLE (g MATCH (a:P) ((x)-[:K]->(y))+ (b) COLUMNS (a.id));
----
ALL unbounded with path mode WALK is not possible

# more iterations than are unrolled
statement error
FROM GRAPH_TABLE (g MATCH (a:P) ((x)-[:K]->(y)){1,9} (b) COLUMNS (a.id));
----
parenthesized path patterns are unrolled, up to 8 iterations

# a group that can match zero times with nothing around it
statement error
FROM GRAPH_TABLE (g MATCH ((x)-[:K]->(y)){0,2} COLUMNS (1));
----
needs a vertex pattern before or after it

# ONE ROW PER with a second pattern
statement error
FROM GRAPH_TABLE (g MATCH (a:P) ((x)-[:K]->(y)){1,2} (b), (b)-[:L]->(c) ONE ROW PER VERTEX (v) COLUMNS (v.id));
----
ONE ROW PER over a quantified path pattern needs it to be the only path pattern
