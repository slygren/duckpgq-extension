# name: test/sql/path_finding/abi_context_unrolled.test
# description: Context expansion unrolled by depth and frontier label answers as the recursive form did
# group: [path_finding]

# A seeded context expansion is one CTE per (depth, label), each joining only the edge families that leave
# that label, on the family's own v0. It replaces a recursive CTE over the UNION ALL of every family, so it
# must give that form's answer value for value: v0 / v1 typed as that UNION ALL types them, dst_id in the
# source key's type. The expected rows below are the recursive form's. D -> A is unreachable from every
# source here and must change nothing.

require duckpgq

statement ok
SET active_grammar_extensions = ['duckpgq'];

statement ok
CREATE TABLE a(id BIGINT, name VARCHAR);

statement ok
INSERT INTO a VALUES (1, 'a1'), (2, 'a2'), (7, 'a7');

statement ok
CREATE TABLE b(id VARCHAR, name VARCHAR);

statement ok
INSERT INTO b VALUES ('007', 'b007'), ('8', 'b8');

statement ok
CREATE TABLE c(id INTEGER, name VARCHAR);

statement ok
INSERT INTO c VALUES (10, 'c10'), (11, 'c11'), (12, 'c12');

statement ok
CREATE TABLE d(id VARCHAR, name VARCHAR);

statement ok
INSERT INTO d VALUES ('d1', 'd1');

statement ok
CREATE TABLE ab(s BIGINT, t VARCHAR);

statement ok
CREATE TABLE ba(s VARCHAR, t BIGINT);

statement ok
CREATE TABLE bc(s VARCHAR, t INTEGER);

statement ok
CREATE TABLE cc(s INTEGER, t INTEGER);

statement ok
CREATE TABLE da(s VARCHAR, t BIGINT);

statement ok
CREATE SCHEMA graph;

statement ok
CREATE TABLE graph.__pg_u__A__AB__B AS SELECT * FROM (VALUES (1::BIGINT, hash(1), '007'), (1, hash(2), '8'), (2, hash(3), '8')) t(v0, e1, v1);

statement ok
CREATE TABLE graph.__pg_u__B__BA__A AS SELECT * FROM (VALUES ('007', hash(4), 2::BIGINT), ('8', hash(5), 1), ('8', hash(6), 7)) t(v0, e1, v1);

statement ok
CREATE TABLE graph.__pg_u__B__BC__C AS SELECT * FROM (VALUES ('007', hash(7), 10::INTEGER), ('8', hash(8), 12)) t(v0, e1, v1);

statement ok
CREATE TABLE graph.__pg_u__C__CC__C AS SELECT * FROM (VALUES (10::INTEGER, hash(9), 11::INTEGER), (11, hash(10), 10), (11, hash(11), 12), (12, hash(12), 10)) t(v0, e1, v1);

statement ok
CREATE TABLE graph.__pg_u__D__DA__A AS SELECT * FROM (VALUES ('d1', hash(13), 1::BIGINT)) t(v0, e1, v1);

statement ok
CREATE TABLE graph.__pgq_path_catalog AS
SELECT * FROM (VALUES
  ('u','__pg_u__A__AB__B','edge',1,'A','B','A,B','AB',true,true,1,now(),true,1,1,'ab',true),
  ('u','__pg_u__B__BA__A','edge',1,'B','A','B,A','BA',true,true,1,now(),true,1,1,'ba',true),
  ('u','__pg_u__B__BC__C','edge',1,'B','C','B,C','BC',true,true,1,now(),true,1,1,'bc',true),
  ('u','__pg_u__C__CC__C','edge',1,'C','C','C,C','CC',true,true,1,now(),true,1,1,'cc',true),
  ('u','__pg_u__D__DA__A','edge',1,'D','A','D,A','DA',true,true,1,now(),true,1,1,'da',true)
) t(graph_name,path_table_name,path_kind,hop_count,src_label,dst_label,vertex_label_sequence,edge_label_sequence,
    supports_one_row_per_step,is_deduplicated,estimated_rows,last_refreshed_at,is_sorted_by_v0,min_depth,max_depth,
    bridge_table_names,preserves_multiplicity);

statement ok
ALTER TABLE graph.__pgq_path_catalog ADD COLUMN built_by VARCHAR DEFAULT 'pgq_abi_build';

statement ok
CREATE PROPERTY GRAPH u
VERTEX TABLES (a LABEL A, b LABEL B, c LABEL C, d LABEL D)
EDGE TABLES (
  ab SOURCE KEY (s) REFERENCES a(id) DESTINATION KEY (t) REFERENCES b(id) LABEL AB,
  ba SOURCE KEY (s) REFERENCES b(id) DESTINATION KEY (t) REFERENCES a(id) LABEL BA,
  bc SOURCE KEY (s) REFERENCES b(id) DESTINATION KEY (t) REFERENCES c(id) LABEL BC,
  cc SOURCE KEY (s) REFERENCES c(id) DESTINATION KEY (t) REFERENCES c(id) LABEL CC,
  da SOURCE KEY (s) REFERENCES d(id) DESTINATION KEY (t) REFERENCES a(id) LABEL DA
);

