INSERT INTO graph.__pgq_path_catalog (graph_name,path_table_name,path_kind,hop_count,src_label,dst_label,vertex_label_sequence,edge_label_sequence,
    supports_one_row_per_step,is_deduplicated,estimated_rows,last_refreshed_at,is_sorted_by_v0,min_depth,max_depth,
    bridge_table_names,preserves_multiplicity) VALUES
  ('h','__pg_h__P__PP__P','edge',1,'P','P','P,P','PP',true,true,1,now(),true,1,1,'pp',true),
  ('h','__pg_h__P__PQ__Q','edge',1,'P','Q','P,Q','PQ',true,true,1,now(),true,1,1,'pq',true),
  ('h','__pg_h__Q__QP__P','edge',1,'Q','P','Q,P','QP',true,true,1,now(),true,1,1,'qp',true);

statement ok
CREATE PROPERTY GRAPH h
VERTEX TABLES (p LABEL P, q LABEL Q)
EDGE TABLES (
  pp SOURCE KEY (s) REFERENCES p(id) DESTINATION KEY (t) REFERENCES p(id) LABEL PP,
  pq SOURCE KEY (s) REFERENCES p(id) DESTINATION KEY (t) REFERENCES q(id) LABEL PQ,
  qp SOURCE KEY (s) REFERENCES q(id) DESTINATION KEY (t) REFERENCES p(id) LABEL QP
);

# Seeded from a VARCHAR-keyed label across families keyed VARCHAR, BIGINT and INTEGER: v0 and v1 take the families'
# common type, VARCHAR, so '007' stays '007'
query ITTT rowsort
FROM GRAPH_TABLE (u MATCH p = (s:B)-[]->{1,3}(x) WHERE s.id = '8'
    COLUMNS (path_length(p) AS len, label(x) AS lbl, vertices(p) AS vs, edge_labels(p) AS els));
----
1	A	[8, 1]	[BA]
1	A	[8, 7]	[BA]
1	C	[8, 12]	[BC]
2	B	[8, 1, 007]	[BA, AB]
2	C	[8, 12, 10]	[BC, CC]
3	A	[8, 1, 007, 2]	[BA, AB, BA]
3	C	[8, 1, 007, 10]	[BA, AB, BC]
3	C	[8, 12, 10, 11]	[BC, CC, CC]

query TITT rowsort
FROM GRAPH_TABLE (u MATCH p = (s:B)-[]->{1,3}(x)
    COLUMNS (s.id AS src, path_length(p) AS len, vertices(p) AS vs, vertex_labels(p) AS vls));
----
007	1	[007, 10]	[B, C]
007	1	[007, 2]	[B, A]
007	2	[007, 10, 11]	[B, C, C]
007	2	[007, 2, 8]	[B, A, B]
007	3	[007, 10, 11, 12]	[B, C, C, C]
007	3	[007, 2, 8, 12]	[B, A, B, C]
007	3	[007, 2, 8, 1]	[B, A, B, A]
007	3	[007, 2, 8, 7]	[B, A, B, A]
8	1	[8, 12]	[B, C]
8	1	[8, 1]	[B, A]
8	1	[8, 7]	[B, A]
8	2	[8, 1, 007]	[B, A, B]
8	2	[8, 12, 10]	[B, C, C]
8	3	[8, 1, 007, 10]	[B, A, B, C]
8	3	[8, 1, 007, 2]	[B, A, B, A]
8	3	[8, 12, 10, 11]	[B, C, C, C]

# One key type throughout, with cycles: a path never revisits a vertex, nor returns to its start
query ITTT rowsort
FROM GRAPH_TABLE (h MATCH p = (s:P)-[]->{1,4}(x) WHERE s.id = 1
    COLUMNS (path_length(p) AS len, label(x) AS lbl, vertices(p) AS vs, edge_labels(p) AS els));
----
1	P	[1, 2]	[PP]
1	P	[1, 3]	[PP]
2	P	[1, 2, 3]	[PP, PP]
2	P	[1, 2, 4]	[PP, PP]
2	Q	[1, 2, 100]	[PP, PQ]
3	Q	[1, 2, 4, 101]	[PP, PP, PQ]

query III rowsort
SELECT src, len, count(*) FROM GRAPH_TABLE (h MATCH p = (s:Q)-[]->{1,5}(x) COLUMNS (s.id AS src, path_length(p) AS len))
GROUP BY ALL;
----
100	1	1
100	2	2
100	3	2
100	4	1
101	1	1

query TITT rowsort
FROM GRAPH_TABLE (h MATCH p = (s:P)-[]->{2,3}(x) WHERE s.id = 2
    COLUMNS (s.name AS sn, path_length(p) AS len, vertices(p) AS vs, vertex_labels(p) AS vls));
----
p2	2	[2, 100, 1]	[P, Q, P]
p2	2	[2, 3, 1]	[P, P, P]
p2	2	[2, 4, 101]	[P, P, Q]
p2	3	[2, 100, 1, 3]	[P, Q, P, P]

# Answered by the expansion, and without a recursive CTE
statement ok
FROM GRAPH_TABLE (h MATCH p = (s:P)-[]->{1,4}(x) WHERE s.id = 1 COLUMNS (path_length(p) AS len)) LIMIT 0;

query T
SELECT rewrite_type FROM pgq_last_rewrite_diagnostics() WHERE status = 'selected';
----
abi_context_expansion

query II
EXPLAIN FROM GRAPH_TABLE (h MATCH p = (s:P)-[]->{1,4}(x) WHERE s.id = 1 COLUMNS (path_length(p) AS len));
----
physical_plan	<!REGEX>:.*Rec CTE.*

query II
EXPLAIN FROM GRAPH_TABLE (u MATCH p = (s:B)-[]->{1,3}(x) WHERE s.id = '8' COLUMNS (path_length(p) AS len));
----
physical_plan	<!REGEX>:.*Rec CTE.*
