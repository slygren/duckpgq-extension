    COLUMNS (label(a) AS al, element_id(a) AS ai, label(b) AS bl, element_id(b) AS bi, vertices(p) AS vs,
             vertex_labels(p) AS vls, edges(p) AS es, edge_labels(p) AS els));

query IIII
SELECT (SELECT count(*) FROM ref) = (SELECT count(*) FROM got), (SELECT coalesce(max(len(es)), 0) < 8 FROM ref),
    (SELECT count(*) FROM (FROM got EXCEPT ALL FROM ref)), (SELECT count(*) FROM (FROM ref EXCEPT ALL FROM got));
----
true	true	0	0

# SHORTEST 3 SIMPLE (a:Person)-[e:Takes|HeldIn]-{1,4}(b) WHERE element_id(a) = 0
statement ok
CREATE OR REPLACE TABLE ref AS SELECT src_l, src_i, cur_l, cur_i, vs, vls, es, els FROM walks
WHERE lab = 'takesheld' AND dir = '-' AND depth BETWEEN 1 AND 4 AND mode = 'SIMPLE' AND src_l = 'Person' AND src_i = 0
QUALIFY row_number() OVER (PARTITION BY src_l, src_i, cur_l, cur_i ORDER BY depth, ek) <= 3;

statement ok
CREATE OR REPLACE TABLE got AS FROM GRAPH_TABLE (g MATCH p = SHORTEST 3 SIMPLE (a:Person)-[e:Takes|HeldIn]-{1,4}(b) WHERE element_id(a) = 0
    COLUMNS (label(a) AS al, element_id(a) AS ai, label(b) AS bl, element_id(b) AS bi, vertices(p) AS vs,
             vertex_labels(p) AS vls, edges(p) AS es, edge_labels(p) AS els));

query IIII
SELECT (SELECT count(*) FROM ref) = (SELECT count(*) FROM got), (SELECT coalesce(max(len(es)), 0) < 8 FROM ref),
    (SELECT count(*) FROM (FROM got EXCEPT ALL FROM ref)), (SELECT count(*) FROM (FROM ref EXCEPT ALL FROM got));
----
true	true	0	0

# SHORTEST 2 GROUPS SIMPLE (a)-[e:Takes|HeldIn]-{1,4}(b:Person) 
statement ok
CREATE OR REPLACE TABLE ref AS SELECT src_l, src_i, cur_l, cur_i, vs, vls, es, els FROM walks
WHERE lab = 'takesheld' AND dir = '-' AND depth BETWEEN 1 AND 4 AND mode = 'SIMPLE' AND cur_l = 'Person'
QUALIFY dense_rank() OVER (PARTITION BY src_l, src_i, cur_l, cur_i ORDER BY depth) <= 2;

statement ok
CREATE OR REPLACE TABLE got AS FROM GRAPH_TABLE (g MATCH p = SHORTEST 2 GROUPS SIMPLE (a)-[e:Takes|HeldIn]-{1,4}(b:Person) 
    COLUMNS (label(a) AS al, element_id(a) AS ai, label(b) AS bl, element_id(b) AS bi, vertices(p) AS vs,
             vertex_labels(p) AS vls, edges(p) AS es, edge_labels(p) AS els));

query IIII
SELECT (SELECT count(*) FROM ref) = (SELECT count(*) FROM got), (SELECT coalesce(max(len(es)), 0) < 8 FROM ref),
    (SELECT count(*) FROM (FROM got EXCEPT ALL FROM ref)), (SELECT count(*) FROM (FROM ref EXCEPT ALL FROM got));
----
true	true	0	0

# The search over several tables is reported: one shortest walk per pair from every Person
query II
SELECT count(*), count(*) = (SELECT count(*) FROM (SELECT DISTINCT src_i, cur_l, cur_i FROM walks WHERE lab = 'all' AND dir = '->'
    AND mode = 'WALK' AND depth >= 1 AND src_l = 'Person')) FROM GRAPH_TABLE (g MATCH p = ANY SHORTEST (a:Person)-[e]->+(b) COLUMNS (a.id));
----
24	true

query T
SELECT reason FROM pgq_last_rewrite_diagnostics() WHERE rewrite_type = 'path_search' LIMIT 1;
----
native path search over 4 edge tables and 3 vertex tables: first 1 per pair, walk, steps 1..1073741824

# Properties of the ends (each of its own table: NULL where the table has none)
query IIII
FROM GRAPH_TABLE (g MATCH p = ANY SHORTEST (a:Person WHERE a.id = 2)-[e]->+(b:Room|Course)
                  COLUMNS (b.rid, b.cid, b.title, path_length(p) AS l)) ORDER BY ALL;
----
7	NULL	NULL	3
8	NULL	NULL	2
NULL	1	x	2
NULL	2	y	1

# OPTIONAL MATCH over the search, and a UNION MATCH block
query II
FROM GRAPH_TABLE (g MATCH (a:Course) OPTIONAL MATCH ANY SHORTEST (a)-[e:Takes|HeldIn]->{1,3}(b:Room) COLUMNS (a.cid, b.rid)) ORDER BY ALL;
----
1	7
2	8

query II
FROM GRAPH_TABLE (g MATCH (r:Room) WHERE r.rid = 7 COLUMNS (label(r) AS l, r.rid AS i)
                  UNION ALL MATCH ANY SHORTEST (a:Room WHERE a.rid = 8)-[e]->+(b:Room WHERE b.rid = 7) COLUMNS (label(b), b.rid)) ORDER BY ALL;
----
Room	7
Room	7

# --- with ABI artifacts: the same answers (no artifact holds walks across tables but the expansions)
statement ok
SET pgq_disable_abi_rewrite = false;

statement ok
SELECT count(*) FROM pgq_abi_build('g', exclude_self_referential := false, max_hops := 2);

statement ok
CREATE OR REPLACE TABLE got AS FROM GRAPH_TABLE (g MATCH p = (a:Person WHERE a.id = 1)-[e:!Knows]->{1,2}(b)
    COLUMNS (label(b) AS bl, element_id(b) AS bi, path_length(p) AS l));

statement ok
CREATE OR REPLACE TABLE ref AS SELECT cur_l, cur_i, depth FROM walks WHERE lab = 'notknows' AND dir = '->' AND mode = 'ACYCLIC'
    AND depth BETWEEN 1 AND 2 AND src_l = 'Person' AND src_i = 0;

query III
SELECT (SELECT count(*) FROM got) > 0, (SELECT count(*) FROM (FROM got EXCEPT ALL FROM ref)), (SELECT count(*) FROM (FROM ref EXCEPT ALL FROM got));
----
true	0	0

