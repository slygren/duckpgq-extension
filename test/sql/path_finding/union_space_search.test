QUALIFY dense_rank() OVER (PARTITION BY src_l, src_i, cur_l, cur_i ORDER BY depth) <= 2;

statement ok
CREATE OR REPLACE TABLE got AS FROM GRAPH_TABLE (g MATCH p = SHORTEST 2 GROUPS (a:Person)-[e]-+(b) WHERE element_id(a) = 0
    COLUMNS (label(a) AS al, element_id(a) AS ai, label(b) AS bl, element_id(b) AS bi, vertices(p) AS vs,
             vertex_labels(p) AS vls, edges(p) AS es, edge_labels(p) AS els));

query IIII
SELECT (SELECT count(*) FROM ref) = (SELECT count(*) FROM got), (SELECT coalesce(max(len(es)), 0) < 8 FROM ref),
    (SELECT count(*) FROM (FROM got EXCEPT ALL FROM ref)), (SELECT count(*) FROM (FROM ref EXCEPT ALL FROM got));
----
true	true	0	0

