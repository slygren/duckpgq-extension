# name: test/sql/path_finding/union_space_search.test
# description: A quantified edge whose label expression selects edge tables over several vertex tables (or that has
#              no label in such a graph): its walks cross tables. Answered by the native search over one id space for
#              all the tables, every selector (none, ANY / ALL SHORTEST, SHORTEST k, ANY k, SHORTEST k GROUPS), every
#              direction and mode, with labeled and unlabeled ends, against an SQL enumeration of the walks. Ties are
#              broken by the edges along the path compared position by position, an edge by its table (in the graph's
#              order) and then its row id. Generated by gen_union_space.py.
# group: [path_finding]

require duckpgq

statement ok
SET active_grammar_extensions = ['duckpgq'];

statement ok
CREATE TABLE P(id BIGINT PRIMARY KEY, name VARCHAR);

statement ok
INSERT INTO P VALUES (1, 'a'), (2, 'b'), (3, 'c'), (4, 'd');

statement ok
CREATE TABLE C(cid BIGINT PRIMARY KEY, title VARCHAR);

statement ok
INSERT INTO C VALUES (1, 'x'), (2, 'y');

statement ok
CREATE TABLE R(rid BIGINT PRIMARY KEY, name VARCHAR);

statement ok
INSERT INTO R VALUES (7, 'r7'), (8, 'r8');

# Knows P->P (parallel 1->2, a cycle 1->2->3->1), Takes P->C, HeldIn C->R, Hosts R->P (cycles across the tables)
statement ok
CREATE TABLE K(src BIGINT, dst BIGINT);

statement ok
INSERT INTO K VALUES (1, 2), (1, 2), (2, 3), (3, 1);

statement ok
CREATE TABLE T(pid BIGINT, cid BIGINT);

statement ok
INSERT INTO T VALUES (1, 1), (2, 2), (3, 1);

statement ok
CREATE TABLE H(cid BIGINT, rid BIGINT);

statement ok
INSERT INTO H VALUES (1, 7), (2, 8);

statement ok
CREATE TABLE O(rid BIGINT, pid BIGINT);

statement ok
INSERT INTO O VALUES (7, 4), (8, 1);

statement ok
CREATE PROPERTY GRAPH g
VERTEX TABLES (P LABEL Person, C LABEL Course, R LABEL Room)
EDGE TABLES (K SOURCE KEY (src) REFERENCES P (id) DESTINATION KEY (dst) REFERENCES P (id) LABEL Knows,
             T SOURCE KEY (pid) REFERENCES P (id) DESTINATION KEY (cid) REFERENCES C (cid) LABEL Takes,
             H SOURCE KEY (cid) REFERENCES C (cid) DESTINATION KEY (rid) REFERENCES R (rid) LABEL HeldIn,
             O SOURCE KEY (rid) REFERENCES R (rid) DESTINATION KEY (pid) REFERENCES P (id) LABEL Hosts);

# Every edge with its ends as (label, row id) and its order key (edge table in the graph's order, then row id)
statement ok
CREATE TABLE edges AS
SELECT 'Knows' AS el, 0 AS et, e.rowid AS ei, 'Person' AS sl, s.rowid AS si, 'Person' AS dl, d.rowid AS di FROM K e JOIN P s ON s.id = e.src JOIN P d ON d.id = e.dst
UNION ALL SELECT 'Takes', 1, e.rowid, 'Person', s.rowid, 'Course', d.rowid FROM T e JOIN P s ON s.id = e.pid JOIN C d ON d.cid = e.cid
UNION ALL SELECT 'HeldIn', 2, e.rowid, 'Course', s.rowid, 'Room', d.rowid FROM H e JOIN C s ON s.cid = e.cid JOIN R d ON d.rid = e.rid
UNION ALL SELECT 'Hosts', 3, e.rowid, 'Room', s.rowid, 'Person', d.rowid FROM O e JOIN R s ON s.rid = e.rid JOIN P d ON d.id = e.pid;

statement ok
CREATE TABLE vertices AS SELECT 'Person' AS l, rowid AS i FROM P UNION ALL SELECT 'Course', rowid FROM C UNION ALL SELECT 'Room', rowid FROM R;

# The walks of up to 8 steps, in each direction and mode, over the edges each label expression selects
statement ok
CREATE TABLE walks AS
WITH RECURSIVE steps(dir, sl, si, tl, ti, el, et, ei) AS (
    SELECT '->', sl, si, dl, di, el, et, ei FROM edges
    UNION ALL SELECT '<-', dl, di, sl, si, el, et, ei FROM edges
    UNION ALL SELECT '-', sl, si, dl, di, el, et, ei FROM edges
    UNION ALL SELECT '-', dl, di, sl, si, el, et, ei FROM edges WHERE NOT (sl = dl AND si = di)),
w(lab, dir, mode, src_l, src_i, cur_l, cur_i, depth, vs, vls, es, els, ek, vk) AS (
    SELECT lab, d, m, l, i, l, i, 0, [i], [l], []::BIGINT[], []::VARCHAR[], []::BIGINT[], [l || ':' || i]
    FROM vertices, (VALUES ('->'), ('<-'), ('-')) t(d), (VALUES ('WALK'), ('TRAIL'), ('ACYCLIC'), ('SIMPLE')) u(m),
         (VALUES ('all'), ('notknows'), ('takesheld')) x(lab)
    UNION ALL
    SELECT w.lab, w.dir, w.mode, w.src_l, w.src_i, steps.tl, steps.ti, w.depth + 1, list_append(w.vs, steps.ti),
           list_append(w.vls, steps.tl), list_append(w.es, steps.ei), list_append(w.els, steps.el),
           list_append(w.ek, steps.et * 1000 + steps.ei), list_append(w.vk, steps.tl || ':' || steps.ti)
    FROM w JOIN steps ON steps.dir = w.dir AND steps.sl = w.cur_l AND steps.si = w.cur_i
    WHERE w.depth < 8
      AND (w.lab = 'all' OR (w.lab = 'notknows' AND steps.el <> 'Knows') OR (w.lab = 'takesheld' AND steps.el IN ('Takes', 'HeldIn')))
      AND (w.mode <> 'TRAIL' OR NOT list_contains(w.ek, steps.et * 1000 + steps.ei))
      AND (w.mode <> 'ACYCLIC' OR NOT list_contains(w.vk, steps.tl || ':' || steps.ti))
      AND (w.mode <> 'SIMPLE' OR ((NOT list_contains(w.vk, steps.tl || ':' || steps.ti) OR (steps.tl = w.src_l AND steps.ti = w.src_i))
                                  AND (w.depth = 0 OR NOT (w.cur_l = w.src_l AND w.cur_i = w.src_i)))))
SELECT * FROM w;

statement ok
SET pgq_disable_abi_rewrite = true;

# (a:Person)-[e]->{1,3}(b) WHERE element_id(a) = 0
statement ok
CREATE OR REPLACE TABLE ref AS SELECT src_l, src_i, cur_l, cur_i, vs, vls, es, els FROM walks
WHERE lab = 'all' AND dir = '->' AND depth BETWEEN 1 AND 3 AND mode = 'ACYCLIC' AND src_l = 'Person' AND src_i = 0
;

statement ok
CREATE OR REPLACE TABLE got AS FROM GRAPH_TABLE (g MATCH p = (a:Person)-[e]->{1,3}(b) WHERE element_id(a) = 0
    COLUMNS (label(a) AS al, element_id(a) AS ai, label(b) AS bl, element_id(b) AS bi, vertices(p) AS vs,
             vertex_labels(p) AS vls, edges(p) AS es, edge_labels(p) AS els));

query IIII
SELECT (SELECT count(*) FROM ref) = (SELECT count(*) FROM got), (SELECT coalesce(max(len(es)), 0) < 8 FROM ref),
    (SELECT count(*) FROM (FROM got EXCEPT ALL FROM ref)), (SELECT count(*) FROM (FROM ref EXCEPT ALL FROM got));
----
true	true	0	0

# ANY SHORTEST (a:Person)-[e]->{1,3}(b) WHERE element_id(a) = 0
statement ok
CREATE OR REPLACE TABLE ref AS SELECT src_l, src_i, cur_l, cur_i, vs, vls, es, els FROM walks
WHERE lab = 'all' AND dir = '->' AND depth BETWEEN 1 AND 3 AND mode = 'WALK' AND src_l = 'Person' AND src_i = 0
QUALIFY row_number() OVER (PARTITION BY src_l, src_i, cur_l, cur_i ORDER BY depth, ek) <= 1;

statement ok
CREATE OR REPLACE TABLE got AS FROM GRAPH_TABLE (g MATCH p = ANY SHORTEST (a:Person)-[e]->{1,3}(b) WHERE element_id(a) = 0
    COLUMNS (label(a) AS al, element_id(a) AS ai, label(b) AS bl, element_id(b) AS bi, vertices(p) AS vs,
             vertex_labels(p) AS vls, edges(p) AS es, edge_labels(p) AS els));

query IIII
SELECT (SELECT count(*) FROM ref) = (SELECT count(*) FROM got), (SELECT coalesce(max(len(es)), 0) < 8 FROM ref),
    (SELECT count(*) FROM (FROM got EXCEPT ALL FROM ref)), (SELECT count(*) FROM (FROM ref EXCEPT ALL FROM got));
----
true	true	0	0

