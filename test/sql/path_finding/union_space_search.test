CREATE OR REPLACE TABLE ref AS SELECT src_l, src_i, cur_l, cur_i, vs, vls, es, els FROM walks
WHERE lab = 'notknows' AND dir = '->' AND depth BETWEEN 0 AND 8 AND mode = 'ACYCLIC' AND src_l = 'Course'
;

statement ok
CREATE OR REPLACE TABLE got AS FROM GRAPH_TABLE (g MATCH p = ACYCLIC (a:Course)-[e:!Knows]->*(b) 
    COLUMNS (label(a) AS al, element_id(a) AS ai, label(b) AS bl, element_id(b) AS bi, vertices(p) AS vs,
             vertex_labels(p) AS vls, edges(p) AS es, edge_labels(p) AS els));

query IIII
SELECT (SELECT count(*) FROM ref) = (SELECT count(*) FROM got), (SELECT coalesce(max(len(es)), 0) < 8 FROM ref),
    (SELECT count(*) FROM (FROM got EXCEPT ALL FROM ref)), (SELECT count(*) FROM (FROM ref EXCEPT ALL FROM got));
----
true	true	0	0

# ANY SHORTEST (a:Course)-[e:!Knows]->*(b) 
statement ok
CREATE OR REPLACE TABLE ref AS SELECT src_l, src_i, cur_l, cur_i, vs, vls, es, els FROM walks
WHERE lab = 'notknows' AND dir = '->' AND depth BETWEEN 0 AND 8 AND mode = 'WALK' AND src_l = 'Course'
QUALIFY row_number() OVER (PARTITION BY src_l, src_i, cur_l, cur_i ORDER BY depth, ek) <= 1;

statement ok
CREATE OR REPLACE TABLE got AS FROM GRAPH_TABLE (g MATCH p = ANY SHORTEST (a:Course)-[e:!Knows]->*(b) 
    COLUMNS (label(a) AS al, element_id(a) AS ai, label(b) AS bl, element_id(b) AS bi, vertices(p) AS vs,
             vertex_labels(p) AS vls, edges(p) AS es, edge_labels(p) AS els));

query IIII
SELECT (SELECT count(*) FROM ref) = (SELECT count(*) FROM got), (SELECT coalesce(max(len(es)), 0) < 8 FROM ref),
    (SELECT count(*) FROM (FROM got EXCEPT ALL FROM ref)), (SELECT count(*) FROM (FROM ref EXCEPT ALL FROM got));
----
true	true	0	0

