    (FROM GRAPH_TABLE (g MATCH p = (a:P)-[e:K]->(b:P) COLUMNS (a.id AS a, b.id AS b, path_length(p) AS l, vertices(p) AS v, vertex_labels(p) AS vl, list_sum(vertex_property(p, 'w')) AS ws))) m ON m.a = v.id;

