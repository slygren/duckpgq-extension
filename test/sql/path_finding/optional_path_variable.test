# artifacts: fixed two hops
statement ok
CREATE OR REPLACE TABLE t_opt AS FROM GRAPH_TABLE (g MATCH (a:P) OPTIONAL MATCH p = (a)-[e:K]->(m:P)-[f:K]->(b:P) COLUMNS (a.id AS a, b.id AS b, path_length(p) AS l, vertices(p) AS v, vertex_labels(p) AS vl, list_sum(vertex_property(p, 'w')) AS ws, path_length(p) * 100 + a.id AS mix));

statement ok
CREATE OR REPLACE TABLE t_ref AS SELECT v.id AS a, m.b, m.l, m.v, m.vl, m.ws, m.l * 100 + v.id AS mix FROM P v LEFT JOIN
    (FROM GRAPH_TABLE (g MATCH p = (a:P)-[e:K]->(m:P)-[f:K]->(b:P) COLUMNS (a.id AS a, b.id AS b, path_length(p) AS l, vertices(p) AS v, vertex_labels(p) AS vl, list_sum(vertex_property(p, 'w')) AS ws))) m ON m.a = v.id;

query III
SELECT (SELECT count(*) FROM t_opt WHERE l IS NULL) > 0, (SELECT count(*) FROM t_opt WHERE l IS NOT NULL) > 0,
       (SELECT count(*) FROM ((FROM t_opt EXCEPT ALL FROM t_ref) UNION ALL (FROM t_ref EXCEPT ALL FROM t_opt)));
