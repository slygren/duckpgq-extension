true	true	0

# In the MATCH WHERE: rows filter as for any optional variable (a NULL comparison drops the row)
statement ok
SET pgq_disable_abi_rewrite = true;

query III
SELECT * FROM GRAPH_TABLE (g MATCH (a:P) OPTIONAL MATCH p = (a)-[e:K]->{1,2}(b:P) WHERE path_length(p) = 2
                           COLUMNS (a.id AS a, b.id AS b, path_length(p) AS l)) ORDER BY ALL;
----
1	3	2
1	3	2
1	4	2
2	4	2

query II
SELECT * FROM GRAPH_TABLE (g MATCH (a:P) OPTIONAL MATCH p = (a)-[e:K]->{1,2}(b:P)
                           WHERE path_length(p) IS NULL OR list_sum(vertex_property(p, 'w')) > 60
                           COLUMNS (a.id AS a, path_length(p) AS l)) ORDER BY ALL;
----
1	2
2	2
3	1
4	NULL
5	NULL

# element_id(p) of an optional path
query II
SELECT a, len(ids) FROM GRAPH_TABLE (g MATCH (a:P) OPTIONAL MATCH p = ANY SHORTEST (a)-[e:K]->+(b:P) WHERE a.id = 3
                                     COLUMNS (a.id AS a, element_id(p) AS ids)) ORDER BY ALL;
----
3	3

# UNION branches with their own COLUMNS
query II
SELECT * FROM GRAPH_TABLE (g MATCH (a:P) OPTIONAL MATCH p = (a)-[e:K]->{1,3}(b:P) WHERE a.id = 4 COLUMNS (a.id AS a, path_length(p) AS l)
                           UNION ALL MATCH (a:P) OPTIONAL MATCH q = ANY SHORTEST (a)-[e:K]->+(b:P) WHERE a.id = 3 COLUMNS (a.id AS a, path_length(q) AS l))
ORDER BY ALL;
----
3	1
4	NULL
