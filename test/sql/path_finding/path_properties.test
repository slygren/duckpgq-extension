# A hierarchy, whose closures are exact: the chain and witness artifacts answer
statement ok
CREATE TABLE node(id INTEGER PRIMARY KEY, name VARCHAR, prio INTEGER);

statement ok
INSERT INTO node SELECT i, 'n' || i, i % 7 FROM range(1, 41) t(i);

statement ok
CREATE TABLE parent(src INTEGER, dst INTEGER, w INTEGER);

statement ok
INSERT INTO parent SELECT i, i // 2, i % 5 FROM range(2, 41) t(i);

statement ok
CREATE PROPERTY GRAPH tree VERTEX TABLES (node LABEL Node)
EDGE TABLES (parent SOURCE KEY (src) REFERENCES node (id) DESTINATION KEY (dst) REFERENCES node (id) LABEL Parent);

statement ok
SET pgq_abi_mode = 'off';

statement ok
CREATE OR REPLACE TABLE trav_tree AS
FROM GRAPH_TABLE (tree MATCH p = (a:Node)-[:Parent]->{1,5}(b:Node)
                  COLUMNS (a.id AS a, b.id AS b, vertex_property(p, 'name') AS names,
                           list_sum(vertex_property(p, 'prio')) AS s, list_max(vertex_property(p, 'prio')) AS m));

statement ok
CREATE OR REPLACE TABLE trav_tree_shortest AS
FROM GRAPH_TABLE (tree MATCH p = ANY SHORTEST (a:Node)-[:Parent]->+(b:Node) WHERE b.id = 1
                  COLUMNS (a.id AS a, vertex_property(p, 'prio') AS prios));

statement ok
SET pgq_abi_mode = 'consume';

statement ok
FROM pgq_abi_build('tree', exclude_self_referential := false, closures := ['Parent']);

statement ok
CREATE OR REPLACE TABLE actual AS
FROM GRAPH_TABLE (tree MATCH p = (a:Node)-[:Parent]->{1,5}(b:Node)
                  COLUMNS (a.id AS a, b.id AS b, vertex_property(p, 'name') AS names,
                           list_sum(vertex_property(p, 'prio')) AS s, list_max(vertex_property(p, 'prio')) AS m));

query T
SELECT list(DISTINCT path_kind) FROM pgq_last_rewrite_diagnostics() WHERE status = 'selected';
----
[tc_chain]

query II
SELECT (SELECT count(*) FROM actual), count(*) FROM ((FROM actual EXCEPT ALL FROM trav_tree) UNION ALL (FROM trav_tree EXCEPT ALL FROM actual));
----
143	0

statement ok
CREATE OR REPLACE TABLE actual AS
FROM GRAPH_TABLE (tree MATCH p = ANY SHORTEST (a:Node)-[:Parent]->+(b:Node) WHERE b.id = 1
                  COLUMNS (a.id AS a, vertex_property(p, 'prio') AS prios));

query I
SELECT count(*) > 0 FROM pgq_last_rewrite_diagnostics() WHERE status = 'selected';
----
true

query II
SELECT (SELECT count(*) FROM actual), count(*) FROM ((FROM actual EXCEPT ALL FROM trav_tree_shortest) UNION ALL (FROM trav_tree_shortest EXCEPT ALL FROM actual));
----
39	0

# Each list is the property of the path's vertices, in order: against vertices(p), the keys the artifact holds
query I
SELECT count(*) FROM GRAPH_TABLE (tree MATCH p = (a:Node)-[:Parent]->{1,5}(b:Node)
                                  COLUMNS (vertices(p) AS ids, vertex_property(p, 'name') AS names))
WHERE names <> list_transform(ids, lambda x: 'n' || x);
----
0

# ---------------------------------------------------------------------------------------------------------------------
# Errors
# ---------------------------------------------------------------------------------------------------------------------

statement error
FROM GRAPH_TABLE (mg MATCH (a:Tag)-[:HasParent]->(b:Tag) COLUMNS (vertex_property(a, 'name')));
----
needs 'a' to be a path variable of this MATCH

statement error
FROM GRAPH_TABLE (mg MATCH p = (a:Tag)-[:HasParent]->(b:Tag) COLUMNS (vertex_property(p, a.name)));
----
the property name must be a string literal

statement error
FROM GRAPH_TABLE (mg MATCH p = (a:Tag)-[:HasParent]->(b:Tag) COLUMNS (edge_property(p, 'title')));
----
no edge table of property graph 'mg' has a property 'title'

statement error
FROM GRAPH_TABLE (mg MATCH p = (a:Tag)-[:HasParent]->(b:Tag) COLUMNS (a.*, vertex_property(p, 'name')));
----
COLUMNS with x.* cannot be combined with vertex_property / edge_property

statement error
FROM GRAPH_TABLE (mg MATCH p = (a:Tag)-[:HasParent]->(b:Tag) COLUMNS (vertex_property(p)));
----
takes a path variable and a property name

# An artifact holds keys; a key that names two vertices cannot be looked up, and says so instead of answering
statement ok
CREATE TABLE dnode(id INTEGER, name VARCHAR);

statement ok
INSERT INTO dnode VALUES (1, 'a'), (2, 'b'), (3, 'c');

statement ok
CREATE TABLE dparent(src INTEGER, dst INTEGER);

statement ok
INSERT INTO dparent VALUES (2, 1), (3, 2);

statement ok
CREATE PROPERTY GRAPH dg VERTEX TABLES (dnode LABEL DNode)
EDGE TABLES (dparent SOURCE KEY (src) REFERENCES dnode (id) DESTINATION KEY (dst) REFERENCES dnode (id) LABEL DParent);

statement ok
FROM pgq_abi_build('dg', exclude_self_referential := false, closures := ['DParent']);

query IT rowsort
FROM GRAPH_TABLE (dg MATCH p = (a:DNode)-[:DParent]->{1,2}(b:DNode) COLUMNS (a.id, vertex_property(p, 'name') AS n));
----
2	[b, a]
3	[c, b, a]
3	[c, b]

statement ok
INSERT INTO dnode VALUES (2, 'b-again');

statement error
FROM GRAPH_TABLE (dg MATCH p = (a:DNode)-[:DParent]->{1,2}(b:DNode) COLUMNS (a.id, vertex_property(p, 'name') AS n));
----
a vertex key on the path matches several vertices
