# name: test/sql/path_finding/path_properties.test
# description: vertex_property(p, 'x') / edge_property(p, 'x'): a property of every vertex / edge of a matched path,
#              in path order, for aggregation along the path (list_sum, list_avg, list_min, list_max, len). Checked
#              against brute-force walks, and traversed against answered from ABI artifacts.
# group: [path_finding]

require duckpgq

statement ok
SET active_grammar_extensions = ['duckpgq'];

statement ok
CREATE TABLE tag(id INTEGER PRIMARY KEY, name VARCHAR, prio INTEGER);

# A diamond (1 -> 2 -> 3 and 1 -> 5 -> 3) and a second root (4)
statement ok
INSERT INTO tag VALUES (1, 'Pump A', 3), (2, 'Area', 2), (3, 'Plant', 1), (4, 'Valve', 5), (5, 'Line', NULL);

statement ok
