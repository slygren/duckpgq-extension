    (SELECT count(*) FROM ((SELECT src, cur, unnest(path) FROM (SELECT * FROM ref_paths WHERE dir = '->' AND depth BETWEEN 1 AND 3 AND src = 1)) EXCEPT ALL (SELECT a, b, v FROM GRAPH_TABLE (g MATCH (a:P)-[:K]->{1,3}(b:P) ONE ROW PER VERTEX (v) WHERE a.id = 1 COLUMNS (a.id AS a, b.id AS b, v.id AS v)))));
