    (SELECT count(*) FROM ((SELECT a, b, l FROM GRAPH_TABLE (g MATCH p = TRAIL (a:P)-[:K]->{1,3}(b:P) WHERE a.id = (SELECT 1) COLUMNS (a.id AS a, b.id AS b, path_length(p) AS l))) EXCEPT ALL (SELECT src, cur, depth FROM ref_paths WHERE dir = '->' AND src = 1))),
    (SELECT count(*) FROM ((SELECT src, cur, depth FROM ref_paths WHERE dir = '->' AND src = 1) EXCEPT ALL (SELECT a, b, l FROM GRAPH_TABLE (g MATCH p = TRAIL (a:P)-[:K]->{1,3}(b:P) WHERE a.id = (SELECT 1) COLUMNS (a.id AS a, b.id AS b, path_length(p) AS l)))));
