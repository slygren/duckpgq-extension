    (SELECT count(*) FROM ((SELECT src, cur, path[i], path[i + 1] FROM (SELECT *, unnest(range(1, depth + 1)) AS i FROM (SELECT * FROM ref_paths WHERE dir = '->' AND depth BETWEEN 1 AND 3 AND src = 1))) EXCEPT ALL (SELECT a, b, x, y FROM GRAPH_TABLE (g MATCH (a:P)-[:K]->{1,3}(b:P) ONE ROW PER STEP (v1, e, v2) WHERE a.id = 1 COLUMNS (a.id AS a, b.id AS b, v1.id AS x, v2.id AS y)))));
