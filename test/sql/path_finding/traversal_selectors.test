    (SELECT count(*) FROM ((SELECT src, cur, depth FROM ref_paths WHERE dir = '->' AND src = 1) EXCEPT ALL (SELECT a, b, l FROM GRAPH_TABLE (g MATCH p = SIMPLE (a:P)-[:K]->{1,3}(b:P) WHERE a.id = (SELECT 1) COLUMNS (a.id AS a, b.id AS b, path_length(p) AS l)))));
----
true	0	0

query III
SELECT (SELECT count(*) FROM (SELECT a, b, l FROM GRAPH_TABLE (g MATCH p = ANY SHORTEST SIMPLE (a:P)-[:K]->{1,3}(b:P) WHERE a.id = (SELECT 1) COLUMNS (a.id AS a, b.id AS b, path_length(p) AS l)))) = (SELECT count(*) FROM (SELECT src, cur, min(depth) FROM ref_paths WHERE dir = '->' AND src = 1 GROUP BY ALL)),
    (SELECT count(*) FROM ((SELECT a, b, l FROM GRAPH_TABLE (g MATCH p = ANY SHORTEST SIMPLE (a:P)-[:K]->{1,3}(b:P) WHERE a.id = (SELECT 1) COLUMNS (a.id AS a, b.id AS b, path_length(p) AS l))) EXCEPT ALL (SELECT src, cur, min(depth) FROM ref_paths WHERE dir = '->' AND src = 1 GROUP BY ALL))),
    (SELECT count(*) FROM ((SELECT src, cur, min(depth) FROM ref_paths WHERE dir = '->' AND src = 1 GROUP BY ALL) EXCEPT ALL (SELECT a, b, l FROM GRAPH_TABLE (g MATCH p = ANY SHORTEST SIMPLE (a:P)-[:K]->{1,3}(b:P) WHERE a.id = (SELECT 1) COLUMNS (a.id AS a, b.id AS b, path_length(p) AS l)))));
----
true	0	0

query III
SELECT (SELECT count(*) FROM (SELECT a, b, v FROM GRAPH_TABLE (g MATCH SIMPLE (a:P)-[:K]->{1,3}(b:P) ONE ROW PER VERTEX (v) WHERE a.id = 1 COLUMNS (a.id AS a, b.id AS b, v.id AS v)))) = (SELECT count(*) FROM (SELECT src, cur, unnest(path) FROM ref_paths WHERE dir = '->' AND src = 1)),
    (SELECT count(*) FROM ((SELECT a, b, v FROM GRAPH_TABLE (g MATCH SIMPLE (a:P)-[:K]->{1,3}(b:P) ONE ROW PER VERTEX (v) WHERE a.id = 1 COLUMNS (a.id AS a, b.id AS b, v.id AS v))) EXCEPT ALL (SELECT src, cur, unnest(path) FROM ref_paths WHERE dir = '->' AND src = 1))),
    (SELECT count(*) FROM ((SELECT src, cur, unnest(path) FROM ref_paths WHERE dir = '->' AND src = 1) EXCEPT ALL (SELECT a, b, v FROM GRAPH_TABLE (g MATCH SIMPLE (a:P)-[:K]->{1,3}(b:P) ONE ROW PER VERTEX (v) WHERE a.id = 1 COLUMNS (a.id AS a, b.id AS b, v.id AS v)))));
----
true	0	0

# A statement with several CSR traversals (here three, on the CSR route: ANY SHORTEST named paths from depth
# 1). Each builds its own CSR; the path functions used to read the registry without its lock while another
# CSR of the statement was being inserted, and failed intermittently with "Invalid ID".
query III
SELECT (SELECT count(*) FROM GRAPH_TABLE (g MATCH p = ANY SHORTEST (a:P)-[:K]->{1,3}(b:P) COLUMNS (path_length(p) AS l))) =
           (SELECT count(DISTINCT (src, cur)) FROM ref_paths WHERE dir = '->'),
       (SELECT count(*) FROM GRAPH_TABLE (g MATCH p = ANY SHORTEST (a:P)-[:K]-{1,3}(b:P) COLUMNS (path_length(p) AS l))) =
           (SELECT count(DISTINCT (src, cur)) FROM ref_paths WHERE dir = '-'),
       (SELECT count(*) FROM GRAPH_TABLE (g MATCH p = ALL SHORTEST (a:P)-[:K]->{1,3}(b:P) COLUMNS (path_length(p) AS l))) =
           (SELECT count(*) FROM (SELECT * FROM ref_paths WHERE dir = '->' QUALIFY depth = min(depth) OVER (PARTITION BY src, cur)));
----
true	true	true

# With artifacts built the answers agree with the traversal. (On this graph, with a duplicate edge and a cycle,
# some shapes have no exact artifact and are traversed both ways: 'unverified'.)
statement ok
SET pgq_disable_abi_rewrite = false;

statement ok
FROM pgq_abi_build('g', exclude_self_referential := false, closures := ['K']);

query T
SELECT status IN ('match', 'unverified') FROM pgq_verify_abi_rewrite('FROM GRAPH_TABLE (g MATCH ALL SHORTEST (a:P)-[:K]->{1,3}(b) COLUMNS (a.id AS a, b.id AS b))');
----
true

query T
SELECT status IN ('match', 'unverified') FROM pgq_verify_abi_rewrite('FROM GRAPH_TABLE (g MATCH p = ANY SHORTEST (a:P)-[:K]->{1,3}(b) WHERE a.id = 1 COLUMNS (a.id AS a, path_length(p) AS l))');
----
true

query T
SELECT status IN ('match', 'unverified') FROM pgq_verify_abi_rewrite('FROM GRAPH_TABLE (g MATCH ANY SHORTEST (a:P)-[:K]->{1,3}(b:P) COLUMNS (a.id AS a, b.id AS b))');
----
true

query T
SELECT status IN ('match', 'unverified') FROM pgq_verify_abi_rewrite('FROM GRAPH_TABLE (g MATCH p = (a:P)-[:K]->{1,3}(b) COLUMNS (a.id AS a, path_length(p) AS l, edge_labels(p) AS el))');
----
true
