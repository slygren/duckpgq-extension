# ALL SHORTEST from one seed: every shortest path, in the same order
query ITT
FROM GRAPH_TABLE (g MATCH p = ALL SHORTEST (a:P)-[:K]->+(b:P) WHERE a.id = 1 AND b.id IN (6, 9, 13) COLUMNS (b.id AS b, vertices(p) AS vs, edges(p) AS es)) ORDER BY ALL;
----
6	[0, 3, 5]	[37, 22]
9	[0, 3, 6, 8]	[37, 38, 25]
13	[0, 3, 6, 9, 12]	[37, 38, 39, 40]

# Tree, from a leaf: the path to every ancestor
query IIT
FROM GRAPH_TABLE (h MATCH p = ANY SHORTEST (t:T)-[:H]->+(x:T) WHERE t.id = 4999 COLUMNS (x.id AS x, path_length(p) AS l, vertices(p) AS vs)) ORDER BY ALL;
----
0	6	[4999, 1249, 312, 77, 19, 4, 0]
4	5	[4999, 1249, 312, 77, 19, 4]
19	4	[4999, 1249, 312, 77, 19]
77	3	[4999, 1249, 312, 77]
312	2	[4999, 1249, 312]
1249	1	[4999, 1249]

# Tree, from the root backwards: every vertex
query III
SELECT count(*), sum(l), max(l) FROM GRAPH_TABLE (h MATCH p = ANY SHORTEST (t:T)<-[:H]-+(x:T) WHERE t.id = 0 COLUMNS (x.id AS x, path_length(p) AS l));
----
4999	28182	6

# Tree, two seeds on different sides
query III
SELECT t, count(*), sum(l) FROM GRAPH_TABLE (h MATCH p = ANY SHORTEST (t:T)<-[:H]-+(x:T) WHERE t.id IN (1, 2) COLUMNS (t.id AS t, x.id AS x, path_length(p) AS l)) GROUP BY t ORDER BY ALL;
----
1	1364	6372
2	1364	6372
