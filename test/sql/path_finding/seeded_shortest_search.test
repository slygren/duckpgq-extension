query IT
FROM GRAPH_TABLE (g MATCH p = ANY SHORTEST (a:P)<-[:K]-+(b:P) WHERE a.id = 17 COLUMNS (b.id AS b, vertices(p) AS vs)) ORDER BY ALL;
