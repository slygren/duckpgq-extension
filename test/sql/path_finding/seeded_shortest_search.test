# Every source: more distinct sources per chunk than are searched one by one
query III
SELECT count(*), sum(l), sum(hash(vs)) FROM GRAPH_TABLE (g MATCH p = ANY SHORTEST (a:P)-[:K]->+(b:P) COLUMNS (a.id AS a, b.id AS b, path_length(p) AS l, vertices(p) AS vs));
----
380	1725	3474189566818772286650

