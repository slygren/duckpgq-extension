# name: test/sql/path_finding/seeded_shortest_search.test
# description: The path functions search once per source and reuse it for every row of that source (a seeded
#              pattern pairs its seed with every candidate destination); the answers, ties included, are those of
#              the per-row search (expected rows from the build before the change)
# group: [path_finding]

require duckpgq

statement ok
SET active_grammar_extensions = ['duckpgq'];

statement ok
CREATE TABLE P AS SELECT i AS id FROM range(1, 21) t(i);

statement ok
CREATE TABLE K(src BIGINT, dst BIGINT);

statement ok
INSERT INTO K SELECT i, i + 1 FROM range(1, 20) t(i) UNION ALL SELECT i, i + 2 FROM range(1, 19) t(i) UNION ALL SELECT i, i + 3 FROM range(1, 18, 3) t(i) UNION ALL SELECT 5, 6 UNION ALL SELECT 20, 1;

statement ok
CREATE PROPERTY GRAPH g VERTEX TABLES (P LABEL P) EDGE TABLES (K SOURCE KEY (src) REFERENCES P (id) DESTINATION KEY (dst) REFERENCES P (id) LABEL K);

statement ok
CREATE TABLE T AS SELECT i AS id FROM range(5000) t(i);

statement ok
CREATE TABLE H AS SELECT i AS child, (i - 1) // 4 AS parent FROM range(1, 5000) t(i);

statement ok
CREATE PROPERTY GRAPH h VERTEX TABLES (T LABEL T) EDGE TABLES (H SOURCE KEY (child) REFERENCES T (id) DESTINATION KEY (parent) REFERENCES T (id) LABEL H);

# One seed: every destination's shortest path, the same one among ties as before
query IITT
FROM GRAPH_TABLE (g MATCH p = ANY SHORTEST (a:P)-[:K]->+(b:P) WHERE a.id = 1 COLUMNS (b.id AS b, path_length(p) AS l, vertices(p) AS vs, edges(p) AS es)) ORDER BY ALL;
----
2	1	[0, 1]	[0]
3	1	[0, 2]	[19]
4	1	[0, 3]	[37]
5	2	[0, 2, 4]	[19, 21]
6	2	[0, 3, 5]	[37, 22]
7	2	[0, 3, 6]	[37, 38]
8	3	[0, 3, 5, 7]	[37, 22, 24]
9	3	[0, 3, 6, 8]	[37, 38, 25]
10	3	[0, 3, 6, 9]	[37, 38, 39]
11	4	[0, 3, 6, 8, 10]	[37, 38, 25, 27]
12	4	[0, 3, 6, 9, 11]	[37, 38, 39, 28]
13	4	[0, 3, 6, 9, 12]	[37, 38, 39, 40]
14	5	[0, 3, 6, 9, 11, 13]	[37, 38, 39, 28, 30]
15	5	[0, 3, 6, 9, 12, 14]	[37, 38, 39, 40, 31]
16	5	[0, 3, 6, 9, 12, 15]	[37, 38, 39, 40, 41]
17	6	[0, 3, 6, 9, 12, 14, 16]	[37, 38, 39, 40, 31, 33]
18	6	[0, 3, 6, 9, 12, 15, 17]	[37, 38, 39, 40, 41, 34]
19	6	[0, 3, 6, 9, 12, 15, 18]	[37, 38, 39, 40, 41, 42]
20	7	[0, 3, 6, 9, 12, 15, 17, 19]	[37, 38, 39, 40, 41, 34, 36]

