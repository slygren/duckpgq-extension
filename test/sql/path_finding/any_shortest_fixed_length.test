# name: test/sql/path_finding/any_shortest_fixed_length.test
# description: ANY SHORTEST over a fixed-length pattern ({1,1}, a plain edge, several fixed hops) returns one path per
#              pair of endpoints, in every direction; it returned one row per parallel edge (the selector was
#              ignored). ALL SHORTEST keeps every path. Brute force over the edge table; traversed and with ABI
#              artifacts built (the selection reads every element, so it traverses either way).
# group: [path_finding]

require duckpgq

load __TEST_DIR__/any_shortest_fixed_length.db

statement ok
SET active_grammar_extensions = ['duckpgq'];

statement ok
CREATE TABLE P(id BIGINT, name VARCHAR);

statement ok
INSERT INTO P VALUES (1, 'a'), (2, 'b'), (3, 'c'), (4, 'd');

# Parallel edges 1->2 (three of them) and 2->3 (two), a reciprocal pair 1<->2, a self-loop on 3, an edge to a missing
# vertex
statement ok
CREATE TABLE K(src BIGINT, dst BIGINT);

statement ok
INSERT INTO K VALUES (1, 2), (1, 2), (2, 1), (2, 3), (3, 3), (1, 2), (2, 3), (3, 4), (4, 9);

statement ok
CREATE PROPERTY GRAPH g VERTEX TABLES (P LABEL P)
EDGE TABLES (K SOURCE KEY (src) REFERENCES P (id) DESTINATION KEY (dst) REFERENCES P (id) LABEL K);

statement ok
CREATE TABLE ke AS SELECT k.rowid AS r, src, dst FROM K k WHERE src IN (SELECT id FROM P) AND dst IN (SELECT id FROM P);

statement ok
CREATE TABLE ref_right AS SELECT DISTINCT src AS a, dst AS b FROM ke;

statement ok
CREATE TABLE ref_left AS SELECT DISTINCT dst AS a, src AS b FROM ke;

statement ok
CREATE TABLE ref_any AS FROM ref_right UNION FROM ref_left;

statement ok
CREATE TABLE ref_two AS SELECT DISTINCT x.src AS a, y.dst AS b FROM ke x JOIN ke y ON y.src = x.dst;

statement ok
CREATE TABLE ref_two_walks AS SELECT x.src AS a, y.dst AS b FROM ke x JOIN ke y ON y.src = x.dst;

statement ok
SET pgq_disable_abi_rewrite = true;

# traversed: right plain
query II
SELECT (SELECT count(*) FROM ((SELECT a, b FROM GRAPH_TABLE (g MATCH ANY SHORTEST (a:P)-[e:K]->(b:P) COLUMNS (a.id AS a, b.id AS b)) EXCEPT ALL FROM ref_right)
                              UNION ALL (FROM ref_right EXCEPT ALL SELECT a, b FROM GRAPH_TABLE (g MATCH ANY SHORTEST (a:P)-[e:K]->(b:P) COLUMNS (a.id AS a, b.id AS b))))),
       (SELECT count(*) FROM ref_right);
----
0	5

# traversed: right {1,1}
query II
SELECT (SELECT count(*) FROM ((SELECT a, b FROM GRAPH_TABLE (g MATCH ANY SHORTEST (a:P)-[e:K]->{1,1}(b:P) COLUMNS (a.id AS a, b.id AS b)) EXCEPT ALL FROM ref_right)
                              UNION ALL (FROM ref_right EXCEPT ALL SELECT a, b FROM GRAPH_TABLE (g MATCH ANY SHORTEST (a:P)-[e:K]->{1,1}(b:P) COLUMNS (a.id AS a, b.id AS b))))),
       (SELECT count(*) FROM ref_right);
----
0	5

