                              UNION ALL (FROM ref_right EXCEPT ALL SELECT a, b FROM GRAPH_TABLE (g MATCH p = ANY SHORTEST (a:P)-[e:K]->{1,1}(b:P) COLUMNS (a.id AS a, b.id AS b))))),
