                              UNION ALL (FROM ref_two EXCEPT ALL SELECT a, b FROM GRAPH_TABLE (g MATCH ANY SHORTEST (a:P)-[e:K]->{1,1}(m:P)-[f:K]->{1,1}(b:P) COLUMNS (a.id AS a, b.id AS b))))),
