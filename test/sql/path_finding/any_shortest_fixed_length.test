# A pattern mixing fixed hops with a variable-length one: the shortest paths of the whole pattern, per pair of
# endpoints. (On a DAG, where the variable-length part's paths are all walks.)
statement ok
SET pgq_disable_abi_rewrite = true;

statement ok
CREATE TABLE D(src BIGINT, dst BIGINT);

statement ok
INSERT INTO D VALUES (1, 2), (1, 3), (2, 3), (3, 4), (2, 4), (1, 4), (4, 5), (3, 5), (2, 5);

statement ok
CREATE PROPERTY GRAPH dg VERTEX TABLES (P LABEL P)
EDGE TABLES (D SOURCE KEY (src) REFERENCES P (id) DESTINATION KEY (dst) REFERENCES P (id) LABEL D);

statement ok
INSERT INTO P VALUES (5, 'e');

# walks: one fixed hop, then 1..2 hops
statement ok
CREATE TABLE mixed_walks AS
SELECT x.src AS a, y.dst AS b, 2 AS l FROM D x JOIN D y ON y.src = x.dst
UNION ALL
SELECT x.src, z.dst, 3 FROM D x JOIN D y ON y.src = x.dst JOIN D z ON z.src = y.dst;

statement ok
CREATE TABLE mixed_ref AS SELECT a, b, min(l) AS l FROM mixed_walks GROUP BY a, b;

statement ok
CREATE TABLE mixed_all_ref AS SELECT w.a, w.b, w.l, count(*) AS paths FROM mixed_walks w JOIN mixed_ref r USING (a, b, l) GROUP BY ALL;

query I
SELECT count(*) FROM (
  (SELECT a, b, l FROM GRAPH_TABLE (dg MATCH p = ANY SHORTEST (a:P)-[e:D]->(m:P)-[f:D]->{1,2}(b:P)
                                    COLUMNS (a.id AS a, b.id AS b, path_length(p) AS l)) EXCEPT ALL FROM mixed_ref)
  UNION ALL
  (FROM mixed_ref EXCEPT ALL SELECT a, b, l FROM GRAPH_TABLE (dg MATCH p = ANY SHORTEST (a:P)-[e:D]->(m:P)-[f:D]->{1,2}(b:P)
                                                               COLUMNS (a.id AS a, b.id AS b, path_length(p) AS l))));
----
0

# unnamed, and the variable-length part first
query I
SELECT count(*) FROM (
  (SELECT a, b FROM GRAPH_TABLE (dg MATCH ANY SHORTEST (a:P)-[e:D]->(m:P)-[f:D]->{1,2}(b:P) COLUMNS (a.id AS a, b.id AS b))
   EXCEPT ALL SELECT a, b FROM mixed_ref)
  UNION ALL
  (SELECT a, b FROM mixed_ref
   EXCEPT ALL SELECT a, b FROM GRAPH_TABLE (dg MATCH ANY SHORTEST (a:P)-[f:D]->{1,2}(m:P)-[e:D]->(b:P) COLUMNS (a.id AS a, b.id AS b))));
----
0

query I
SELECT count(*) FROM (
  (SELECT a, b, l, count(*) FROM GRAPH_TABLE (dg MATCH p = ALL SHORTEST (a:P)-[e:D]->(m:P)-[f:D]->{1,2}(b:P)
                                              COLUMNS (a.id AS a, b.id AS b, path_length(p) AS l)) GROUP BY ALL
   EXCEPT ALL FROM mixed_all_ref)
  UNION ALL
  (FROM mixed_all_ref
   EXCEPT ALL SELECT a, b, l, count(*) FROM GRAPH_TABLE (dg MATCH p = ALL SHORTEST (a:P)-[e:D]->(m:P)-[f:D]->{1,2}(b:P)
                                                         COLUMNS (a.id AS a, b.id AS b, path_length(p) AS l)) GROUP BY ALL));
----
0

# Next to another pattern, or with ONE ROW PER, the rows are not the pattern's paths alone: refused
statement error
FROM GRAPH_TABLE (dg MATCH ANY SHORTEST (a:P)-[e:D]->(m:P)-[f:D]->{1,2}(b:P), (b)-[:D]->(c:P) COLUMNS (a.id, b.id));
----
supported when it is the only pattern of its MATCH
