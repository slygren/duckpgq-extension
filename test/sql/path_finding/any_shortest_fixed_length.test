# traversed: the path chosen is one of the pair's edges, the first by row id
query I
SELECT count(*) FROM GRAPH_TABLE (g MATCH p = ANY SHORTEST (a:P)-[e:K]->{1,1}(b:P)
                                  COLUMNS (a.id AS a, b.id AS b, path_length(p) AS l, edges(p) AS es)) t
WHERE l <> 1 OR es[1] <> (SELECT min(r) FROM ke WHERE src = t.a AND dst = t.b);
----
0

# traversed: ALL SHORTEST keeps every parallel edge and every two-hop walk
query II
SELECT (SELECT count(*) FROM GRAPH_TABLE (g MATCH ALL SHORTEST (a:P)-[e:K]->{1,1}(b:P) COLUMNS (a.id))),
       (SELECT count(*) FROM GRAPH_TABLE (g MATCH ALL SHORTEST (a:P)-[e:K]->(m:P)-[f:K]->(b:P) COLUMNS (a.id)));
----
8	18

# traversed: seeded, and with a predicate on the interior vertex (applied among the tied paths)
query II
SELECT a, b FROM GRAPH_TABLE (g MATCH ANY SHORTEST (a:P)-[e:K]->(m:P)-[f:K]->(b:P) WHERE a.id = 1 AND m.name = 'b'
                              COLUMNS (a.id AS a, b.id AS b)) ORDER BY ALL;
----
1	1
1	3

# traversed: another pattern meeting it at an endpoint multiplies the rows, one path per pair each time
query I
SELECT count(*) FROM GRAPH_TABLE (g MATCH ANY SHORTEST (a:P)-[e:K]->{1,1}(b:P), (b)-[f:K]->(c:P) COLUMNS (a.id, b.id, c.id));
----
10

