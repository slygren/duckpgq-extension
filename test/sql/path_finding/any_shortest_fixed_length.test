                              UNION ALL (FROM ref_two EXCEPT ALL SELECT a, b FROM GRAPH_TABLE (g MATCH ANY SHORTEST (a:P)-[e:K]->(m:P)-[f:K]->(b:P) COLUMNS (a.id AS a, b.id AS b))))),
