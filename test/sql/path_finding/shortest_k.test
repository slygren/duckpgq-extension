statement ok
CREATE OR REPLACE TABLE ref AS SELECT src AS a, cur AS b, vs, es FROM ref_walks
WHERE dir = '->' AND mode = 'WALK' AND depth BETWEEN 1 AND 7 
QUALIFY row_number() OVER (PARTITION BY src, cur ORDER BY depth, es) <= 2;

statement ok
CREATE OR REPLACE TABLE named AS SELECT a, b, list_transform(vs0, lambda x: x + 1) AS vs, es FROM GRAPH_TABLE (g
    MATCH p = SHORTEST 2 (a:P)-[e:K]->+(b:P)  COLUMNS (a.id AS a, b.id AS b, vertices(p) AS vs0, edges(p) AS es));

query IIII
