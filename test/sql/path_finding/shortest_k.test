WHERE dir = '<-' AND mode = 'SIMPLE' AND depth BETWEEN 1 AND 7 
QUALIFY row_number() OVER (PARTITION BY src, cur ORDER BY depth, es) <= 2;

statement ok
CREATE OR REPLACE TABLE named AS SELECT a, b, list_transform(vs0, lambda x: x + 1) AS vs, es FROM GRAPH_TABLE (g
    MATCH p = SHORTEST 2 SIMPLE (a:P)<-[e:K]-+(b:P)  COLUMNS (a.id AS a, b.id AS b, vertices(p) AS vs0, edges(p) AS es));

query IIII
SELECT (SELECT count(*) FROM ref) = (SELECT count(*) FROM named), (SELECT coalesce(max(len(es)), 0) < 7 FROM ref),
    (SELECT count(*) FROM (FROM named EXCEPT ALL FROM ref)), (SELECT count(*) FROM (FROM ref EXCEPT ALL FROM named));
----
true	true	0	0

statement ok
CREATE OR REPLACE TABLE orp AS SELECT * FROM GRAPH_TABLE (g MATCH SHORTEST 2 SIMPLE (a:P)<-[e:K]-+(b:P) ONE ROW PER STEP (v1, x, v2) 
    COLUMNS (a.id AS a, b.id AS b, v1.id AS v1, x.rowid AS x, v2.id AS v2));

statement ok
CREATE OR REPLACE TABLE orp_ref AS SELECT a, b, vs[i], es[i], vs[i + 1] FROM (SELECT *, unnest(range(1, len(es) + 1)) AS i FROM named);

statement ok
CREATE OR REPLACE TABLE unnamed AS SELECT * FROM GRAPH_TABLE (g MATCH SHORTEST 2 SIMPLE (a:P)<-[e:K]-+(b:P)  COLUMNS (a.id AS a, b.id AS b));

query IIII
SELECT (SELECT count(*) FROM (FROM orp EXCEPT ALL FROM orp_ref)), (SELECT count(*) FROM (FROM orp_ref EXCEPT ALL FROM orp)),
    (SELECT count(*) FROM (FROM unnamed EXCEPT ALL SELECT a, b FROM named)), (SELECT count(*) FROM (SELECT a, b FROM named EXCEPT ALL FROM unnamed));
----
0	0	0	0

