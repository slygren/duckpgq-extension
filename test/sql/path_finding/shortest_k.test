----
true	true	0	0

# SHORTEST 2 SIMPLE (a:P)<-[e:K]->{3,}(b:P) 
statement ok
CREATE OR REPLACE TABLE ref AS SELECT src AS a, cur AS b, vs, es FROM ref_walks
WHERE dir = '<->' AND mode = 'SIMPLE' AND depth BETWEEN 3 AND 7 
QUALIFY row_number() OVER (PARTITION BY src, cur ORDER BY depth, es) <= 2;

statement ok
CREATE OR REPLACE TABLE named AS SELECT a, b, list_transform(vs0, lambda x: x + 1) AS vs, es FROM GRAPH_TABLE (g
    MATCH p = SHORTEST 2 SIMPLE (a:P)<-[e:K]->{3,}(b:P)  COLUMNS (a.id AS a, b.id AS b, vertices(p) AS vs0, edges(p) AS es));

query IIII
SELECT (SELECT count(*) FROM ref) = (SELECT count(*) FROM named), (SELECT coalesce(max(len(es)), 0) < 7 FROM ref),
    (SELECT count(*) FROM (FROM named EXCEPT ALL FROM ref)), (SELECT count(*) FROM (FROM ref EXCEPT ALL FROM named));
----
true	true	0	0

# Ties at the k-th length go to the smaller edge row ids along the path: from 1 to 2 the two parallel edges
# (row ids 0 and 1), then 1 -> 3 -> 2 (row ids 3, 9); a fourth is the first of the length-3 walks, 1 -> 2 -> 3 -> 2
# (row ids 0, 2, 9 before 0, 7, 0 of 1 -> 2 -> 1 -> 2)
query II
FROM GRAPH_TABLE (g MATCH p = SHORTEST 4 (a:P)-[e:K]->+(b:P) WHERE a.id = 1 AND b.id = 2 COLUMNS (path_length(p) AS l, edges(p) AS es))
ORDER BY ALL;
----
1	[0]
1	[1]
2	[3, 9]
3	[0, 2, 9]

# Under WALK a path may come back to its start; SHORTEST k WALK is the same as no mode
query II
FROM GRAPH_TABLE (g MATCH p = SHORTEST 2 WALK (a:P)-[e:K]->+(b:P) WHERE a.id = 6 COLUMNS (b.id AS b, edges(p) AS es))
ORDER BY ALL;
----
6	[10]
6	[10, 10]

# The source and destination filters seed the search; the search is reported
query I
SELECT count(*) FROM GRAPH_TABLE (g MATCH SHORTEST 1 (a:P)-[e:K]->+(b:P) WHERE a.name = 'a' AND b.name IN ('d', 'e') COLUMNS (b.id AS b));
----
2

query TT
SELECT rewrite_type, reason FROM pgq_last_rewrite_diagnostics() WHERE rewrite_type = 'path_search';
----
path_search	native path search: first 1 per pair, walk, steps 1..1073741824

# OPTIONAL MATCH with SHORTEST k: 7 has no path, 5 reaches nothing either
query II
FROM GRAPH_TABLE (g MATCH (t:P) OPTIONAL MATCH SHORTEST 1 (t)-[e:K]->+(x:P) WHERE t.id IN (5, 7) COLUMNS (t.id AS t, x.id AS x));
----
5	NULL
7	NULL

# ── The budget: every partial path the search builds counts against pgq_max_vl_fallback_rows ─────────────────────
statement ok
SET pgq_max_vl_fallback_rows = 40;

statement error
FROM GRAPH_TABLE (g MATCH SHORTEST 3 (a:P)-[e:K]-+(b:P) COLUMNS (a.id AS a, b.id AS b));
----
exceeding pgq_max_vl_fallback_rows (40)

# A seed limits the search: one source and one destination fit the same budget
query I
SELECT count(*) FROM GRAPH_TABLE (g MATCH SHORTEST 3 (a:P)-[e:K]-+(b:P) WHERE a.id = 1 AND b.id = 2 COLUMNS (a.id AS a));
----
3

# The path modes keep no per-vertex bound; the budget stops them as well
statement error
FROM GRAPH_TABLE (g MATCH TRAIL (a:P)-[e:K]-+(b:P) COLUMNS (a.id AS a, b.id AS b));
----
exceeding pgq_max_vl_fallback_rows (40)

statement ok
RESET pgq_max_vl_fallback_rows;

# ── Shapes the search does not take ───────────────────────────────────────────────────────────────────────────
statement error
FROM GRAPH_TABLE (g MATCH SHORTEST 2 (a:P)-[e:K]->+(b:P)-[f:K]->(c:P) COLUMNS (a.id AS a));
----
SHORTEST k is supported for one quantified edge between two vertices

statement error
FROM GRAPH_TABLE (g MATCH SHORTEST 0 (a:P)-[e:K]->+(b:P) COLUMNS (a.id AS a));
----
SHORTEST k requires a positive k

# ── With ABI artifacts: no artifact holds k paths per pair, so SHORTEST k never takes one ──────────────────────
statement ok
SET pgq_disable_abi_rewrite = false;

statement ok
SELECT count(*) FROM pgq_abi_build('g', exclude_self_referential := false, closures := ['K']);

query T
SELECT status FROM pgq_verify_abi_rewrite('FROM GRAPH_TABLE (g MATCH SHORTEST 2 (a:P)-[e:K]->+(b:P) WHERE a.id = 1 COLUMNS (a.id AS a, b.id AS b))');
----
unverified

query T
SELECT status IN ('match', 'unverified') FROM pgq_verify_abi_rewrite('FROM GRAPH_TABLE (g MATCH ACYCLIC (a:P)-[e:K]->+(b:P) WHERE a.id = 1 COLUMNS (a.id AS a, b.id AS b))');
----
true

statement ok
SET pgq_require_abi_paths = true;

statement error
FROM GRAPH_TABLE (g MATCH SHORTEST 2 (a:P)-[e:K]->+(b:P) WHERE a.id = 1 COLUMNS (a.id AS a, b.id AS b));
----
pgq_require_abi_paths

statement ok
SET pgq_require_abi_paths = false;
