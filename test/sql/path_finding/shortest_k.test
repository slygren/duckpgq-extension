    (SELECT count(*) FROM (FROM named EXCEPT ALL FROM ref)), (SELECT count(*) FROM (FROM ref EXCEPT ALL FROM named));
----
true	true	0	0

statement ok
CREATE OR REPLACE TABLE orp AS SELECT * FROM GRAPH_TABLE (g MATCH SHORTEST 2 (a:P)-[e:K]->+(b:P) ONE ROW PER STEP (v1, x, v2) 
    COLUMNS (a.id AS a, b.id AS b, v1.id AS v1, x.rowid AS x, v2.id AS v2));

statement ok
CREATE OR REPLACE TABLE orp_ref AS SELECT a, b, vs[i], es[i], vs[i + 1] FROM (SELECT *, unnest(range(1, len(es) + 1)) AS i FROM named);

statement ok
CREATE OR REPLACE TABLE unnamed AS SELECT * FROM GRAPH_TABLE (g MATCH SHORTEST 2 (a:P)-[e:K]->+(b:P)  COLUMNS (a.id AS a, b.id AS b));

query IIII
SELECT (SELECT count(*) FROM (FROM orp EXCEPT ALL FROM orp_ref)), (SELECT count(*) FROM (FROM orp_ref EXCEPT ALL FROM orp)),
    (SELECT count(*) FROM (FROM unnamed EXCEPT ALL SELECT a, b FROM named)), (SELECT count(*) FROM (SELECT a, b FROM named EXCEPT ALL FROM unnamed));
----
0	0	0	0

