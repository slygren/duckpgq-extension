    MATCH p = SHORTEST 1 TRAIL GROUPS (a:P)-[e:K]-{2,4}(b:P) WHERE a.id = 1 COLUMNS (a.id AS a, b.id AS b, vertices(p) AS vs0, edges(p) AS es));

query IIII
