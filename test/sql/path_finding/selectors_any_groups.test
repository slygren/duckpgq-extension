# ── SHORTEST 1 GROUP is ALL SHORTEST, and ANY k is SHORTEST k ────────────────────────────────────────────────
statement ok
CREATE OR REPLACE TABLE l AS SELECT a, b, vs, es FROM GRAPH_TABLE (g MATCH p = ALL SHORTEST (a:P)-[e:K]->{1,3}(b:P) WHERE a.id = 1
    COLUMNS (a.id AS a, b.id AS b, vertices(p) AS vs, edges(p) AS es));

statement ok
CREATE OR REPLACE TABLE r AS SELECT a, b, vs, es FROM GRAPH_TABLE (g MATCH p = SHORTEST 1 GROUP (a:P)-[e:K]->{1,3}(b:P) WHERE a.id = 1
    COLUMNS (a.id AS a, b.id AS b, vertices(p) AS vs, edges(p) AS es));

query III
SELECT (SELECT count(*) FROM l) > 0, (SELECT count(*) FROM (FROM l EXCEPT ALL FROM r)), (SELECT count(*) FROM (FROM r EXCEPT ALL FROM l));
