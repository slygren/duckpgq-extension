QUALIFY dense_rank() OVER (PARTITION BY src, cur ORDER BY depth) <= 2;

statement ok
CREATE OR REPLACE TABLE named AS SELECT a, b, list_transform(vs0, lambda x: x + 1) AS vs, es FROM GRAPH_TABLE (g
    MATCH p = SHORTEST 2 GROUPS (a:P)-[e:K]->{3,}(b:P) WHERE a.id = 1 COLUMNS (a.id AS a, b.id AS b, vertices(p) AS vs0, edges(p) AS es));

query IIII
SELECT (SELECT count(*) FROM ref) = (SELECT count(*) FROM named), (SELECT coalesce(max(len(es)), 0) < 7 FROM ref),
    (SELECT count(*) FROM (FROM named EXCEPT ALL FROM ref)), (SELECT count(*) FROM (FROM ref EXCEPT ALL FROM named));
----
true	true	0	0

