WHERE dir = '-' AND mode = 'ACYCLIC' AND depth BETWEEN 2 AND 6 AND src = 1
QUALIFY dense_rank() OVER (PARTITION BY src, cur ORDER BY depth) <= 1;

statement ok
CREATE OR REPLACE TABLE named AS SELECT a, b, list_transform(vs0, lambda x: x + 1) AS vs, es FROM GRAPH_TABLE (g
    MATCH p = SHORTEST 1 ACYCLIC GROUPS (a:P)-[e:K]-{2,6}(b:P) WHERE a.id = 1 COLUMNS (a.id AS a, b.id AS b, vertices(p) AS vs0, edges(p) AS es));

query IIII
