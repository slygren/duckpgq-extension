# name: test/sql/path_finding/selectors_any_groups.test
# description: The SQL/PGQ selectors ANY [k] and SHORTEST [k] GROUP(S), against a brute-force enumeration of walks.
#              SHORTEST k GROUPS is every path of the k shortest distinct lengths per endpoint pair (no choice among
#              paths, so the expected rows are exact). ANY k is k paths per pair; SQL/PGQ leaves which ones to the
#              implementation, and here they are the k that SHORTEST k returns (by length, then edge row ids along
#              the path). Walk semantics unless a path mode is given. SHORTEST 1 GROUP is ALL SHORTEST, on every
#              route ALL SHORTEST takes, with and without ABI artifacts. Generated by gen_selectors.py.
# group: [path_finding]

require duckpgq

statement ok
SET active_grammar_extensions = ['duckpgq'];

# 1 -> 2 (twice), 2 -> 3, 1 -> 3, 3 -> 4, 2 -> 4, 4 -> 1, 2 -> 1, 3 -> 5, 3 -> 2, 6 -> 6; 7 is isolated
statement ok
CREATE TABLE P(id BIGINT PRIMARY KEY, name VARCHAR);

statement ok
CREATE TABLE K(src BIGINT, dst BIGINT);

statement ok
INSERT INTO P VALUES (1, 'a'), (2, 'b'), (3, 'c'), (4, 'd'), (5, 'e'), (6, 'f'), (7, 'g');

statement ok
INSERT INTO K VALUES (1, 2), (1, 2), (2, 3), (1, 3), (3, 4), (2, 4), (4, 1), (2, 1), (3, 5), (3, 2), (6, 6);

statement ok
CREATE PROPERTY GRAPH g VERTEX TABLES (P LABEL P)
EDGE TABLES (K SOURCE KEY (src) REFERENCES P (id) DESTINATION KEY (dst) REFERENCES P (id) LABEL K);

# Every walk of up to 7 steps in each direction, with the path modes as SQL/PGQ defines them: TRAIL repeats no edge,
# ACYCLIC no vertex, SIMPLE no vertex except that it may end where it started.
statement ok
CREATE TABLE ref_walks AS
WITH RECURSIVE steps(dir, s, t, e) AS (
    SELECT '->', src, dst, rowid FROM K
    UNION ALL SELECT '<-', dst, src, rowid FROM K
    UNION ALL SELECT '-', src, dst, rowid FROM K
    UNION ALL SELECT '-', dst, src, rowid FROM K WHERE src <> dst),
w(dir, mode, src, cur, depth, vs, es) AS (
    SELECT d, m, id, id, 0, [id], []::BIGINT[] FROM P, (VALUES ('->'), ('<-'), ('-')) t(d),
        (VALUES ('WALK'), ('TRAIL'), ('ACYCLIC'), ('SIMPLE')) u(m)
    UNION ALL
    SELECT w.dir, w.mode, w.src, steps.t, w.depth + 1, list_append(w.vs, steps.t), list_append(w.es, steps.e)
    FROM w JOIN steps ON steps.dir = w.dir AND steps.s = w.cur
    WHERE w.depth < 7
      AND (w.mode <> 'TRAIL' OR NOT list_contains(w.es, steps.e))
      AND (w.mode <> 'ACYCLIC' OR NOT list_contains(w.vs, steps.t))
      AND (w.mode <> 'SIMPLE' OR ((NOT list_contains(w.vs, steps.t) OR steps.t = w.src) AND (w.depth = 0 OR w.cur <> w.src))))
SELECT * FROM w;

statement ok
SET pgq_disable_abi_rewrite = true;

# SHORTEST 1 GROUPS (a:P)-[e:K]->{1,3}(b:P) WHERE a.id = 1
statement ok
CREATE OR REPLACE TABLE ref AS SELECT src AS a, cur AS b, vs, es FROM ref_walks
WHERE dir = '->' AND mode = 'WALK' AND depth BETWEEN 1 AND 3 AND src = 1
QUALIFY dense_rank() OVER (PARTITION BY src, cur ORDER BY depth) <= 1;

statement ok
CREATE OR REPLACE TABLE named AS SELECT a, b, list_transform(vs0, lambda x: x + 1) AS vs, es FROM GRAPH_TABLE (g
    MATCH p = SHORTEST 1 GROUPS (a:P)-[e:K]->{1,3}(b:P) WHERE a.id = 1 COLUMNS (a.id AS a, b.id AS b, vertices(p) AS vs0, edges(p) AS es));

query IIII
SELECT (SELECT count(*) FROM ref) = (SELECT count(*) FROM named), (SELECT coalesce(max(len(es)), 0) < 7 FROM ref),
    (SELECT count(*) FROM (FROM named EXCEPT ALL FROM ref)), (SELECT count(*) FROM (FROM ref EXCEPT ALL FROM named));
----
true	true	0	0

