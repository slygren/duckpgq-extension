# name: test/sql/path_finding/optional_match_bidirectional.test
# description: OPTIONAL MATCH with a bidirectional edge (<-[e]->): an edge in either direction (SQL/PGQ), LEFT JOIN semantics
# group: [path_finding]

require duckpgq


statement ok
SET active_grammar_extensions = ['duckpgq'];

statement ok
CREATE TABLE Person(id BIGINT, name VARCHAR);

statement ok
CREATE TABLE Knows(src BIGINT, dst BIGINT);

statement ok
INSERT INTO Person VALUES (0,'A'),(1,'B'),(2,'C'),(3,'D');

# A<->B reciprocal; A->C one-way; D isolated.
statement ok
INSERT INTO Knows VALUES (0,1),(1,0),(0,2);

statement ok
CREATE PROPERTY GRAPH bg
VERTEX TABLES (
    Person PROPERTIES (id, name) LABEL Person
)
EDGE TABLES (
    Knows SOURCE KEY (src) REFERENCES Person (id)
          DESTINATION KEY (dst) REFERENCES Person (id)
          LABEL Knows
);

# Bidirectional is either direction (SQL/PGQ, the same as -[k]-): A has B twice (an edge each way) and C;
# B has A twice; C has A (A -> C read backwards); D is isolated and keeps its NULL row.
query TT
FROM GRAPH_TABLE (bg
    MATCH (p:Person)
    OPTIONAL MATCH (p)<-[k:Knows]->(o:Person)
    COLUMNS (p.name AS p, o.name AS o)
    ) r ORDER BY 1, 2;
----
A	B
A	B
A	C
B	A
B	A
C	A
D	NULL

# Directed contrast: -> follows only the stored direction, so C has no match.
query TT
FROM GRAPH_TABLE (bg
    MATCH (p:Person)
    OPTIONAL MATCH (p)-[k:Knows]->(o:Person)
    COLUMNS (p.name AS p, o.name AS o)
    ) r ORDER BY 1, 2;
----
A	B
A	C
B	A
C	NULL
D	NULL

statement ok
DROP PROPERTY GRAPH bg;
