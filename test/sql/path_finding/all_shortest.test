# name: test/sql/path_finding/all_shortest.test
# description: ALL SHORTEST returns one row per shortest path; multiple rows when multiple shortest paths exist
# group: [path_finding]

require duckpgq

# Diamond graph: A→B→D and A→C→D give two shortest paths of length 2
statement ok
CREATE TABLE V(id BIGINT, name VARCHAR);

statement ok
CREATE TABLE E(src BIGINT, dst BIGINT);

statement ok
INSERT INTO V VALUES (0,'A'),(1,'B'),(2,'C'),(3,'D');

statement ok
INSERT INTO E VALUES (0,1),(0,2),(1,3),(2,3);

statement ok
-CREATE PROPERTY GRAPH diamond
VERTEX TABLES (V PROPERTIES (id, name) LABEL V)
EDGE TABLES (E SOURCE KEY (src) REFERENCES V (id)
               DESTINATION KEY (dst) REFERENCES V (id)
               LABEL E);

# ALL SHORTEST from A to D returns two paths (A→B→D and A→C→D), both of length 2
query I
-SELECT path_length FROM GRAPH_TABLE (diamond
    MATCH p = ALL SHORTEST (a:V)-[e:E]->*(b:V)
    WHERE a.name = 'A' AND b.name = 'D'
    COLUMNS (path_length(p) as path_length)
    ) t ORDER BY 1;
----
2
2

# ANY SHORTEST from A to D returns exactly one path (length 2)
query I
-SELECT path_length FROM GRAPH_TABLE (diamond
    MATCH p = ANY SHORTEST (a:V)-[e:E]->*(b:V)
    WHERE a.name = 'A' AND b.name = 'D'
    COLUMNS (path_length(p) as path_length)
    ) t ORDER BY 1;
----
2

statement ok
-DROP PROPERTY GRAPH diamond;

statement ok
DROP TABLE E;

statement ok
DROP TABLE V;
