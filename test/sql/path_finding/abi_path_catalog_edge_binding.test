# name: test/sql/path_finding/abi_path_catalog_edge_binding.test
# description: ABI path-table rewrites bind referenced edge variables back to their edge table
# group: [path_finding]

require duckpgq


statement ok
SET active_grammar_extensions = ['duckpgq'];

statement ok
CREATE TABLE person(id INTEGER, name VARCHAR);

statement ok
INSERT INTO person VALUES (1, 'Alice'), (2, 'Bob'), (3, 'Carol');

statement ok
CREATE TABLE knows(src INTEGER, dst INTEGER, since INTEGER);

statement ok
INSERT INTO knows VALUES (1, 2, 2020), (2, 3, 2021);

statement ok
CREATE SCHEMA graph;

statement ok
CREATE TABLE graph.__pg_test_graph__custom_edge AS
SELECT 2 AS v0, hash('synthetic') AS e1, 3 AS v1;

statement ok
CREATE TABLE graph.__pgq_path_catalog AS
SELECT
    'test_graph' AS graph_name,
    '__pg_test_graph__custom_edge' AS path_table_name,
    'edge' AS path_kind,
    1 AS hop_count,
    'Person' AS src_label,
    'Person' AS dst_label,
    'Person,Person' AS vertex_label_sequence,
    'Knows' AS edge_label_sequence,
    true AS supports_one_row_per_step,
    true AS is_deduplicated,
    (SELECT count(*) FROM graph.__pg_test_graph__custom_edge) AS estimated_rows,
    current_timestamp AS last_refreshed_at,
    true AS is_sorted_by_v0,
    1 AS min_depth,
    1 AS max_depth,
    'knows' AS bridge_table_names;

# Hand-made catalog: declare what the builders measure. Each fixture artifact holds one row per bridge row,
# and an edge or fixed_path artifact without that proof is not used where rows are counted.
statement ok
ALTER TABLE graph.__pgq_path_catalog ADD COLUMN preserves_multiplicity BOOLEAN DEFAULT true;

statement ok
CREATE PROPERTY GRAPH test_graph
VERTEX TABLES (
    person PROPERTIES (id, name) LABEL Person
)
EDGE TABLES (
    knows SOURCE KEY (src) REFERENCES person(id)
          DESTINATION KEY (dst) REFERENCES person(id)
          PROPERTIES (src, dst, since)
          LABEL Knows
);

query III
FROM GRAPH_TABLE (
    test_graph
    MATCH (a:Person)-[e:Knows]->(b:Person)
    COLUMNS (a.name AS src, e.since AS since, b.name AS dst)
);
----
Bob	2021	Carol
