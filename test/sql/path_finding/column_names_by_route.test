statement ok
CREATE TABLE closure_path_trav AS FROM GRAPH_TABLE (g MATCH p = ANY SHORTEST (a:Person)-[:parentOf]->{1,3}(b:Person) COLUMNS (a.id, b.name, path_length(p), vertices(p)));

statement ok
SET pgq_disable_abi_rewrite = false;

statement ok
CREATE TABLE closure_path_abi AS FROM GRAPH_TABLE (g MATCH p = ANY SHORTEST (a:Person)-[:parentOf]->{1,3}(b:Person) COLUMNS (a.id, b.name, path_length(p), vertices(p)));

# The artifact route answered it
query I
SELECT count(*) > 0 FROM pgq_last_rewrite_diagnostics() WHERE status = 'selected';
----
true

query I
SELECT string_agg(column_name, ',' ORDER BY column_index) FROM duckdb_columns() WHERE table_name = 'closure_path_abi';
----
id,name,path_length(p),vertices(p)

query I
SELECT (SELECT string_agg(column_name, ',' ORDER BY column_index) FROM duckdb_columns() WHERE table_name = 'closure_path_abi')
     = (SELECT string_agg(column_name, ',' ORDER BY column_index) FROM duckdb_columns() WHERE table_name = 'closure_path_trav');
----
true

# vertices(p) holds row ids traversed and keys from an artifact (README); the rest of the row is the same
query I
SELECT count(*) FROM ((SELECT id, name, "path_length(p)" FROM closure_path_abi
                       EXCEPT ALL SELECT id, name, "path_length(p)" FROM closure_path_trav)
                      UNION ALL (SELECT id, name, "path_length(p)" FROM closure_path_trav
                                 EXCEPT ALL SELECT id, name, "path_length(p)" FROM closure_path_abi));
----
0

