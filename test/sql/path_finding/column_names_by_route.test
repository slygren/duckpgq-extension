# name: test/sql/path_finding/column_names_by_route.test
# description: A COLUMNS expression has the same name whichever route answers the pattern. COLUMNS (p.id) was named
#              `id` traversed and `v0` when an edge artifact answered. Every shape is run traversed and with ABI
#              artifacts, and the names are compared with each other and with the name SQL gives the expression.
# group: [path_finding]

require duckpgq

load __TEST_DIR__/column_names_by_route.db

statement ok
SET active_grammar_extensions = ['duckpgq'];

statement ok
CREATE TABLE Person(id BIGINT PRIMARY KEY, name VARCHAR);

statement ok
CREATE TABLE Tag(id BIGINT PRIMARY KEY, name VARCHAR, category VARCHAR);

statement ok
CREATE TABLE City(id BIGINT PRIMARY KEY, name VARCHAR);

statement ok
CREATE TABLE knows(src BIGINT, dst BIGINT);

statement ok
CREATE TABLE hasInterest(personId BIGINT, tagId BIGINT);

statement ok
CREATE TABLE livesIn(personId BIGINT, cityId BIGINT);

statement ok
CREATE TABLE parentOf(child BIGINT, parent BIGINT);

statement ok
INSERT INTO Person VALUES (1, 'A'), (2, 'B'), (3, 'C'), (4, 'D');

statement ok
INSERT INTO Tag VALUES (10, 't1', 'sport'), (11, 't2', 'art');

statement ok
INSERT INTO City VALUES (100, 'Oslo'), (101, 'Bergen');

statement ok
INSERT INTO knows VALUES (1, 2), (2, 3), (3, 4);

statement ok
INSERT INTO hasInterest VALUES (1, 10), (2, 10), (3, 11);

statement ok
INSERT INTO livesIn VALUES (1, 100), (2, 100), (3, 101), (4, 101);

statement ok
INSERT INTO parentOf VALUES (1, 2), (2, 3), (3, 4);

statement ok
CREATE PROPERTY GRAPH g
VERTEX TABLES (Person LABEL Person, Tag LABEL Tag, City LABEL City)
EDGE TABLES (
    knows SOURCE KEY (src) REFERENCES Person (id) DESTINATION KEY (dst) REFERENCES Person (id) LABEL knows,
    hasInterest SOURCE KEY (personId) REFERENCES Person (id) DESTINATION KEY (tagId) REFERENCES Tag (id) LABEL hasInterest,
    livesIn SOURCE KEY (personId) REFERENCES Person (id) DESTINATION KEY (cityId) REFERENCES City (id) LABEL livesIn,
    parentOf SOURCE KEY (child) REFERENCES Person (id) DESTINATION KEY (parent) REFERENCES Person (id) LABEL parentOf
);

statement ok
SELECT count(*) FROM pgq_abi_build('g', exclude_self_referential := false, closures := ['parentOf'],
    cover := MAP {'hasInterest': ['name', 'category']});

statement ok
SET pgq_disable_abi_rewrite = true;

statement ok
CREATE TABLE edge_key_trav AS FROM GRAPH_TABLE (g MATCH (p:Person)-[:hasInterest]->(t:Tag) COLUMNS (p.id, t.id));

statement ok
SET pgq_disable_abi_rewrite = false;

statement ok
CREATE TABLE edge_key_abi AS FROM GRAPH_TABLE (g MATCH (p:Person)-[:hasInterest]->(t:Tag) COLUMNS (p.id, t.id));

# The artifact route answered it
query I
SELECT count(*) > 0 FROM pgq_last_rewrite_diagnostics() WHERE status = 'selected';
----
true

query I
SELECT string_agg(column_name, ',' ORDER BY column_index) FROM duckdb_columns() WHERE table_name = 'edge_key_abi';
----
id,id_1

query I
SELECT (SELECT string_agg(column_name, ',' ORDER BY column_index) FROM duckdb_columns() WHERE table_name = 'edge_key_abi')
     = (SELECT string_agg(column_name, ',' ORDER BY column_index) FROM duckdb_columns() WHERE table_name = 'edge_key_trav');
----
true

query I
SELECT count(*) FROM ((FROM edge_key_abi EXCEPT ALL FROM edge_key_trav) UNION ALL (FROM edge_key_trav EXCEPT ALL FROM edge_key_abi));
----
0

statement ok
SET pgq_disable_abi_rewrite = true;

statement ok
CREATE TABLE edge_one_trav AS FROM GRAPH_TABLE (g MATCH (p:Person)-[:hasInterest]->(t:Tag) COLUMNS (p.id));

statement ok
SET pgq_disable_abi_rewrite = false;

statement ok
CREATE TABLE edge_one_abi AS FROM GRAPH_TABLE (g MATCH (p:Person)-[:hasInterest]->(t:Tag) COLUMNS (p.id));

