query I
SELECT (SELECT string_agg(column_name, ',' ORDER BY column_index) FROM duckdb_columns() WHERE table_name = 'edge_one_abi')
     = (SELECT string_agg(column_name, ',' ORDER BY column_index) FROM duckdb_columns() WHERE table_name = 'edge_one_trav');
----
true

query I
SELECT count(*) FROM ((FROM edge_one_abi EXCEPT ALL FROM edge_one_trav) UNION ALL (FROM edge_one_trav EXCEPT ALL FROM edge_one_abi));
----
0

