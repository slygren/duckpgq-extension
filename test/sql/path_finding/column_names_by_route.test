statement ok
CREATE TABLE closure_trav AS FROM GRAPH_TABLE (g MATCH ANY SHORTEST (a:Person)-[:parentOf]->{1,3}(b:Person) COLUMNS (a.id, b.id));

statement ok
SET pgq_disable_abi_rewrite = false;

statement ok
CREATE TABLE closure_abi AS FROM GRAPH_TABLE (g MATCH ANY SHORTEST (a:Person)-[:parentOf]->{1,3}(b:Person) COLUMNS (a.id, b.id));

# The artifact route answered it
query I
SELECT count(*) > 0 FROM pgq_last_rewrite_diagnostics() WHERE status = 'selected';
