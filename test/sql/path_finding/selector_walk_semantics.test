query III
SELECT (SELECT count(*) FROM (SELECT a, b FROM r GROUP BY ALL HAVING count(*) > 1)),
    (SELECT count(*) FROM ((SELECT DISTINCT a, b FROM r) EXCEPT (SELECT DISTINCT a, b FROM x))) +
        (SELECT count(*) FROM ((SELECT DISTINCT a, b FROM x) EXCEPT (SELECT DISTINCT a, b FROM r))),
    (SELECT count(*) FROM r WHERE NOT EXISTS (SELECT 1 FROM x WHERE x.a = r.a AND x.b = r.b AND x.vs = r.vs AND x.es = r.es
        AND x.depth = (SELECT min(depth) FROM x x2 WHERE x2.a = r.a AND x2.b = r.b)));
