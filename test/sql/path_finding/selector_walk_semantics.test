# =====================================================================================================================
# A diamond with a parallel edge, 1 -> 2 -> 4 -> 5, 1 -> 3 -> 4, 2 -> 4 twice: acyclic, so more shapes
# have an artifact that answers them (fixed paths, step scans). Undirected walks still return to their start.
# =====================================================================================================================

statement ok
CREATE TABLE HP(id BIGINT PRIMARY KEY);

statement ok
CREATE TABLE HK(src BIGINT, dst BIGINT);

statement ok
INSERT INTO HP VALUES (1), (2), (3), (4), (5);

statement ok
INSERT INTO HK VALUES (1, 2), (1, 3), (2, 4), (3, 4), (4, 5), (2, 4);

statement ok
CREATE PROPERTY GRAPH h VERTEX TABLES (HP LABEL P)
EDGE TABLES (HK SOURCE KEY (src) REFERENCES HP (id) DESTINATION KEY (dst) REFERENCES HP (id) LABEL K);

statement ok
CREATE TABLE hwalks AS
WITH RECURSIVE steps(dir, s, t, e) AS (
    SELECT '->', src, dst, rowid FROM HK
    UNION ALL SELECT '<-', dst, src, rowid FROM HK
    UNION ALL SELECT '-', src, dst, rowid FROM HK
    UNION ALL SELECT '-', dst, src, rowid FROM HK WHERE src <> dst),
w(dir, src, cur, depth, vs, es) AS (
    SELECT d, id, id, 0, [id], []::BIGINT[] FROM HP, (VALUES ('->'), ('<-'), ('-')) t(d)
    UNION ALL
    SELECT w.dir, w.src, steps.t, w.depth + 1, list_append(w.vs, steps.t), list_append(w.es, steps.e)
    FROM w JOIN steps ON steps.dir = w.dir AND steps.s = w.cur
    WHERE w.depth < 7)
SELECT * FROM w;

statement ok
CREATE TABLE href AS
SELECT 'WALK' AS mode, * FROM hwalks
UNION ALL SELECT 'TRAIL', * FROM hwalks WHERE len(list_distinct(es)) = depth
UNION ALL SELECT 'SIMPLE', * FROM hwalks
    WHERE len(list_distinct(vs[1:depth])) = depth AND (NOT list_contains(vs[1:depth], cur) OR cur = src)
UNION ALL SELECT 'ACYCLIC', * FROM hwalks WHERE len(list_distinct(vs)) = depth + 1;

statement ok
SET pgq_disable_abi_rewrite = true;

