# name: test/sql/path_finding/selector_walk_semantics.test
# description: ANY SHORTEST, ALL SHORTEST and SHORTEST k match walks (SQL/PGQ), checked against a brute-force walk enumeration
# group: [path_finding]

# Under a search prefix a quantified pattern matches walks: a vertex may repeat and a walk may return to its start
# (a closed walk), unless the path mode says otherwise: TRAIL no edge twice, SIMPLE no vertex twice except a return
# to the start, ACYCLIC no vertex twice. ANY SHORTEST keeps one shortest walk per endpoint pair, ALL SHORTEST every
# shortest one, SHORTEST k the k shortest. ANY SHORTEST used to leave out the closed walks and the walks through a
# vertex twice ({2,4} from a vertex to its neighbour), while SHORTEST k kept them. Every shape is compared with the
# enumeration (ref) traversed and again with artifacts built.

require duckpgq

statement ok
SET active_grammar_extensions = ['duckpgq'];

# 1 -> 2 (twice), 2 -> 3, 1 -> 3, 3 -> 4, 2 -> 4, 4 -> 1, 2 -> 1, 3 -> 5, 3 -> 2, a self loop on 6, 7 alone
statement ok
CREATE TABLE P(id BIGINT PRIMARY KEY);

statement ok
CREATE TABLE K(src BIGINT, dst BIGINT);

statement ok
INSERT INTO P VALUES (1), (2), (3), (4), (5), (6), (7);

statement ok
INSERT INTO K VALUES (1, 2), (1, 2), (2, 3), (1, 3), (3, 4), (2, 4), (4, 1), (2, 1), (3, 5), (3, 2), (6, 6);

statement ok
CREATE PROPERTY GRAPH g VERTEX TABLES (P LABEL P)
EDGE TABLES (K SOURCE KEY (src) REFERENCES P (id) DESTINATION KEY (dst) REFERENCES P (id) LABEL K);

# Every walk up to length 7 in each direction (edges as K row ids), and those each path mode admits
statement ok
CREATE TABLE walks AS
WITH RECURSIVE steps(dir, s, t, e) AS (
    SELECT '->', src, dst, rowid FROM K
    UNION ALL SELECT '<-', dst, src, rowid FROM K
    UNION ALL SELECT '-', src, dst, rowid FROM K
    UNION ALL SELECT '-', dst, src, rowid FROM K WHERE src <> dst),
w(dir, src, cur, depth, vs, es) AS (
    SELECT d, id, id, 0, [id], []::BIGINT[] FROM P, (VALUES ('->'), ('<-'), ('-')) t(d)
    UNION ALL
    SELECT w.dir, w.src, steps.t, w.depth + 1, list_append(w.vs, steps.t), list_append(w.es, steps.e)
    FROM w JOIN steps ON steps.dir = w.dir AND steps.s = w.cur
    WHERE w.depth < 7)
SELECT * FROM w;

statement ok
CREATE TABLE ref AS
SELECT 'WALK' AS mode, * FROM walks
UNION ALL SELECT 'TRAIL', * FROM walks WHERE len(list_distinct(es)) = depth
UNION ALL SELECT 'SIMPLE', * FROM walks
    WHERE len(list_distinct(vs[1:depth])) = depth AND (NOT list_contains(vs[1:depth], cur) OR cur = src)
UNION ALL SELECT 'ACYCLIC', * FROM walks WHERE len(list_distinct(vs)) = depth + 1;

# Closed walks of length 1: the self loop, both ways
query II rowsort
SELECT dir, count(*) FROM ref WHERE mode = 'WALK' AND src = cur AND depth = 1 GROUP BY ALL;
----
-	1
->	1
<-	1

# Closed walks 1 .. 1 of length 2: back over one of the three edges between 1 and 2 (9 ways undirected, 6 as
# trails), or over the edge to 3 or to 4; directed 1 -> 2 (two parallel edges) -> 1
query III rowsort
SELECT mode, dir, count(*) FROM ref WHERE src = 1 AND cur = 1 AND depth = 2 GROUP BY ALL;
----
SIMPLE	-	11
SIMPLE	->	2
SIMPLE	<-	2
TRAIL	-	6
TRAIL	->	2
TRAIL	<-	2
WALK	-	11
WALK	->	2
WALK	<-	2

# =====================================================================================================================
# Traversed
# =====================================================================================================================

statement ok
SET pgq_disable_abi_rewrite = true;

# g: ANY SHORTEST (a:P)-[e:K]->{1,3}(b:P) (traversed)
statement ok
CREATE OR REPLACE TABLE r AS SELECT * FROM GRAPH_TABLE (g MATCH p = ANY SHORTEST (a:P)-[e:K]->{1,3}(b:P)
    COLUMNS (a.id AS a, b.id AS b, vertex_property(p, 'id') AS vs, edges(p) AS es));

statement ok
CREATE OR REPLACE TABLE x AS SELECT src AS a, cur AS b, vs, es, depth FROM ref WHERE mode = 'WALK' AND dir = '->' AND depth BETWEEN 1 AND 3;

query III
SELECT (SELECT count(*) FROM (SELECT a, b FROM r GROUP BY ALL HAVING count(*) > 1)),
    (SELECT count(*) FROM ((SELECT DISTINCT a, b FROM r) EXCEPT (SELECT DISTINCT a, b FROM x))) +
        (SELECT count(*) FROM ((SELECT DISTINCT a, b FROM x) EXCEPT (SELECT DISTINCT a, b FROM r))),
    (SELECT count(*) FROM r WHERE NOT EXISTS (SELECT 1 FROM x WHERE x.a = r.a AND x.b = r.b AND x.vs = r.vs AND x.es = r.es
        AND x.depth = (SELECT min(depth) FROM x x2 WHERE x2.a = r.a AND x2.b = r.b)));
----
0	0	0

query I
SELECT count(*) FROM ((SELECT a, b FROM GRAPH_TABLE (g MATCH ANY SHORTEST (a:P)-[e:K]->{1,3}(b:P) COLUMNS (a.id AS a, b.id AS b))) EXCEPT ALL (SELECT a, b FROM r)) ;
----
0

# g: ALL SHORTEST (a:P)-[e:K]->{1,3}(b:P) (traversed)
statement ok
CREATE OR REPLACE TABLE r AS SELECT * FROM GRAPH_TABLE (g MATCH p = ALL SHORTEST (a:P)-[e:K]->{1,3}(b:P)
    COLUMNS (a.id AS a, b.id AS b, vertex_property(p, 'id') AS vs, edges(p) AS es));

statement ok
CREATE OR REPLACE TABLE x AS SELECT src AS a, cur AS b, vs, es, depth FROM ref WHERE mode = 'WALK' AND dir = '->' AND depth BETWEEN 1 AND 3;

query III
SELECT (SELECT count(*) FROM r) > 0,
    (SELECT count(*) FROM ((SELECT a, b, vs, es FROM r) EXCEPT ALL (SELECT a, b, vs, es FROM x QUALIFY depth = min(depth) OVER (PARTITION BY a, b)))),
    (SELECT count(*) FROM ((SELECT a, b, vs, es FROM x QUALIFY depth = min(depth) OVER (PARTITION BY a, b)) EXCEPT ALL (SELECT a, b, vs, es FROM r)));
----
true	0	0

# g: SHORTEST 2 WALK (a:P)-[e:K]->{1,3}(b:P) (traversed)
statement ok
CREATE OR REPLACE TABLE r AS SELECT * FROM GRAPH_TABLE (g MATCH p = SHORTEST 2 WALK (a:P)-[e:K]->{1,3}(b:P)
    COLUMNS (a.id AS a, b.id AS b, vertex_property(p, 'id') AS vs, edges(p) AS es));

statement ok
CREATE OR REPLACE TABLE x AS SELECT src AS a, cur AS b, vs, es, depth FROM ref WHERE mode = 'WALK' AND dir = '->' AND depth BETWEEN 1 AND 3;

query III
SELECT (SELECT count(*) FROM ((SELECT a, b, len(es) FROM r) EXCEPT ALL (SELECT a, b, depth FROM x QUALIFY row_number() OVER (PARTITION BY a, b ORDER BY depth) <= 2))) +
        (SELECT count(*) FROM ((SELECT a, b, depth FROM x QUALIFY row_number() OVER (PARTITION BY a, b ORDER BY depth) <= 2) EXCEPT ALL (SELECT a, b, len(es) FROM r))),
    (SELECT count(*) FROM ((SELECT a, b, vs, es FROM r) EXCEPT ALL (SELECT a, b, vs, es FROM x))),
    (SELECT count(*) FROM (SELECT a, b, vs, es FROM r GROUP BY ALL HAVING count(*) > 1));
----
0	0	0

