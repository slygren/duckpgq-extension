    COLUMNS (a.id AS a, b.id AS b, vertex_property(p, 'id') AS vs, edges(p) AS es));

statement ok
CREATE OR REPLACE TABLE x AS SELECT src AS a, cur AS b, vs, es, depth FROM href WHERE mode = 'TRAIL' AND dir = '-' AND depth BETWEEN 1 AND 7;

query III
SELECT (SELECT count(*) FROM ((SELECT a, b, len(es) FROM r) EXCEPT ALL (SELECT a, b, depth FROM x QUALIFY row_number() OVER (PARTITION BY a, b ORDER BY depth) <= 2))) +
        (SELECT count(*) FROM ((SELECT a, b, depth FROM x QUALIFY row_number() OVER (PARTITION BY a, b ORDER BY depth) <= 2) EXCEPT ALL (SELECT a, b, len(es) FROM r))),
    (SELECT count(*) FROM ((SELECT a, b, vs, es FROM r) EXCEPT ALL (SELECT a, b, vs, es FROM x))),
    (SELECT count(*) FROM (SELECT a, b, vs, es FROM r GROUP BY ALL HAVING count(*) > 1));
----
0	0	0

# h: ANY SHORTEST SIMPLE (a:P)-[e:K]-+(b:P) (artifacts)
statement ok
CREATE OR REPLACE TABLE r AS SELECT * FROM GRAPH_TABLE (h MATCH p = ANY SHORTEST SIMPLE (a:P)-[e:K]-+(b:P)
    COLUMNS (a.id AS a, b.id AS b, vertex_property(p, 'id') AS vs, edges(p) AS es));

statement ok
CREATE OR REPLACE TABLE x AS SELECT src AS a, cur AS b, vs, es, depth FROM href WHERE mode = 'SIMPLE' AND dir = '-' AND depth BETWEEN 1 AND 7;

query III
SELECT (SELECT count(*) FROM (SELECT a, b FROM r GROUP BY ALL HAVING count(*) > 1)),
    (SELECT count(*) FROM ((SELECT DISTINCT a, b FROM r) EXCEPT (SELECT DISTINCT a, b FROM x))) +
        (SELECT count(*) FROM ((SELECT DISTINCT a, b FROM x) EXCEPT (SELECT DISTINCT a, b FROM r))),
    (SELECT count(*) FROM r WHERE NOT EXISTS (SELECT 1 FROM x WHERE x.a = r.a AND x.b = r.b AND x.vs = r.vs AND x.es = r.es
        AND x.depth = (SELECT min(depth) FROM x x2 WHERE x2.a = r.a AND x2.b = r.b)));
