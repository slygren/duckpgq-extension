    (SELECT count(*) FROM ((SELECT a, b, vs, es FROM r) EXCEPT ALL (SELECT a, b, vs, es FROM x QUALIFY depth = min(depth) OVER (PARTITION BY a, b)))),
    (SELECT count(*) FROM ((SELECT a, b, vs, es FROM x QUALIFY depth = min(depth) OVER (PARTITION BY a, b)) EXCEPT ALL (SELECT a, b, vs, es FROM r)));
