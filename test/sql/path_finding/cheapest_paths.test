# An element WHERE on the costed edge filters its steps before the search: every path's edges pass it
statement ok
CREATE MACRO cheapest_where(cost_column, lo, hi, allowed) AS TABLE
SELECT src, dst, vs, es, cost FROM (
    SELECT src, dst, vs, es, CASE WHEN cost_column = 'w' THEN w ELSE d END AS cost FROM every_path
    WHERE depth BETWEEN lo AND hi AND list_has_all(allowed, es))
QUALIFY cost = min(cost) OVER (PARTITION BY src, dst);

