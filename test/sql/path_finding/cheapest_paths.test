    EXCEPT ALL (SELECT src, dst, vs, es, list_sum(ws) AS cost FROM every_costed_path WHERE depth > 0 AND list_max(ws) <= af
                QUALIFY cost = min(cost) OVER (PARTITION BY src, dst)));
