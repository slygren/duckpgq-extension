# ── The search by cost: <- and - without an upper bound, a lower bound above 1, an element WHERE ─────────────────
# Each against the brute force: the cheapest simple paths within the bounds, per pair.

# Left-directed without an upper bound: the right-directed paths, read from the other end
statement ok
CREATE TABLE left_u AS SELECT src, dst, list_reverse(vs) AS vs, list_reverse(es) AS es, cost
FROM GRAPH_TABLE (g MATCH p = ALL CHEAPEST (a:Person)<-[e:Link COST e.w]-+(b:Person)
    COLUMNS (b.id AS src, a.id AS dst, vertices(p) AS vs, edges(p) AS es, COST(p) AS cost));

query I
SELECT count(*) FROM (SELECT * FROM left_u EXCEPT ALL SELECT src, dst, vs, es, cost FROM cheapest_by('w', 1, 99));
----
0

query I
SELECT count(*) FROM (SELECT src, dst, vs, es, cost FROM cheapest_by('w', 1, 99) EXCEPT ALL SELECT * FROM left_u);
----
0

# DOUBLE costs are added in path order, which for <- runs against the stored direction: a brute force over the
# reversed edges, summing from the path's start
statement ok
CREATE TABLE every_left_path AS
WITH RECURSIVE paths(src, dst, depth, vs, es, d) AS (
    SELECT id, id, 0, [id], []::BIGINT[], 0::DOUBLE FROM person
    UNION ALL
    SELECT p.src, l.src, p.depth + 1, list_append(p.vs, l.src), list_append(p.es, l.rowid), p.d + l.d
    FROM paths p JOIN link l ON l.dst = p.dst
    WHERE NOT list_contains(p.vs, l.src))
FROM paths;

statement ok
CREATE MACRO cheapest_left(lo, hi) AS TABLE
SELECT src, dst, vs, es, d AS cost FROM every_left_path WHERE depth BETWEEN lo AND hi
QUALIFY d = min(d) OVER (PARTITION BY src, dst);

query I
SELECT count(*) FROM (
    (FROM GRAPH_TABLE (g MATCH p = ANY CHEAPEST (a:Person)<-[e:Link COST e.d]-*(b:Person) WHERE b.id <> a.id
        COLUMNS (a.id AS src, b.id AS dst, vertices(p) AS vs, edges(p) AS es, COST(p) AS cost)))
    EXCEPT (FROM cheapest_left(1, 99)));
