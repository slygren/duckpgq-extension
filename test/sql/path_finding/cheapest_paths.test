# Undirected without an upper bound
statement ok
CREATE TABLE undirected_every AS
WITH RECURSIVE both_ways AS (SELECT rowid AS eid, src, dst, w, d FROM link UNION ALL SELECT rowid, dst, src, w, d FROM link WHERE src <> dst),
paths(src, dst, depth, vs, es, w, d) AS (
    SELECT id, id, 0, [id], []::BIGINT[], 0::BIGINT, 0::DOUBLE FROM person
    UNION ALL
    SELECT p.src, l.dst, p.depth + 1, list_append(p.vs, l.dst), list_append(p.es, l.eid), p.w + l.w, p.d + l.d
    FROM paths p JOIN both_ways l ON l.src = p.dst
    WHERE NOT list_contains(p.vs, l.dst))
FROM paths;

statement ok
CREATE TABLE undirected_all AS FROM GRAPH_TABLE (g MATCH p = ALL CHEAPEST (a:Person)-[e:Link COST e.w]-+(b:Person)
    COLUMNS (a.id AS src, b.id AS dst, vertices(p) AS vs, edges(p) AS es, COST(p) AS cost));

