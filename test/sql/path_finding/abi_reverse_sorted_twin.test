# name: test/sql/path_finding/abi_reverse_sorted_twin.test
# description: destination-anchored lookups pick the reverse-sorted twin artifact (same rows, ordered by v1) so a v1 predicate can prune; source-anchored and unanchored lookups keep the forward artifact
# group: [path_finding]

require duckpgq


statement ok
SET active_grammar_extensions = ['duckpgq'];

statement ok
CREATE TABLE person(id INTEGER, name VARCHAR);

statement ok
INSERT INTO person VALUES (1,'Alice'),(2,'Bob'),(3,'Carol');

statement ok
CREATE TABLE knows(src INTEGER, dst INTEGER);

statement ok
INSERT INTO knows VALUES (1,2),(2,3);

statement ok
CREATE SCHEMA graph;

# Forward artifact: ordered by v0, the source key.
statement ok
CREATE TABLE graph.__pg_g__Person__Knows__Person AS
SELECT src AS v0, hash('e' || src || dst) AS e1, dst AS v1 FROM knows ORDER BY src;

# Reverse-sorted twin: the SAME rows ordered by v1, plus one marker row that the forward
# copy does not have. Real twins are row-identical -- the marker only exists so the test
# can tell which physical copy the binder read.
statement ok
CREATE TABLE graph.__pg_g__Person__Knows__Person__rev AS
SELECT src AS v0, hash('e' || src || dst) AS e1, dst AS v1 FROM knows
UNION ALL SELECT 3, hash('marker'), 1
ORDER BY v1;

statement ok
CREATE TABLE graph.__pgq_path_catalog AS
SELECT * FROM (VALUES
  ('g','__pg_g__Person__Knows__Person','edge',1,'Person','Person','Person,Person','Knows',true,true,2,now(),true,false,1,1,'knows'),
  ('g','__pg_g__Person__Knows__Person__rev','edge',1,'Person','Person','Person,Person','Knows',true,true,3,now(),false,true,1,1,'knows')
) t(graph_name,path_table_name,path_kind,hop_count,src_label,dst_label,vertex_label_sequence,edge_label_sequence,
    supports_one_row_per_step,is_deduplicated,estimated_rows,last_refreshed_at,is_sorted_by_v0,is_sorted_by_v1,
    min_depth,max_depth,bridge_table_names);

# Hand-made catalog: declare what the builders measure. Each fixture artifact holds one row per bridge row,
# and an edge or fixed_path artifact without that proof is not used where rows are counted.
statement ok
ALTER TABLE graph.__pgq_path_catalog ADD COLUMN preserves_multiplicity BOOLEAN DEFAULT true;

statement ok
CREATE PROPERTY GRAPH g
VERTEX TABLES (person PROPERTIES (id, name) LABEL Person)
EDGE TABLES (knows SOURCE KEY (src) REFERENCES person(id) DESTINATION KEY (dst) REFERENCES person(id) LABEL Knows);

# ── Destination-anchored: only b is bound, so the twin is picked ─────────────────
# The marker row 3->1 is only in the twin, so seeing b=1 reached from a=3 proves it.
query II rowsort
FROM GRAPH_TABLE (g MATCH (a:Person)-[:Knows]->(b:Person) WHERE b.id = 1
   COLUMNS (a.id AS aid, b.id AS bid));
----
3	1

# The pick is reported in the rewrite diagnostics.
query TT
SELECT path_table_name, reason FROM pgq_last_rewrite_diagnostics() WHERE rewrite_type = 'edge';
----
__pg_g__Person__Knows__Person__rev	selected exact edge artifact (reverse-sorted twin: destination-anchored lookup)

# ── Source-anchored: a is bound, so the forward artifact is kept ─────────────────
query II rowsort
FROM GRAPH_TABLE (g MATCH (a:Person)-[:Knows]->(b:Person) WHERE a.id = 1
   COLUMNS (a.id AS aid, b.id AS bid));
----
1	2

query TT
SELECT path_table_name, reason FROM pgq_last_rewrite_diagnostics() WHERE rewrite_type = 'edge';
----
__pg_g__Person__Knows__Person	selected exact edge artifact

# ── Both endpoints bound: source pruning already works, keep the forward copy ────
query II rowsort
FROM GRAPH_TABLE (g MATCH (a:Person)-[:Knows]->(b:Person) WHERE a.id = 1 AND b.id = 2
   COLUMNS (a.id AS aid, b.id AS bid));
----
1	2

query TT
SELECT path_table_name, reason FROM pgq_last_rewrite_diagnostics() WHERE rewrite_type = 'edge';
----
__pg_g__Person__Knows__Person	selected exact edge artifact

# ── Unanchored: nothing to prune on, keep the forward copy ───────────────────────
query II rowsort
FROM GRAPH_TABLE (g MATCH (a:Person)-[:Knows]->(b:Person)
   COLUMNS (a.id AS aid, b.id AS bid));
----
1	2
2	3

query TT
SELECT path_table_name, reason FROM pgq_last_rewrite_diagnostics() WHERE rewrite_type = 'edge';
----
__pg_g__Person__Knows__Person	selected exact edge artifact

statement ok
DROP PROPERTY GRAPH g;
