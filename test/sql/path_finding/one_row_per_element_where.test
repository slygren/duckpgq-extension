CREATE OR REPLACE TABLE t_out AS SELECT * FROM GRAPH_TABLE (g2 MATCH p = (a:Person)-[:Knows]->{2}(b:Person) ONE ROW PER EDGE (e) COLUMNS (a.id AS a, b.id AS b, a.name AS an, b.name AS bn, element_id(e) AS e)) WHERE an = 'Ann' AND bn <> 'Bob';

query III
SELECT (SELECT count(*) FROM t_elem) > 0,
       (SELECT count(*) FROM ((FROM t_elem EXCEPT ALL FROM t_mw) UNION ALL (FROM t_mw EXCEPT ALL FROM t_elem))),
       (SELECT count(*) FROM ((FROM t_elem EXCEPT ALL FROM t_out) UNION ALL (FROM t_out EXCEPT ALL FROM t_elem)));
----
true	0	0

# With ABI artifacts: a hierarchy whose closures answer ONE ROW PER STEP (the tc_chain key-step route)
statement ok
CREATE TABLE parent(child BIGINT, par BIGINT);

statement ok
INSERT INTO parent VALUES (1, 2), (2, 3), (3, 4), (5, 4);

statement ok
CREATE PROPERTY GRAPH h VERTEX TABLES (Person LABEL Person)
EDGE TABLES (parent SOURCE KEY (child) REFERENCES Person (id) DESTINATION KEY (par) REFERENCES Person (id) LABEL HasParent);

statement ok
SELECT count(*) FROM pgq_abi_build('h', exclude_self_referential := false, closures := ['HasParent']);

statement ok
CREATE OR REPLACE TABLE t_elem AS FROM GRAPH_TABLE (h MATCH (a:Person WHERE a.name = 'Ann')-[:HasParent]->{1,3}(b:Person)
    ONE ROW PER STEP (v1, e, v2) COLUMNS (a.id AS a, b.id AS b, v1.id AS v1, v2.id AS v2));

query I
SELECT count(*) > 0 FROM pgq_last_rewrite_diagnostics() WHERE status = 'selected';
----
true

statement ok
SET pgq_disable_abi_rewrite = true;

statement ok
CREATE OR REPLACE TABLE t_out AS SELECT a, b, v1, v2 FROM GRAPH_TABLE (h MATCH (a:Person)-[:HasParent]->{1,3}(b:Person)
    ONE ROW PER STEP (v1, e, v2) COLUMNS (a.id AS a, b.id AS b, a.name AS an, v1.id AS v1, v2.id AS v2)) WHERE an = 'Ann';

query II
SELECT (SELECT count(*) FROM t_elem),
       (SELECT count(*) FROM ((FROM t_elem EXCEPT ALL FROM t_out) UNION ALL (FROM t_out EXCEPT ALL FROM t_elem)));
----
7	0
