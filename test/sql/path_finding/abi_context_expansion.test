# name: test/sql/path_finding/abi_context_expansion.test
# description: Bounded variable-length context expansion uses ABI edge metadata across reached labels
# group: [path_finding]

require duckpgq


statement ok
SET active_grammar_extensions = ['duckpgq'];

statement ok
