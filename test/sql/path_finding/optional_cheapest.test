# The form that returned every path instead of the cheapest per pair on one build: one row per destination
query II rowsort
FROM GRAPH_TABLE (g MATCH (a:P) OPTIONAL MATCH ANY CHEAPEST (a)-[e:K COST e.w]->{1,3}(b:P) WHERE a.id = 1
    COLUMNS (a.id AS a, b.id AS b));
----
1	2
1	3
1	4
1	5

# A vertex without a path keeps one row of NULLs
query IIIT
FROM GRAPH_TABLE (g MATCH (a:P) OPTIONAL MATCH p = ANY CHEAPEST (a)-[e:K COST e.w]->+(b:P) WHERE a.id IN (5, 6)
    COLUMNS (a.id AS a, b.id AS b, COST(p) AS c, vertices(p) AS vs)) ORDER BY a;
----
5	NULL	NULL	NULL
6	NULL	NULL	NULL

# COST(p) in the WHERE filters the extended rows (NULL where there is no path)
query IIR rowsort
FROM GRAPH_TABLE (g MATCH (a:P) OPTIONAL MATCH p = ANY CHEAPEST (a)-[e:K COST e.w]->+(b:P) WHERE COST(p) < 2
    COLUMNS (a.id AS a, b.id AS b, COST(p) AS c));
----
1	2	1.0
2	1	1.0
2	3	1.0
3	4	1.0

# Both ends bound: the cheapest path between them, or NULLs (1 reaches 2 in two steps or more only through 1 again)
query IIR rowsort
FROM GRAPH_TABLE (g MATCH (a:P), (b:P) OPTIONAL MATCH p = ANY CHEAPEST (a)-[e:K COST e.w]->{2,}(b)
    WHERE a.id = 1 AND b.id IN (2, 3, 6) COLUMNS (a.id AS a, b.id AS b, COST(p) AS c));
----
1	2	NULL
1	3	2.0
1	6	NULL

# Two OPTIONAL groups, one of them CHEAPEST
statement ok
CREATE TABLE two_opt AS FROM GRAPH_TABLE (g MATCH (a:P) OPTIONAL MATCH (a)-[f:K]->(c:P)
    OPTIONAL MATCH p = ANY CHEAPEST (a)-[e:K COST e.w]->{1,2}(b:P) COLUMNS (a.id AS a, c.id AS c, b.id AS b, COST(p) AS cost));

statement ok
CREATE TABLE two_ref AS SELECT m.id AS a, h.c, o.b, o.cost FROM P m
LEFT JOIN (FROM GRAPH_TABLE (g MATCH (a:P)-[f:K]->(c:P) COLUMNS (a.id AS a, c.id AS c))) h ON h.a = m.id
LEFT JOIN (FROM GRAPH_TABLE (g MATCH p = ANY CHEAPEST (a:P)-[e:K COST e.w]->{1,2}(b:P) COLUMNS (a.id AS a, b.id AS b, COST(p) AS cost))) o
    ON o.a = m.id;

query II
SELECT (SELECT count(*) FROM (FROM two_opt EXCEPT ALL FROM two_ref)), (SELECT count(*) FROM (FROM two_ref EXCEPT ALL FROM two_opt));
----
0	0

# A UNION branch with its own COLUMNS (it read the head's COLUMNS, and failed to bind b, on the base)
statement ok
CREATE TABLE union_opt AS FROM GRAPH_TABLE (g MATCH (a:P)-[f:K]->(c:P) COLUMNS (a.id AS a, c.id AS b)
    UNION ALL MATCH (a:P) OPTIONAL MATCH ANY CHEAPEST (a)-[e:K COST e.w]->{1,2}(b:P) COLUMNS (a.id AS a, b.id AS b));

statement ok
CREATE TABLE union_ref AS SELECT src AS a, dst AS b FROM K UNION ALL SELECT m.id, o.b FROM P m
LEFT JOIN (FROM GRAPH_TABLE (g MATCH ANY CHEAPEST (a:P)-[e:K COST e.w]->{1,2}(b:P) COLUMNS (a.id AS a, b.id AS b))) o ON o.a = m.id;

query II
SELECT (SELECT count(*) FROM (FROM union_opt EXCEPT ALL FROM union_ref)), (SELECT count(*) FROM (FROM union_ref EXCEPT ALL FROM union_opt));
----
0	0

# A MATCH whose own pattern is CHEAPEST, with an OPTIONAL MATCH
statement ok
CREATE TABLE main_opt AS FROM GRAPH_TABLE (g MATCH p = ANY CHEAPEST (a:P)-[e:K COST e.w]->+(b:P) OPTIONAL MATCH (b)-[f:K]->(c:P)
    COLUMNS (a.id AS a, b.id AS b, COST(p) AS cost, vertices(p) AS vs, c.id AS c));

statement ok
CREATE TABLE main_ref AS SELECT m.*, h.c FROM
    (FROM GRAPH_TABLE (g MATCH p = ANY CHEAPEST (a:P)-[e:K COST e.w]->+(b:P) COLUMNS (a.id AS a, b.id AS b, COST(p) AS cost, vertices(p) AS vs))) m
LEFT JOIN (FROM GRAPH_TABLE (g MATCH (b:P)-[f:K]->(c:P) COLUMNS (b.id AS b, c.id AS c))) h ON h.b = m.b;

query III
SELECT (SELECT count(*) FROM (FROM main_opt EXCEPT ALL FROM main_ref)), (SELECT count(*) FROM (FROM main_ref EXCEPT ALL FROM main_opt)),
       (SELECT count(*) FROM main_opt) > 0;
----
0	0	true

# The path itself (not a path function of it) is still not carried out of an OPTIONAL MATCH
statement error
FROM GRAPH_TABLE (g MATCH (a:P) OPTIONAL MATCH p = ANY CHEAPEST (a)-[e:K COST e.w]->+(b:P) COLUMNS (a.id AS a, p));
----
cannot be used in COLUMNS or WHERE yet

# With ABI artifacts built: the constant COST may read them inside the group, a varying one is searched; same rows
statement ok
FROM pgq_abi_build('g', exclude_self_referential := false, closures := ['K']);

statement ok
CREATE TABLE opt_abi8 AS FROM GRAPH_TABLE (g MATCH (a:P) OPTIONAL MATCH p = ANY CHEAPEST (a)-[e:K COST 1]->{1,3}(b:P)
    COLUMNS (a.id AS a, b.id AS b, COST(p) AS c, vertices(p) AS vs, edges(p) AS es, path_length(p) AS len));

query II
SELECT (SELECT count(*) FROM (SELECT a, b, c, len FROM opt_abi8 EXCEPT ALL SELECT a, b, c, len FROM ref8)),
       (SELECT count(*) FROM (SELECT a, b, c, len FROM ref8 EXCEPT ALL SELECT a, b, c, len FROM opt_abi8));
----
0	0

statement ok
CREATE TABLE opt_abi7 AS FROM GRAPH_TABLE (g MATCH (a:P) OPTIONAL MATCH p = ALL CHEAPEST (a)-[e:K COST e.w]->{1,3}(b:P)
    COLUMNS (a.id AS a, b.id AS b, COST(p) AS c, vertices(p) AS vs, edges(p) AS es, path_length(p) AS len));

query II
SELECT (SELECT count(*) FROM (FROM opt_abi7 EXCEPT ALL FROM ref7)), (SELECT count(*) FROM (FROM ref7 EXCEPT ALL FROM opt_abi7));
----
0	0
