# name: test/sql/path_finding/optional_cheapest.test
# description: ANY / ALL CHEAPEST as the pattern of an OPTIONAL MATCH is refused (not yet verified on every route)
# group: [path_finding]

require duckpgq

statement ok
SET active_grammar_extensions = ['duckpgq'];

statement ok
CREATE TABLE P(id BIGINT PRIMARY KEY);

statement ok
CREATE TABLE K(src BIGINT, dst BIGINT, w DOUBLE);

statement ok
INSERT INTO P VALUES (1), (2), (3), (4), (5), (6);

statement ok
INSERT INTO K VALUES (1, 2, 5), (1, 2, 1), (2, 3, 1), (1, 3, 3), (3, 4, 1), (2, 4, 4), (4, 1, 2), (2, 1, 1), (3, 5, 2);

statement ok
CREATE PROPERTY GRAPH g VERTEX TABLES (P LABEL P)
EDGE TABLES (K SOURCE KEY (src) REFERENCES P (id) DESTINATION KEY (dst) REFERENCES P (id) LABEL K);

# The form that returned every path instead of the cheapest per pair on one build
statement error
FROM GRAPH_TABLE (g MATCH (a:P) OPTIONAL MATCH ANY CHEAPEST (a)-[e:K COST e.w]->{1,3}(b:P) WHERE a.id = 1
    COLUMNS (a.id AS a, b.id AS b));
----
ANY CHEAPEST / ALL CHEAPEST is not supported in an OPTIONAL MATCH pattern yet

statement error
FROM GRAPH_TABLE (g MATCH (a:P) OPTIONAL MATCH ALL CHEAPEST (a)-[e:K COST e.w]->{1,3}(b:P)
    COLUMNS (a.id AS a, b.id AS b));
----
ANY CHEAPEST / ALL CHEAPEST is not supported in an OPTIONAL MATCH pattern yet

statement error
FROM GRAPH_TABLE (g MATCH (a:P) OPTIONAL MATCH ANY CHEAPEST (a)-[e:K COST e.w]->+(b:P)
    COLUMNS (a.id AS a, b.id AS b));
----
ANY CHEAPEST / ALL CHEAPEST is not supported in an OPTIONAL MATCH pattern yet

statement error
FROM GRAPH_TABLE (g MATCH (a:P) OPTIONAL MATCH ALL CHEAPEST (a)-[e:K COST e.w]->*(b:P)
    COLUMNS (a.id AS a, b.id AS b));
----
ANY CHEAPEST / ALL CHEAPEST is not supported in an OPTIONAL MATCH pattern yet

statement error
FROM GRAPH_TABLE (g MATCH (a:P) OPTIONAL MATCH ANY CHEAPEST (a)<-[e:K COST e.w DEFAULT 1]-{2,3}(b:P)
    COLUMNS (a.id AS a, b.id AS b));
----
ANY CHEAPEST / ALL CHEAPEST is not supported in an OPTIONAL MATCH pattern yet

statement error
FROM GRAPH_TABLE (g MATCH (a:P) OPTIONAL MATCH ANY CHEAPEST (a)-[e:K COST e.w]-{1,2}(b:P)
    COLUMNS (a.id AS a, b.id AS b));
----
ANY CHEAPEST / ALL CHEAPEST is not supported in an OPTIONAL MATCH pattern yet

# With path functions and COST(p)
statement error
FROM GRAPH_TABLE (g MATCH (a:P) OPTIONAL MATCH p = ANY CHEAPEST (a)-[e:K COST e.w]->+(b:P)
    COLUMNS (a.id AS a, b.id AS b, cost(p) AS c));
----
ANY CHEAPEST / ALL CHEAPEST is not supported in an OPTIONAL MATCH pattern yet

statement error
FROM GRAPH_TABLE (g MATCH (a:P) OPTIONAL MATCH p = ALL CHEAPEST (a)-[e:K COST e.w]->{1,3}(b:P)
    COLUMNS (a.id AS a, vertices(p) AS vs, edges(p) AS es, path_length(p) AS l));
----
ANY CHEAPEST / ALL CHEAPEST is not supported in an OPTIONAL MATCH pattern yet

# A constant cost (CHEAPEST that is SHORTEST), a second optional group, a UNION branch
statement error
FROM GRAPH_TABLE (g MATCH (a:P) OPTIONAL MATCH ANY CHEAPEST (a)-[e:K COST 1]->{1,3}(b:P)
    COLUMNS (a.id AS a, b.id AS b));
----
ANY CHEAPEST / ALL CHEAPEST is not supported in an OPTIONAL MATCH pattern yet

statement error
FROM GRAPH_TABLE (g MATCH (a:P) OPTIONAL MATCH (a)-[f:K]->(c:P) OPTIONAL MATCH ANY CHEAPEST (a)-[e:K COST e.w]->{1,2}(b:P)
    COLUMNS (a.id AS a, b.id AS b));
----
ANY CHEAPEST / ALL CHEAPEST is not supported in an OPTIONAL MATCH pattern yet

statement error
FROM GRAPH_TABLE (g MATCH (a:P)-[f:K]->(c:P) COLUMNS (a.id AS a, c.id AS b)
    UNION ALL MATCH (a:P) OPTIONAL MATCH ANY CHEAPEST (a)-[e:K COST e.w]->{1,2}(b:P) COLUMNS (a.id AS a, b.id AS b));
----
ANY CHEAPEST / ALL CHEAPEST is not supported in an OPTIONAL MATCH pattern yet

# A MATCH whose own pattern is a CHEAPEST search with a varying COST cannot have an OPTIONAL MATCH either
statement error
FROM GRAPH_TABLE (g MATCH ANY CHEAPEST (a:P)-[e:K COST e.w]->+(b:P) OPTIONAL MATCH (b)-[f:K]->(c:P) COLUMNS (a.id AS a));
----
not supported with OPTIONAL

# The same CHEAPEST as a MATCH of its own still answers
query I
SELECT count(*) FROM GRAPH_TABLE (g MATCH ANY CHEAPEST (a:P)-[e:K COST e.w]->{1,3}(b:P) WHERE a.id = 1 COLUMNS (b.id AS b));
----
4
