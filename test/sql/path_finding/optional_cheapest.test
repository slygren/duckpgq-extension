# name: test/sql/path_finding/optional_cheapest.test
# description: ANY / ALL CHEAPEST as the pattern of an OPTIONAL MATCH, against the LEFT JOIN of the same CHEAPEST MATCH
# group: [path_finding]

# SQL/PGQ's OPTIONAL MATCH extends each row by every match of its group that agrees on the shared variables, or keeps
# it once with NULLs. So each form below must equal the LEFT JOIN of the vertices with the same pattern matched on its
# own (whose paths cheapest_paths.test checks against brute force). Both sides are materialised first: two similar
# GRAPH_TABLEs in one statement can be merged wrongly by DuckDB's common_subplan optimizer.

require duckpgq

statement ok
SET active_grammar_extensions = ['duckpgq'];

statement ok
CREATE TABLE P(id BIGINT PRIMARY KEY, f BIGINT);

statement ok
CREATE TABLE K(src BIGINT, dst BIGINT, w DOUBLE);

statement ok
INSERT INTO P VALUES (1, 1), (2, 2), (3, 1), (4, 2), (5, 1), (6, 2);

statement ok
INSERT INTO K VALUES (1, 2, 5), (1, 2, 1), (2, 3, 1), (1, 3, 3), (3, 4, 1), (2, 4, 4), (4, 1, 2), (2, 1, 1), (3, 5, 2);

statement ok
CREATE PROPERTY GRAPH g VERTEX TABLES (P LABEL P)
EDGE TABLES (K SOURCE KEY (src) REFERENCES P (id) DESTINATION KEY (dst) REFERENCES P (id) LABEL K);

# ANY CHEAPEST (a)-[e:K COST e.w]->{1,3}(b:P)
statement ok
CREATE TABLE ref0 AS SELECT m.id AS a, o.b FROM P m
LEFT JOIN (FROM GRAPH_TABLE (g MATCH ANY CHEAPEST (a:P)-[e:K COST e.w]->{1,3}(b:P) COLUMNS (a.id AS a, b.id AS b))) o ON o.a = m.id;

statement ok
CREATE TABLE opt0 AS FROM GRAPH_TABLE (g MATCH (a:P) OPTIONAL MATCH ANY CHEAPEST (a)-[e:K COST e.w]->{1,3}(b:P) COLUMNS (a.id AS a, b.id AS b));

query III
SELECT (SELECT count(*) FROM (FROM opt0 EXCEPT ALL FROM ref0)), (SELECT count(*) FROM (FROM ref0 EXCEPT ALL FROM opt0)),
       (SELECT count(*) FROM opt0) > 6;
----
0	0	true

# ALL CHEAPEST (a)-[e:K COST e.w]->{1,3}(b:P)
statement ok
CREATE TABLE ref1 AS SELECT m.id AS a, o.b FROM P m
LEFT JOIN (FROM GRAPH_TABLE (g MATCH ALL CHEAPEST (a:P)-[e:K COST e.w]->{1,3}(b:P) COLUMNS (a.id AS a, b.id AS b))) o ON o.a = m.id;

statement ok
CREATE TABLE opt1 AS FROM GRAPH_TABLE (g MATCH (a:P) OPTIONAL MATCH ALL CHEAPEST (a)-[e:K COST e.w]->{1,3}(b:P) COLUMNS (a.id AS a, b.id AS b));

query III
SELECT (SELECT count(*) FROM (FROM opt1 EXCEPT ALL FROM ref1)), (SELECT count(*) FROM (FROM ref1 EXCEPT ALL FROM opt1)),
       (SELECT count(*) FROM opt1) > 6;
----
0	0	true

