CREATE OR REPLACE TABLE o AS SELECT * FROM GRAPH_TABLE (g MATCH ALL CHEAPEST (t:P)-[e:K COST e.w]-{1,3}(x:P) COLUMNS (t.id AS t, x.id AS x));

statement ok
CREATE OR REPLACE TABLE ref AS SELECT m.t, o.x FROM m LEFT JOIN o ON m.t = o.t;

statement ok
CREATE OR REPLACE TABLE act AS SELECT * FROM GRAPH_TABLE (g MATCH (t:P) OPTIONAL MATCH ALL CHEAPEST (t)-[e:K COST e.w]-{1,3}(x:P) WHERE t.id = 5 COLUMNS (t.id AS t, x.id AS x));

query II
SELECT (SELECT count(*) FROM (FROM act EXCEPT ALL FROM ref)), (SELECT count(*) FROM (FROM ref EXCEPT ALL FROM act));
----
0	0

