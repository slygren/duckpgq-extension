# ── Which artifacts a chain reads ──────────────────────────────────────────────────────────────────────────────────

# Seeded on a, which the backwards K hop holds in v1: the twin ordered by v1
statement ok
FROM GRAPH_TABLE (g MATCH (a:P)<-[:K]-(b:P)-[:S]->(c:Q) WHERE a.id = 2 COLUMNS (b.id AS b, c.name AS c));

query TI
SELECT reason, endpoint_filter_count FROM pgq_last_rewrite_diagnostics();
----
joined one artifact per run of hops: __pg_g__P__K__P__rev (reversed) + __pg_g__P__S__Q	1

statement ok
FROM GRAPH_TABLE (g MATCH (a:P)<-[:K]-(b:P)-[:S]->(c:Q) COLUMNS (b.id AS b, c.name AS c));

query T
SELECT reason FROM pgq_last_rewrite_diagnostics();
----
joined one artifact per run of hops: __pg_g__P__K__P (reversed) + __pg_g__P__S__Q

# A run of two hops reads the fixed_path artifact, from its far end when the run is backwards
statement ok
FROM GRAPH_TABLE (g MATCH (q:Q)<-[:S]-(a:P)-[:K]->(b:P)-[:K]->(c:P) COLUMNS (q.id AS q));

query T
SELECT reason FROM pgq_last_rewrite_diagnostics();
----
joined one artifact per run of hops: __pg_g__P__S__Q (reversed) + __pg_g__P__K__P__K__P

statement ok
FROM GRAPH_TABLE (g MATCH (c:P)<-[:K]-(b:P)<-[:K]-(a:P)-[:S]->(q:Q) COLUMNS (c.id AS c));

query T
SELECT reason FROM pgq_last_rewrite_diagnostics();
----
joined one artifact per run of hops: __pg_g__P__K__P__K__P (reversed) + __pg_g__P__S__Q

statement ok
FROM GRAPH_TABLE (g MATCH (a:P)-[:K]-(b:P)-[:S]->(c:Q) COLUMNS (c.id AS c));

query T
SELECT reason FROM pgq_last_rewrite_diagnostics();
----
joined one artifact per run of hops: __pg_g__P__K__P (both ways) + __pg_g__P__S__Q

# Under pgq_require_abi_paths a mixed chain is answered instead of refused
statement ok
SET pgq_require_abi_paths = true;

query I
SELECT count(*) FROM GRAPH_TABLE (g MATCH (a:P)<-[:K]-(b:P)-[:S]->(c:Q) COLUMNS (a.id AS a));
----
6

statement error
SELECT count(*) FROM GRAPH_TABLE (g MATCH (a:P)-[:S]-(b:Q)-[:T]->(c:Q) COLUMNS (a.id AS a));
----
pgq_require_abi_paths

statement ok
SET pgq_require_abi_paths = false;

# ── An edge stored twice: the artifact holds it once, so counted answers traverse; EXISTS reads the artifacts ─────

statement ok
INSERT INTO S VALUES (2, 2);

statement ok
SELECT count(*) FROM pgq_abi_build('g', exclude_self_referential := false, max_hops := 2, reverse_twins := ['K', 'S']);

query I
SELECT count(*) FROM GRAPH_TABLE (g MATCH (a:P)<-[:K]-(b:P)-[:S]->(c:Q) COLUMNS (a.id AS a, b.id AS b, c.id AS c));
----
8

query T
SELECT coalesce(string_agg(rewrite_type, ','), 'traversal') FROM pgq_last_rewrite_diagnostics() WHERE status = 'selected';
----
traversal

query TTI
SELECT status, rewrite_fired, only_in_abi + only_in_fallback FROM pgq_verify_abi_rewrite($$FROM GRAPH_TABLE (g MATCH (a:P) WHERE EXISTS { (a)<-[:K]-(b:P)-[:S]->(c:Q) } COLUMNS (a.id AS a))$$);
----
match	true	0
