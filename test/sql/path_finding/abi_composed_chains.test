# A one-way chain without a fixed_path artifact (P -S-> Q -T-> Q is built; Q -T-> Q -T-> Q is not excluded either, so use three hops)
query II
FROM GRAPH_TABLE (g MATCH (a:P)-[:S]->(b:Q)-[:T]->(c:Q)-[:T]->(d:Q) COLUMNS (a.id AS a, d.id AS d)) ORDER BY ALL;
----
