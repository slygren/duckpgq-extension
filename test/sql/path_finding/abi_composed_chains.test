# name: test/sql/path_finding/abi_composed_chains.test
# description: Fixed-length chains with undirected or mixed-direction hops, answered from one artifact per run of
#              hops (edge artifacts read either way, fixed_path artifacts, reverse twins) exactly as the traversal
#              answers them; expected rows are the traversal's (generated with pgq_disable_abi_rewrite = true)
# group: [path_finding]

require duckpgq

statement ok
SET active_grammar_extensions = ['duckpgq'];

# P and Q vertices. K: P -> P with a self-loop (2, 2) and an edge to a missing vertex (3, 99); S: P -> Q with an edge
# to a missing vertex (4, 99); T: Q -> Q with a self-loop.

statement ok
CREATE TABLE P (id BIGINT, name VARCHAR);

statement ok
INSERT INTO P VALUES (1, 'p1'), (2, 'p2'), (3, 'p3'), (4, 'p4');

statement ok
CREATE TABLE Q (id BIGINT, name VARCHAR);

statement ok
INSERT INTO Q VALUES (1, 'q1'), (2, 'q2'), (3, 'q3');

statement ok
CREATE TABLE K (src BIGINT, dst BIGINT, w BIGINT);

statement ok
INSERT INTO K VALUES (1, 2, 10), (2, 3, 20), (2, 2, 30), (3, 1, 40), (4, 2, 50), (3, 99, 60);

statement ok
CREATE TABLE S (src BIGINT, dst BIGINT);

statement ok
INSERT INTO S VALUES (1, 1), (2, 1), (2, 2), (3, 3), (4, 99);

statement ok
CREATE TABLE T (src BIGINT, dst BIGINT);

statement ok
INSERT INTO T VALUES (1, 2), (2, 3), (3, 3);

statement ok
CREATE PROPERTY GRAPH g VERTEX TABLES (P LABEL P, Q LABEL Q) EDGE TABLES (
    K SOURCE KEY (src) REFERENCES P (id) DESTINATION KEY (dst) REFERENCES P (id) LABEL K,
    S SOURCE KEY (src) REFERENCES P (id) DESTINATION KEY (dst) REFERENCES Q (id) LABEL S,
    T SOURCE KEY (src) REFERENCES Q (id) DESTINATION KEY (dst) REFERENCES Q (id) LABEL T);

statement ok
SELECT count(*) FROM pgq_abi_build('g', exclude_self_referential := false, max_hops := 2, reverse_twins := ['K', 'S']);

# 1-hop undirected: a self-loop is one match (the artifact used to read it twice)
query II
FROM GRAPH_TABLE (g MATCH (a:P)-[:K]-(b:P) COLUMNS (a.id AS a, b.id AS b)) ORDER BY ALL;
----
1	2
1	3
2	1
2	2
2	3
2	4
3	1
3	2
4	2

query T
SELECT coalesce(string_agg(rewrite_type, ','), 'traversal') FROM pgq_last_rewrite_diagnostics() WHERE status = 'selected';
----
undirected_edge

query TTI
SELECT status, rewrite_fired, only_in_abi + only_in_fallback FROM pgq_verify_abi_rewrite($$FROM GRAPH_TABLE (g MATCH (a:P)-[:K]-(b:P) COLUMNS (a.id AS a, b.id AS b))$$);
----
match	true	0

# <-> is an edge in either direction: the same matches
query II
FROM GRAPH_TABLE (g MATCH (a:P)<-[:K]->(b:P) COLUMNS (a.id AS a, b.id AS b)) ORDER BY ALL;
----
1	2
1	3
2	1
2	2
2	3
2	4
3	1
3	2
4	2

query T
SELECT coalesce(string_agg(rewrite_type, ','), 'traversal') FROM pgq_last_rewrite_diagnostics() WHERE status = 'selected';
----
undirected_edge

query TTI
SELECT status, rewrite_fired, only_in_abi + only_in_fallback FROM pgq_verify_abi_rewrite($$FROM GRAPH_TABLE (g MATCH (a:P)<-[:K]->(b:P) COLUMNS (a.id AS a, b.id AS b))$$);
----
match	true	0

# Mixed directions: K read backwards, then S forwards
query III
FROM GRAPH_TABLE (g MATCH (a:P)<-[:K]-(b:P)-[:S]->(c:Q) COLUMNS (a.id AS a, b.id AS b, c.id AS c)) ORDER BY ALL;
----
1	3	3
2	1	1
2	2	1
2	2	2
3	2	1
3	2	2

query T
SELECT coalesce(string_agg(rewrite_type, ','), 'traversal') FROM pgq_last_rewrite_diagnostics() WHERE status = 'selected';
----
composed_chain

query TTI
SELECT status, rewrite_fired, only_in_abi + only_in_fallback FROM pgq_verify_abi_rewrite($$FROM GRAPH_TABLE (g MATCH (a:P)<-[:K]-(b:P)-[:S]->(c:Q) COLUMNS (a.id AS a, b.id AS b, c.id AS c))$$);
----
match	true	0

# ... seeded on the end that the backwards hop reads as v1: the reverse twin
query IT
FROM GRAPH_TABLE (g MATCH (a:P)<-[:K]-(b:P)-[:S]->(c:Q) WHERE a.id = 2 COLUMNS (b.id AS b, c.name AS c)) ORDER BY ALL;
----
1	q1
2	q1
2	q2

