# An edge table with an alias: path searches work in the session that created it (they used to fail with
# 'Referenced table knows not found') and after a restart, where the alias is now kept.
statement ok
CREATE PROPERTY GRAPH g_alias VERTEX TABLES (person AS pp LABEL Person) EDGE TABLES (knows AS kk SOURCE KEY (src) REFERENCES pp (id) DESTINATION KEY (dst) REFERENCES pp (id) LABEL Knows);

query II
SELECT (SELECT count(*) FROM (FROM GRAPH_TABLE (g_alias MATCH p = ANY SHORTEST (a:Person)-[:Knows]->+(b:Person) COLUMNS (a.id, b.id, path_length(p))) EXCEPT ALL FROM GRAPH_TABLE (g_direct MATCH p = ANY SHORTEST (a:Person)-[:Knows]->+(b:Person) COLUMNS (a.id, b.id, path_length(p))))) + (SELECT count(*) FROM (FROM GRAPH_TABLE (g_direct MATCH p = ANY SHORTEST (a:Person)-[:Knows]->+(b:Person) COLUMNS (a.id, b.id, path_length(p))) EXCEPT ALL FROM GRAPH_TABLE (g_alias MATCH p = ANY SHORTEST (a:Person)-[:Knows]->+(b:Person) COLUMNS (a.id, b.id, path_length(p))))), (SELECT count(*) > 0 FROM (FROM GRAPH_TABLE (g_alias MATCH p = ANY SHORTEST (a:Person)-[:Knows]->+(b:Person) COLUMNS (a.id, b.id, path_length(p)))));
----
0	true

query I
SELECT count(*) FROM pagerank('g_alias', 'Person', 'Knows');
----
30

# The graph survives a restart, with its alias c.
restart

statement ok
SET active_grammar_extensions = ['duckpgq'];

query II
SELECT (SELECT count(*) FROM (FROM GRAPH_TABLE (g_alias MATCH p = ANY SHORTEST (a:Person)-[:Knows]->+(b:Person) COLUMNS (a.id, b.id, path_length(p))) EXCEPT ALL FROM GRAPH_TABLE (g_direct MATCH p = ANY SHORTEST (a:Person)-[:Knows]->+(b:Person) COLUMNS (a.id, b.id, path_length(p))))) + (SELECT count(*) FROM (FROM GRAPH_TABLE (g_direct MATCH p = ANY SHORTEST (a:Person)-[:Knows]->+(b:Person) COLUMNS (a.id, b.id, path_length(p))) EXCEPT ALL FROM GRAPH_TABLE (g_alias MATCH p = ANY SHORTEST (a:Person)-[:Knows]->+(b:Person) COLUMNS (a.id, b.id, path_length(p))))), (SELECT count(*) > 0 FROM (FROM GRAPH_TABLE (g_alias MATCH p = ANY SHORTEST (a:Person)-[:Knows]->+(b:Person) COLUMNS (a.id, b.id, path_length(p)))));
----
0	true

