# name: test/sql/create_pg/alter_property_graph.test
# description: ALTER PROPERTY GRAPH ADD / DROP VERTEX and EDGE TABLES, ALTER ... TABLE ADD / DROP LABEL. An altered
#              graph answers like the graph created with the resulting definition; it persists, every connection
#              sees it, and the graph's ABI artifacts stop answering until they are rebuilt.
# group: [create_pg]

require duckpgq

load {TEST_DIR}/alter_property_graph.db

statement ok
SET active_grammar_extensions = ['duckpgq'];

statement ok
CREATE TABLE person (id BIGINT, name VARCHAR, age INTEGER);

statement ok
INSERT INTO person SELECT range, 'p' || range, 20 + range % 30 FROM range(1, 31);

statement ok
CREATE TABLE city (cid BIGINT, cname VARCHAR);

statement ok
INSERT INTO city VALUES (100, 'Oslo'), (101, 'Rome'), (102, 'Lima');

statement ok
CREATE TABLE knows (src BIGINT, dst BIGINT);

statement ok
INSERT INTO knows SELECT range, (range * 7) % 30 + 1 FROM range(1, 31) UNION ALL SELECT range, range + 1 FROM range(1, 30);

statement ok
CREATE TABLE lives (p BIGINT, c BIGINT);

statement ok
INSERT INTO lives SELECT range, 100 + range % 3 FROM range(1, 31) WHERE range % 4 <> 0;

statement ok
CREATE TABLE likes (a BIGINT, b BIGINT);

statement ok
INSERT INTO likes SELECT range, (range * 3) % 30 + 1 FROM range(1, 31);

# Built up by ALTER, and created at once.
statement ok
CREATE PROPERTY GRAPH g VERTEX TABLES (person LABEL Person);

statement ok
ALTER PROPERTY GRAPH g ADD VERTEX TABLES (city AS c LABEL City);

statement ok
ALTER PROPERTY GRAPH g ADD EDGE TABLES (knows SOURCE KEY (src) REFERENCES person (id) DESTINATION KEY (dst) REFERENCES person (id) LABEL Knows, lives SOURCE KEY (p) REFERENCES person (id) DESTINATION KEY (c) REFERENCES c (cid) LABEL LivesIn);

statement ok
ALTER PROPERTY GRAPH g ALTER VERTEX TABLE person ADD LABEL Human PROPERTIES (id, age + 1 AS next_age);

statement ok
CREATE PROPERTY GRAPH g_direct VERTEX TABLES (person LABEL Person LABEL Human PROPERTIES (id, age + 1 AS next_age), city AS c LABEL City) EDGE TABLES (knows SOURCE KEY (src) REFERENCES person (id) DESTINATION KEY (dst) REFERENCES person (id) LABEL Knows, lives SOURCE KEY (p) REFERENCES person (id) DESTINATION KEY (c) REFERENCES c (cid) LABEL LivesIn);

query TTTT
SELECT table_name, label, extra_labels, column_aliases FROM __duckpgq_internal WHERE property_graph = 'g' ORDER BY table_name;
----
city	City	NULL	[cid, cname]
knows	Knows	NULL	[dst, src]
lives	LivesIn	NULL	[c, p]
person	Person	[Human]	[age, id, name, next_age]

query II
SELECT (SELECT count(*) FROM (FROM GRAPH_TABLE (g MATCH (a:Person)-[:Knows]->(b:Human) COLUMNS (a.id, b.next_age)) EXCEPT ALL FROM GRAPH_TABLE (g_direct MATCH (a:Person)-[:Knows]->(b:Human) COLUMNS (a.id, b.next_age)))) + (SELECT count(*) FROM (FROM GRAPH_TABLE (g_direct MATCH (a:Person)-[:Knows]->(b:Human) COLUMNS (a.id, b.next_age)) EXCEPT ALL FROM GRAPH_TABLE (g MATCH (a:Person)-[:Knows]->(b:Human) COLUMNS (a.id, b.next_age)))), (SELECT count(*) > 0 FROM (FROM GRAPH_TABLE (g MATCH (a:Person)-[:Knows]->(b:Human) COLUMNS (a.id, b.next_age))));
----
0	true

query II
SELECT (SELECT count(*) FROM (FROM GRAPH_TABLE (g MATCH (a:Human)-[:LivesIn]->(x:City) COLUMNS (a.name, x.cname)) EXCEPT ALL FROM GRAPH_TABLE (g_direct MATCH (a:Human)-[:LivesIn]->(x:City) COLUMNS (a.name, x.cname)))) + (SELECT count(*) FROM (FROM GRAPH_TABLE (g_direct MATCH (a:Human)-[:LivesIn]->(x:City) COLUMNS (a.name, x.cname)) EXCEPT ALL FROM GRAPH_TABLE (g MATCH (a:Human)-[:LivesIn]->(x:City) COLUMNS (a.name, x.cname)))), (SELECT count(*) > 0 FROM (FROM GRAPH_TABLE (g MATCH (a:Human)-[:LivesIn]->(x:City) COLUMNS (a.name, x.cname))));
----
0	true

query II
SELECT (SELECT count(*) FROM (FROM GRAPH_TABLE (g MATCH p = ANY SHORTEST (a:Person)-[:Knows]->+(b:Person) COLUMNS (a.id, b.id, path_length(p))) EXCEPT ALL FROM GRAPH_TABLE (g_direct MATCH p = ANY SHORTEST (a:Person)-[:Knows]->+(b:Person) COLUMNS (a.id, b.id, path_length(p))))) + (SELECT count(*) FROM (FROM GRAPH_TABLE (g_direct MATCH p = ANY SHORTEST (a:Person)-[:Knows]->+(b:Person) COLUMNS (a.id, b.id, path_length(p))) EXCEPT ALL FROM GRAPH_TABLE (g MATCH p = ANY SHORTEST (a:Person)-[:Knows]->+(b:Person) COLUMNS (a.id, b.id, path_length(p))))), (SELECT count(*) > 0 FROM (FROM GRAPH_TABLE (g MATCH p = ANY SHORTEST (a:Person)-[:Knows]->+(b:Person) COLUMNS (a.id, b.id, path_length(p)))));
----
0	true

query II
SELECT (SELECT count(*) FROM (FROM GRAPH_TABLE (g MATCH (a:Person)-[:Knows]->{1,2}(b:Person)-[:LivesIn]->(x:City) COLUMNS (a.id, x.cid)) EXCEPT ALL FROM GRAPH_TABLE (g_direct MATCH (a:Person)-[:Knows]->{1,2}(b:Person)-[:LivesIn]->(x:City) COLUMNS (a.id, x.cid)))) + (SELECT count(*) FROM (FROM GRAPH_TABLE (g_direct MATCH (a:Person)-[:Knows]->{1,2}(b:Person)-[:LivesIn]->(x:City) COLUMNS (a.id, x.cid)) EXCEPT ALL FROM GRAPH_TABLE (g MATCH (a:Person)-[:Knows]->{1,2}(b:Person)-[:LivesIn]->(x:City) COLUMNS (a.id, x.cid)))), (SELECT count(*) > 0 FROM (FROM GRAPH_TABLE (g MATCH (a:Person)-[:Knows]->{1,2}(b:Person)-[:LivesIn]->(x:City) COLUMNS (a.id, x.cid))));
----
0	true

query II
SELECT (SELECT count(*) FROM (FROM GRAPH_TABLE (g MATCH (a:Person) OPTIONAL MATCH (a)-[:LivesIn]->(x:City) COLUMNS (a.id, x.cid)) EXCEPT ALL FROM GRAPH_TABLE (g_direct MATCH (a:Person) OPTIONAL MATCH (a)-[:LivesIn]->(x:City) COLUMNS (a.id, x.cid)))) + (SELECT count(*) FROM (FROM GRAPH_TABLE (g_direct MATCH (a:Person) OPTIONAL MATCH (a)-[:LivesIn]->(x:City) COLUMNS (a.id, x.cid)) EXCEPT ALL FROM GRAPH_TABLE (g MATCH (a:Person) OPTIONAL MATCH (a)-[:LivesIn]->(x:City) COLUMNS (a.id, x.cid)))), (SELECT count(*) > 0 FROM (FROM GRAPH_TABLE (g MATCH (a:Person) OPTIONAL MATCH (a)-[:LivesIn]->(x:City) COLUMNS (a.id, x.cid))));
----
0	true

# Every connection sees the altered graph.
query II
SELECT (SELECT count(*) FROM (FROM GRAPH_TABLE (g MATCH (a:Human)-[:LivesIn]->(x:City) COLUMNS (a.name, x.cname)) EXCEPT ALL FROM GRAPH_TABLE (g_direct MATCH (a:Human)-[:LivesIn]->(x:City) COLUMNS (a.name, x.cname)))) + (SELECT count(*) FROM (FROM GRAPH_TABLE (g_direct MATCH (a:Human)-[:LivesIn]->(x:City) COLUMNS (a.name, x.cname)) EXCEPT ALL FROM GRAPH_TABLE (g MATCH (a:Human)-[:LivesIn]->(x:City) COLUMNS (a.name, x.cname)))), (SELECT count(*) > 0 FROM (FROM GRAPH_TABLE (g MATCH (a:Human)-[:LivesIn]->(x:City) COLUMNS (a.name, x.cname))));
----
0	true

statement ok con2
SET active_grammar_extensions = ['duckpgq'];

query I con2
SELECT count(*) FROM GRAPH_TABLE (g MATCH (a:Human)-[:LivesIn]->(x:City) COLUMNS (a.id));
----
23

# DROP VERTEX TABLES refuses a table edges reference (RESTRICT, the default); CASCADE drops those edges too.
statement error
ALTER PROPERTY GRAPH g DROP VERTEX TABLES (c);
----
Vertex table c of property graph g is referenced by edge table(s) lives

statement error
ALTER PROPERTY GRAPH g DROP VERTEX TABLES (c) RESTRICT;
----
is referenced by edge table(s) lives

statement ok
ALTER PROPERTY GRAPH g DROP NODE TABLES (c) CASCADE;

query T
SELECT list(table_name ORDER BY table_name) FROM __duckpgq_internal WHERE property_graph = 'g';
----
[knows, person]

statement error
FROM GRAPH_TABLE (g MATCH (a:Person)-[:LivesIn]->(x:City) COLUMNS (a.id));
----
LivesIn

statement ok
ALTER PROPERTY GRAPH g ADD VERTEX TABLES (city AS c LABEL City);

statement ok
ALTER PROPERTY GRAPH g ADD RELATIONSHIP TABLES (lives SOURCE KEY (p) REFERENCES person (id) DESTINATION KEY (c) REFERENCES c (cid) LABEL LivesIn, likes SOURCE KEY (a) REFERENCES person (id) DESTINATION KEY (b) REFERENCES person (id) LABEL Likes);

statement ok
ALTER PROPERTY GRAPH g DROP EDGE TABLES (likes);

