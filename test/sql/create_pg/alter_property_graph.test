# Labels: ADD LABEL without PROPERTIES brings every column (SQL/PGQ); DROP LABEL of the first label makes the next
# one first; a table keeps at least one label.
statement ok
CREATE PROPERTY GRAPH gl VERTEX TABLES (person PROPERTIES (id) LABEL Person) EDGE TABLES (knows SOURCE KEY (src) REFERENCES person (id) DESTINATION KEY (dst) REFERENCES person (id) LABEL Knows);

statement error
FROM GRAPH_TABLE (gl MATCH (a:Person) COLUMNS (a.name));
----
Property a.name is never registered

statement ok
ALTER PROPERTY GRAPH gl ALTER VERTEX TABLE person ADD LABEL Human;

query T
SELECT column_aliases FROM __duckpgq_internal WHERE property_graph = 'gl' AND is_vertex_table;
----
[age, id, name]

statement ok
ALTER PROPERTY GRAPH gl ALTER EDGE TABLE knows ADD LABEL Friend NO PROPERTIES;

query TI
FROM GRAPH_TABLE (gl MATCH (a:Human WHERE a.id = 1)-[k:Friend]->(b) COLUMNS (label(a), b.id)) ORDER BY ALL;
----
Person	2
Person	8

statement ok
ALTER PROPERTY GRAPH gl ALTER VERTEX TABLE person DROP LABEL Person;

query TI
FROM GRAPH_TABLE (gl MATCH (a:Human WHERE a.id = 1)-[k:Knows]->(b) COLUMNS (label(a), b.id)) ORDER BY ALL;
----
Human	2
Human	8

statement error
FROM GRAPH_TABLE (gl MATCH (a:Person) COLUMNS (a.id));
----
Person

statement error
ALTER PROPERTY GRAPH gl ALTER VERTEX TABLE person DROP LABEL Human;
----
Label Human is the only label of element table person

statement error
ALTER PROPERTY GRAPH gl ALTER VERTEX TABLE person ADD LABEL Human;
----
Element table person already has label Human

statement error
ALTER PROPERTY GRAPH gl ALTER VERTEX TABLE person ADD LABEL Friend;
----
Label friend is not unique

statement error
ALTER PROPERTY GRAPH gl ALTER VERTEX TABLE person DROP LABEL Nope;
----
Element table person has no label Nope

statement error
ALTER PROPERTY GRAPH gl ALTER VERTEX TABLE nope ADD LABEL X;
----
Vertex table nope of property graph gl does not exist

statement ok
CREATE TABLE typed (id BIGINT, kind INTEGER);

statement ok
CREATE PROPERTY GRAPH gs VERTEX TABLES (typed LABEL T IN kind (A, B));

statement error
ALTER PROPERTY GRAPH gs ALTER VERTEX TABLE typed DROP LABEL A;
----
is a discriminator sub-label

# Errors.
statement error
ALTER PROPERTY GRAPH nope ADD VERTEX TABLES (person);
----
Property graph nope does not exist

statement error
ALTER PROPERTY GRAPH g ADD VERTEX TABLES (person);
----
Property graph g already has an element table person

statement error
ALTER PROPERTY GRAPH g ADD VERTEX TABLES (likes LABEL Person);
----
Label person is not unique

statement error
ALTER PROPERTY GRAPH g ADD EDGE TABLES (likes SOURCE KEY (a) REFERENCES nope (id) DESTINATION KEY (b) REFERENCES person (id));
----
nope

statement error
ALTER PROPERTY GRAPH g DROP EDGE TABLES (nope);
----
Edge table nope of property graph g does not exist

statement error
ALTER PROPERTY GRAPH gl DROP VERTEX TABLES (person) CASCADE;
----
Property graph gl would have no vertex table left

statement ok
CREATE PROPERTY GRAPH gtwice VERTEX TABLES (person AS a LABEL A, person AS b LABEL B);

statement error
ALTER PROPERTY GRAPH gtwice DROP VERTEX TABLES (person);
----
is ambiguous: name it by its alias

statement ok
ALTER PROPERTY GRAPH gtwice DROP VERTEX TABLES (b);

query T
SELECT list(label) FROM __duckpgq_internal WHERE property_graph = 'gtwice';
----
[A]

# A failed ALTER changes nothing.
query T
SELECT list(table_name ORDER BY table_name) FROM __duckpgq_internal WHERE property_graph = 'g';
----
[city, knows, lives, person]

# ABI artifacts: an ALTER stops them from answering (the graph they were built for is gone) until pgq_abi_build
# builds them for the new definition.
statement ok
CREATE PROPERTY GRAPH ga VERTEX TABLES (person LABEL Person, city LABEL City) EDGE TABLES (lives SOURCE KEY (p) REFERENCES person (id) DESTINATION KEY (c) REFERENCES city (cid) LABEL LivesIn) WITH ABI (max_hops := 1);

statement ok
SELECT * FROM pgq_abi_build('ga');

statement ok
SET pgq_require_abi_paths = true;

statement ok
FROM GRAPH_TABLE (ga MATCH (a:Person)-[:LivesIn]->(x:City) COLUMNS (a.id, x.cid)) LIMIT 1;

query T
SELECT bool_or(status = 'selected') FROM pgq_last_rewrite_diagnostics();
----
true

statement ok
ALTER PROPERTY GRAPH ga ADD EDGE TABLES (knows SOURCE KEY (src) REFERENCES person (id) DESTINATION KEY (dst) REFERENCES person (id) LABEL Knows);

statement error
FROM GRAPH_TABLE (ga MATCH (a:Person)-[:LivesIn]->(x:City) COLUMNS (a.id, x.cid));
----
DuckPGQ ABI path required by pgq_require_abi_paths, but no matching ABI path table rewrite was available

query TT
SELECT bool_and(fresh = false), bool_and(table_exists) FROM pgq_abi_status('ga');
----
true	true

query T
SELECT DISTINCT abi_disabled FROM __duckpgq_internal WHERE property_graph = 'ga';
----
true

statement ok
SET pgq_require_abi_paths = false;

query I
SELECT count(*) FROM GRAPH_TABLE (ga MATCH (a:Person)-[:LivesIn]->(x:City) COLUMNS (a.id, x.cid));
----
23

# Disabled across a restart too.
restart

statement ok
SET active_grammar_extensions = ['duckpgq'];

statement ok
SET pgq_require_abi_paths = true;

statement error
FROM GRAPH_TABLE (ga MATCH (a:Person)-[:LivesIn]->(x:City) COLUMNS (a.id, x.cid));
----
no matching ABI path table rewrite was available

# A build for the new definition makes them answer again, on every connection.
statement ok
SELECT * FROM pgq_abi_build('ga');

query I
SELECT count(*) FROM GRAPH_TABLE (ga MATCH (a:Person)-[:LivesIn]->(x:City) COLUMNS (a.id, x.cid));
----
23

query T
SELECT bool_or(status = 'selected') FROM pgq_last_rewrite_diagnostics();
----
true

query T
SELECT DISTINCT abi_disabled FROM __duckpgq_internal WHERE property_graph = 'ga';
----
NULL

statement ok con3
SET active_grammar_extensions = ['duckpgq'];

statement ok con3
SET pgq_require_abi_paths = true;

query I con3
SELECT count(*) FROM GRAPH_TABLE (ga MATCH (a:Person)-[:LivesIn]->(x:City) COLUMNS (a.id, x.cid));
