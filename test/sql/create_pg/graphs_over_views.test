# Vertex-join elimination never applies to a view: a FOREIGN KEY on the table under the edge view says nothing
# about the rows the vertex view filters out.
statement ok
CREATE TABLE fk_p (id BIGINT PRIMARY KEY, keep BOOLEAN);

statement ok
INSERT INTO fk_p VALUES (1, true), (2, true), (3, false);

statement ok
CREATE TABLE fk_e (src BIGINT REFERENCES fk_p (id), dst BIGINT REFERENCES fk_p (id));

statement ok
INSERT INTO fk_e VALUES (1, 2), (1, 3), (2, 3);

statement ok
CREATE VIEW fk_pv AS SELECT * FROM fk_p WHERE keep;

statement ok
CREATE VIEW fk_ev AS SELECT * FROM fk_e;

statement ok
SET pgq_verify_edges_on_create = true;

# pgq_verify_edges_on_create reads the views too, and finds the edge whose vertex the view filters out.
statement error
CREATE PROPERTY GRAPH gfk VERTEX TABLES (fk_pv LABEL P) EDGE TABLES (fk_ev SOURCE KEY (src) REFERENCES fk_pv (id) DESTINATION KEY (dst) REFERENCES fk_pv (id) LABEL E);
----
Incomplete edge

statement error
CREATE PROPERTY GRAPH gfk VERTEX TABLES (fk_pv LABEL P) EDGE TABLES (fk_e SOURCE KEY (src) REFERENCES fk_pv (id) DESTINATION KEY (dst) REFERENCES fk_pv (id) LABEL E);
----
Incomplete edge

statement ok
SET pgq_verify_edges_on_create = false;

statement ok
CREATE PROPERTY GRAPH gfk VERTEX TABLES (fk_pv LABEL P) EDGE TABLES (fk_ev SOURCE KEY (src) REFERENCES fk_pv (id) DESTINATION KEY (dst) REFERENCES fk_pv (id) LABEL E);

statement ok
CREATE PROPERTY GRAPH gfk2 VERTEX TABLES (fk_pv LABEL P) EDGE TABLES (fk_e SOURCE KEY (src) REFERENCES fk_pv (id) DESTINATION KEY (dst) REFERENCES fk_pv (id) LABEL E);

query II
FROM GRAPH_TABLE (gfk MATCH (a:P)-[e:E]->(b:P) COLUMNS (a.id, e.dst)) ORDER BY ALL;
----
