# Element ids of a view are the same in every read of it, within a query and across queries.
query T
SELECT bool_and(ea = vs[1] AND eb = vs[-1]) FROM GRAPH_TABLE (gv MATCH p = ANY SHORTEST (a:Person)-[k:Knows]->+(b:Person) COLUMNS (vertices(p) AS vs, element_id(a) AS ea, element_id(b) AS eb));
----
true

query II
WITH paths AS (FROM GRAPH_TABLE (gv MATCH p = ANY SHORTEST (a:Person)-[k:Knows]->{1,4}(b:Person) COLUMNS (vertices(p) AS vs, vertex_property(p, 'id') AS ids))), idmap AS (FROM GRAPH_TABLE (gv MATCH (v:Person) COLUMNS (element_id(v) AS rid, v.id AS id))), steps AS (SELECT unnest(vs) AS rid, unnest(ids) AS id FROM paths) SELECT count(*), count(*) FILTER (WHERE m.id IS DISTINCT FROM s.id) FROM steps s LEFT JOIN idmap m USING (rid);
----
978	0

