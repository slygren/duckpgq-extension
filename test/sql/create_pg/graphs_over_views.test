# ABI artifacts over views answer like those over tables. Artifacts answer only where every edge has its two
# vertices and every edge row is distinct, so these graphs leave the incomplete and duplicate edges out.
statement ok
CREATE VIEW knows_cv AS SELECT DISTINCT * FROM knows_v WHERE src IN (SELECT id FROM person_v) AND dst IN (SELECT id FROM person_v);

statement ok
CREATE VIEW lives_cv AS SELECT * FROM lives_v WHERE p IN (SELECT id FROM person_v) AND c IN (SELECT cid FROM city_v);

statement ok
CREATE TABLE knows_ct AS SELECT * FROM knows_cv;

statement ok
CREATE TABLE lives_ct AS SELECT * FROM lives_cv;

statement ok
CREATE PROPERTY GRAPH gat VERTEX TABLES (person_t LABEL Person, city_t LABEL City) EDGE TABLES (knows_ct SOURCE KEY (src) REFERENCES person_t (id) DESTINATION KEY (dst) REFERENCES person_t (id) LABEL Knows, lives_ct SOURCE KEY (p) REFERENCES person_t (id) DESTINATION KEY (c) REFERENCES city_t (cid) LABEL LivesIn);

statement ok
CREATE PROPERTY GRAPH gav VERTEX TABLES (person_v LABEL Person, city_v LABEL City) EDGE TABLES (knows_cv SOURCE KEY (src) REFERENCES person_v (id) DESTINATION KEY (dst) REFERENCES person_v (id) LABEL Knows, lives_cv SOURCE KEY (p) REFERENCES person_v (id) DESTINATION KEY (c) REFERENCES city_v (cid) LABEL LivesIn);

statement ok
SELECT * FROM pgq_abi_build('gat', max_hops := 2);

statement ok
SELECT * FROM pgq_abi_build('gav', max_hops := 2);

query TI
SELECT list(artifact ORDER BY artifact) = (SELECT list(replace(artifact, 'gat', 'gav') ORDER BY artifact) FROM pgq_abi_status('gat') WHERE table_exists), count(*) FROM pgq_abi_status('gav') WHERE table_exists;
----
true	2

