# name: test/sql/create_pg/graphs_over_views.test
# description: property graphs over views. Every query over a graph of views equals the same query over a graph
#              of tables holding the same rows (traversal, path searches, ONE ROW PER, OPTIONAL, EXISTS, graph
#              algorithms, ABI artifacts), element ids are consistent within a query, and a view never has its
#              vertex join eliminated.
# group: [create_pg]

require duckpgq

statement ok
SET active_grammar_extensions = ['duckpgq'];

statement ok
CREATE TABLE person_base (id BIGINT, name VARCHAR, age INTEGER, kind INTEGER, hidden BOOLEAN);

statement ok
INSERT INTO person_base VALUES (1, 'p1', 27, 2, false), (2, 'p2', 34, 3, false), (3, 'p3', 41, 1, false), (4, 'p4', 48, 2, false), (5, 'p5', 55, 3, false), (6, 'p6', 62, 1, false), (7, 'p7', 69, 2, false), (8, 'p8', 26, 3, false), (9, 'p9', 33, 1, true), (10, 'p10', 40, 2, false), (11, 'p11', 47, 3, false), (12, 'p12', 54, 1, false), (13, 'p13', 61, 2, false), (14, 'p14', 68, 3, false), (15, 'p15', 25, 1, false), (16, 'p16', 32, 2, false), (17, 'p17', 39, 3, false), (18, 'p18', 46, 1, true), (19, 'p19', 53, 2, false), (20, 'p20', 60, 3, false), (21, 'p21', 67, 1, false), (22, 'p22', 24, 2, false), (23, 'p23', 31, 3, false), (24, 'p24', 38, 1, false);

statement ok
CREATE TABLE city_base (cid BIGINT, cname VARCHAR);

statement ok
INSERT INTO city_base VALUES (100, 'c0'), (101, 'c1'), (102, 'c2'), (103, 'c3'), (104, 'c4');

statement ok
CREATE TABLE knows_base (src BIGINT, dst BIGINT, w INTEGER);

statement ok
INSERT INTO knows_base VALUES (11, 5, 7), (21, 2, 2), (18, 4, 6), (19, 2, 9), (7, 2, 2), (14, 14, 2), (8, 3, 9), (14, 2, 2), (8, 21, 1), (19, 19, 7), (2, 8, 1), (18, 5, 5), (14, 5, 9), (4, 19, 5), (18, 22, 3), (4, 19, 4), (12, 4, 9), (23, 3, 1), (20, 7, 8), (22, 18, 7), (11, 15, 8), (12, 10, 4), (6, 23, 4), (3, 19, 5), (17, 16, 6), (24, 15, 5), (20, 3, 2), (17, 14, 3), (11, 5, 8), (14, 2, 2), (18, 19, 6), (11, 23, 6), (20, 16, 8), (3, 3, 5), (16, 23, 2), (2, 24, 5), (21, 19, 8), (10, 23, 7), (22, 12, 1), (15, 12, 3), (20, 4, 8), (2, 7, 5), (5, 24, 4), (13, 13, 8), (3, 6, 8), (13, 18, 5), (5, 14, 9), (9, 23, 7), (12, 22, 7), (8, 5, 2), (6, 5, 4), (22, 8, 1), (16, 19, 3), (9, 10, 1), (5, 14, 9), (12, 20, 6), (5, 23, 9), (20, 21, 1), (15, 22, 9), (13, 13, 7), (13, 4, 8), (21, 13, 1), (7, 3, 4), (15, 6, 2), (11, 20, 1), (4, 1, 3), (18, 4, 6), (20, 1, 2), (7, 20, 7), (5, 21, 5), (3, 3, 5), (4, 5, 2), (4, 5, 2), (1, 2, 3), (1, 5, 4), (2, 99, 1);

statement ok
CREATE TABLE lives_base (p BIGINT, c BIGINT);

statement ok
INSERT INTO lives_base VALUES (1, 101), (2, 102), (3, 103), (5, 100), (6, 101), (7, 102), (9, 104), (10, 100), (11, 101), (13, 103), (14, 104), (15, 100), (17, 102), (18, 103), (19, 104), (21, 101), (22, 102), (23, 103), (7, 999);

# The views: a filter, a projection with a computed column, a join and a plain copy.
statement ok
CREATE VIEW person_v AS SELECT id, name, age, kind FROM person_base WHERE NOT hidden;

statement ok
CREATE VIEW city_v AS SELECT cid, upper(cname) AS cname FROM city_base;

statement ok
CREATE VIEW knows_v AS SELECT k.src, k.dst, k.w FROM knows_base k JOIN person_base p ON p.id = k.src WHERE p.age < 65;

statement ok
CREATE VIEW lives_v AS SELECT * FROM lives_base;

# The same rows as tables.
statement ok
CREATE TABLE person_t AS SELECT * FROM person_v;

statement ok
CREATE TABLE city_t AS SELECT * FROM city_v;

statement ok
CREATE TABLE knows_t AS SELECT * FROM knows_v;

statement ok
CREATE TABLE lives_t AS SELECT * FROM lives_v;

statement ok
CREATE PROPERTY GRAPH gt VERTEX TABLES (
    person_t PROPERTIES (id, name, age, kind) LABEL Person IN kind (Student, Teacher, Staff),
    city_t LABEL City)
EDGE TABLES (
    knows_t SOURCE KEY (src) REFERENCES person_t (id)
                   DESTINATION KEY (dst) REFERENCES person_t (id) LABEL Knows,
    lives_t SOURCE KEY (p) REFERENCES person_t (id)
                   DESTINATION KEY (c) REFERENCES city_t (cid) LABEL LivesIn);

statement ok
CREATE PROPERTY GRAPH gv VERTEX TABLES (
    person_v PROPERTIES (id, name, age, kind) LABEL Person IN kind (Student, Teacher, Staff),
    city_v LABEL City)
EDGE TABLES (
    knows_v SOURCE KEY (src) REFERENCES person_v (id)
                   DESTINATION KEY (dst) REFERENCES person_v (id) LABEL Knows,
    lives_v SOURCE KEY (p) REFERENCES person_v (id)
                   DESTINATION KEY (c) REFERENCES city_v (cid) LABEL LivesIn);

query TT
SELECT table_name, is_view FROM __duckpgq_internal WHERE property_graph = 'gv' ORDER BY table_name;
----
city_v	true
knows_v	true
lives_v	true
person_v	true

query T
SELECT DISTINCT is_view FROM __duckpgq_internal WHERE property_graph = 'gt';
----
NULL

# Every query: the symmetric difference of the two graphs' answers is empty, and the answer is not.
query II
SELECT (SELECT count(*) FROM (FROM GRAPH_TABLE (gt MATCH (a:Person)-[k:Knows]->(b:Person) COLUMNS (a.id AS a, b.id AS b, k.w AS w)) EXCEPT ALL FROM GRAPH_TABLE (gv MATCH (a:Person)-[k:Knows]->(b:Person) COLUMNS (a.id AS a, b.id AS b, k.w AS w)))) + (SELECT count(*) FROM (FROM GRAPH_TABLE (gv MATCH (a:Person)-[k:Knows]->(b:Person) COLUMNS (a.id AS a, b.id AS b, k.w AS w)) EXCEPT ALL FROM GRAPH_TABLE (gt MATCH (a:Person)-[k:Knows]->(b:Person) COLUMNS (a.id AS a, b.id AS b, k.w AS w)))), (SELECT count(*) > 0 FROM (FROM GRAPH_TABLE (gv MATCH (a:Person)-[k:Knows]->(b:Person) COLUMNS (a.id AS a, b.id AS b, k.w AS w))));
----
0	true

