SELECT (SELECT count(*) FROM (FROM GRAPH_TABLE (gc MATCH p = ANY SHORTEST (a:Person)-[k:Knows]->+(b:Person) WHERE a.lname = 'p1' COLUMNS (b.id, path_length(p), vertex_property(p, 'age_next') AS ages, edge_property(p, 'arrow') AS arrows)) EXCEPT ALL FROM GRAPH_TABLE (gm MATCH p = ANY SHORTEST (a:Person)-[k:Knows]->+(b:Person) WHERE a.lname = 'p1' COLUMNS (b.id, path_length(p), vertex_property(p, 'age_next') AS ages, edge_property(p, 'arrow') AS arrows)))) + (SELECT count(*) FROM (FROM GRAPH_TABLE (gm MATCH p = ANY SHORTEST (a:Person)-[k:Knows]->+(b:Person) WHERE a.lname = 'p1' COLUMNS (b.id, path_length(p), vertex_property(p, 'age_next') AS ages, edge_property(p, 'arrow') AS arrows)) EXCEPT ALL FROM GRAPH_TABLE (gc MATCH p = ANY SHORTEST (a:Person)-[k:Knows]->+(b:Person) WHERE a.lname = 'p1' COLUMNS (b.id, path_length(p), vertex_property(p, 'age_next') AS ages, edge_property(p, 'arrow') AS arrows))));
----
0

# A computed property over a view, and two element tables over one table with properties of their own.
statement ok
CREATE VIEW person_v AS SELECT * FROM person WHERE age < 50;

statement ok
CREATE PROPERTY GRAPH gview VERTEX TABLES (person_v PROPERTIES (id, age * 10 AS age10) LABEL Person) EDGE TABLES (knows SOURCE KEY (src) REFERENCES person_v (id) DESTINATION KEY (dst) REFERENCES person_v (id) LABEL Knows);

query I
SELECT count(*) FROM ((FROM GRAPH_TABLE (gview MATCH (a:Person)-[:Knows]->(b:Person) COLUMNS (a.id, b.age10)) EXCEPT ALL SELECT k.src, p.age * 10 FROM knows k JOIN person_v s ON s.id = k.src JOIN person_v p ON p.id = k.dst) UNION ALL (SELECT k.src, p.age * 10 FROM knows k JOIN person_v s ON s.id = k.src JOIN person_v p ON p.id = k.dst EXCEPT ALL FROM GRAPH_TABLE (gview MATCH (a:Person)-[:Knows]->(b:Person) COLUMNS (a.id, b.age10))));
----
0

statement ok
CREATE PROPERTY GRAPH gtwo VERTEX TABLES (person AS young PROPERTIES (id, age - 18 AS since18) LABEL Young, person AS old PROPERTIES (id, 100 - age AS left100) LABEL Old) EDGE TABLES (knows SOURCE KEY (src) REFERENCES young (id) DESTINATION KEY (dst) REFERENCES old (id) LABEL Knows);

query I
SELECT count(*) FROM ((FROM GRAPH_TABLE (gtwo MATCH (a:Young)-[:Knows]->(b:Old) COLUMNS (a.since18, b.left100)) EXCEPT ALL SELECT s.age - 18, 100 - d.age FROM knows k JOIN person s ON s.id = k.src JOIN person d ON d.id = k.dst) UNION ALL (SELECT s.age - 18, 100 - d.age FROM knows k JOIN person s ON s.id = k.src JOIN person d ON d.id = k.dst EXCEPT ALL FROM GRAPH_TABLE (gtwo MATCH (a:Young)-[:Knows]->(b:Old) COLUMNS (a.since18, b.left100))));
----
0

# A property every label lists the same way is one property; with different definitions it is an error.
statement ok
CREATE PROPERTY GRAPH glabels VERTEX TABLES (person LABEL A PROPERTIES (id, age + 1 AS n) LABEL B PROPERTIES (age + 1 AS n));

query T
SELECT column_aliases FROM __duckpgq_internal WHERE property_graph = 'glabels';
----
[id, n]

# Errors.
statement error
CREATE PROPERTY GRAPH bad VERTEX TABLES (person PROPERTIES (id, age + 1));
----
Property (age + 1) is an expression and needs a name

statement error
CREATE PROPERTY GRAPH bad VERTEX TABLES (person PROPERTIES (id, nope + 1 AS x));
----
A computed property of element table person is invalid

statement error
CREATE PROPERTY GRAPH bad VERTEX TABLES (person PROPERTIES (id, age + 1 AS name));
----
Property name of element table person is also the name of a column of the table

statement error
CREATE PROPERTY GRAPH bad VERTEX TABLES (person PROPERTIES (id AS age));
----
Property age of element table person is also the name of a column of the table

statement error
CREATE PROPERTY GRAPH bad VERTEX TABLES (person PROPERTIES (id, (SELECT 1) AS x));
----
a property expression cannot contain a subquery

statement error
CREATE PROPERTY GRAPH bad VERTEX TABLES (person PROPERTIES (id, row_number() OVER () AS x));
----
a property expression cannot contain a subquery, a window function

statement error
CREATE PROPERTY GRAPH bad VERTEX TABLES (person PROPERTIES (id, sum(age) AS x));
----
A computed property of element table person is invalid

statement error
CREATE PROPERTY GRAPH bad VERTEX TABLES (person LABEL A PROPERTIES (age + 1 AS n) LABEL B PROPERTIES (age + 2 AS n));
----
Property n of element table person is defined twice, differently

statement error
FROM GRAPH_TABLE (gc MATCH (a:Person) COLUMNS (a.age));
----
Property a.age is never registered

