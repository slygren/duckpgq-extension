query II
SELECT (SELECT count(*) FROM (FROM GRAPH_TABLE (gc MATCH (a:Person) COLUMNS (a.*)) EXCEPT ALL FROM GRAPH_TABLE (gm MATCH (a:Person) COLUMNS (a.*)))) + (SELECT count(*) FROM (FROM GRAPH_TABLE (gm MATCH (a:Person) COLUMNS (a.*)) EXCEPT ALL FROM GRAPH_TABLE (gc MATCH (a:Person) COLUMNS (a.*)))), (SELECT count(*) > 0 FROM (FROM GRAPH_TABLE (gc MATCH (a:Person) COLUMNS (a.*))));
