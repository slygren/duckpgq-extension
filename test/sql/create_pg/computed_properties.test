# The column a renamed property reads stays readable by its own name, as before renamed properties worked.
query T
SELECT bool_and(fullname = name) FROM GRAPH_TABLE (gc MATCH (a:Person) COLUMNS (a.fullname, a.name));
----
true

# ABI artifacts carry keys; the properties come from the element relation.
statement ok
SELECT * FROM pgq_abi_build('gc', max_hops := 2);

statement ok
SELECT * FROM pgq_abi_build('gm', max_hops := 2);

statement ok
SET pgq_require_abi_paths = true;

statement ok
CREATE OR REPLACE TABLE abi_gc AS FROM GRAPH_TABLE (gc MATCH p = ANY SHORTEST (a:Person)-[:Knows]->{1,2}(b:Person) WHERE a.age_next > 25 COLUMNS (a.lname AS a, b.fullname AS b, path_length(p) AS l));

query T
SELECT bool_or(status = 'selected') FROM pgq_last_rewrite_diagnostics();
----
true

statement ok
CREATE OR REPLACE TABLE abi_gm AS FROM GRAPH_TABLE (gm MATCH p = ANY SHORTEST (a:Person)-[:Knows]->{1,2}(b:Person) WHERE a.age_next > 25 COLUMNS (a.lname AS a, b.fullname AS b, path_length(p) AS l));

query T
SELECT bool_or(status = 'selected') FROM pgq_last_rewrite_diagnostics();
----
true

query II
SELECT (SELECT count(*) FROM (FROM abi_gc EXCEPT ALL FROM abi_gm)) + (SELECT count(*) FROM (FROM abi_gm EXCEPT ALL FROM abi_gc)), (SELECT count(*) > 0 FROM abi_gc);
----
0	true

statement ok
CREATE OR REPLACE TABLE abi_gc AS FROM GRAPH_TABLE (gc MATCH p = ANY SHORTEST (a:Person)-[:Knows]->{1,2}(b:Person) WHERE a.id = 5 COLUMNS (b.age_next AS b, path_length(p) AS l));

query T
SELECT bool_or(status = 'selected') FROM pgq_last_rewrite_diagnostics();
----
true

statement ok
CREATE OR REPLACE TABLE abi_gm AS FROM GRAPH_TABLE (gm MATCH p = ANY SHORTEST (a:Person)-[:Knows]->{1,2}(b:Person) WHERE a.id = 5 COLUMNS (b.age_next AS b, path_length(p) AS l));

query T
SELECT bool_or(status = 'selected') FROM pgq_last_rewrite_diagnostics();
----
true

query II
SELECT (SELECT count(*) FROM (FROM abi_gc EXCEPT ALL FROM abi_gm)) + (SELECT count(*) FROM (FROM abi_gm EXCEPT ALL FROM abi_gc)), (SELECT count(*) > 0 FROM abi_gc);
----
0	true

statement ok
SET pgq_require_abi_paths = false;

# An edge artifact answering a single hop: the edge's computed property and the endpoints' come from their relations.
statement ok
CREATE TABLE knows_d AS SELECT DISTINCT ON (src, dst) * FROM knows WHERE src <> dst ORDER BY ALL;

statement ok
CREATE TABLE knows_dm AS SELECT src, dst, w, w * 2 + 1 AS cost FROM knows_d;

statement ok
CREATE PROPERTY GRAPH gec VERTEX TABLES (person PROPERTIES (id, lower(name) AS lname) LABEL Person) EDGE TABLES (knows_d SOURCE KEY (src) REFERENCES person (id) DESTINATION KEY (dst) REFERENCES person (id) PROPERTIES (w, w * 2 + 1 AS cost) LABEL Knows);

statement ok
CREATE PROPERTY GRAPH gem VERTEX TABLES (person_m PROPERTIES (id, lname) LABEL Person) EDGE TABLES (knows_dm SOURCE KEY (src) REFERENCES person_m (id) DESTINATION KEY (dst) REFERENCES person_m (id) PROPERTIES (w, cost) LABEL Knows);

statement ok
SELECT * FROM pgq_abi_build('gec');

statement ok
SET pgq_require_abi_paths = true;

statement ok
CREATE OR REPLACE TABLE abi_gec AS FROM GRAPH_TABLE (gec MATCH (a:Person)-[k:Knows]->(b:Person) WHERE k.cost > 9 COLUMNS (a.lname AS a, k.cost AS c, b.lname AS b));

query T
SELECT bool_or(status = 'selected') FROM pgq_last_rewrite_diagnostics();
----
true

statement ok
SET pgq_require_abi_paths = false;

query II
SELECT (SELECT count(*) FROM (FROM abi_gec EXCEPT ALL FROM GRAPH_TABLE (gem MATCH (a:Person)-[k:Knows]->(b:Person) WHERE k.cost > 9 COLUMNS (a.lname AS a, k.cost AS c, b.lname AS b)))) + (SELECT count(*) FROM (FROM GRAPH_TABLE (gem MATCH (a:Person)-[k:Knows]->(b:Person) WHERE k.cost > 9 COLUMNS (a.lname AS a, k.cost AS c, b.lname AS b)) EXCEPT ALL FROM abi_gec)), (SELECT count(*) > 0 FROM abi_gec);
----
0	true

# Computed properties survive a restart.
restart

statement ok
SET active_grammar_extensions = ['duckpgq'];

query I
SELECT (SELECT count(*) FROM (FROM GRAPH_TABLE (gc MATCH (a:Person)-[k:Knows]->(b:Person) COLUMNS (a.fullname, a.age_next, b.lname, k.cost, k.arrow)) EXCEPT ALL FROM GRAPH_TABLE (gm MATCH (a:Person)-[k:Knows]->(b:Person) COLUMNS (a.fullname, a.age_next, b.lname, k.cost, k.arrow)))) + (SELECT count(*) FROM (FROM GRAPH_TABLE (gm MATCH (a:Person)-[k:Knows]->(b:Person) COLUMNS (a.fullname, a.age_next, b.lname, k.cost, k.arrow)) EXCEPT ALL FROM GRAPH_TABLE (gc MATCH (a:Person)-[k:Knows]->(b:Person) COLUMNS (a.fullname, a.age_next, b.lname, k.cost, k.arrow))));
----
0

