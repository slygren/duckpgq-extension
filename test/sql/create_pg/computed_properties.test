# name: test/sql/create_pg/computed_properties.test
# description: properties that are expressions (PROPERTIES (age + 1 AS age_next)) or renamed columns (name AS
#              fullname). Every query over such a graph equals the same query over tables holding those values as
#              columns, traversed and from ABI artifacts; the properties survive a restart.
# group: [create_pg]

require duckpgq

load {TEST_DIR}/computed_properties.db

statement ok
SET active_grammar_extensions = ['duckpgq'];

statement ok
CREATE TABLE person (id BIGINT, name VARCHAR, age INTEGER);

statement ok
INSERT INTO person VALUES (1, 'P1', 23), (2, 'P2', 28), (3, 'P3', 33), (4, 'P4', 38), (5, 'P5', 43), (6, 'P6', 48), (7, 'P7', 53), (8, 'P8', 18), (9, 'P9', 23), (10, 'P10', 28), (11, 'P11', 33), (12, 'P12', 38), (13, 'P13', 43), (14, 'P14', 48), (15, 'P15', 53), (16, 'P16', 18), (17, 'P17', 23), (18, 'P18', 28), (19, 'P19', 33), (20, 'P20', 38);

statement ok
CREATE TABLE knows (src BIGINT, dst BIGINT, w INTEGER);

statement ok
INSERT INTO knows VALUES (15, 18, 27), (15, 15, 16), (19, 7, 5), (17, 16, 20), (20, 6, 3), (15, 10, 4), (3, 18, 25), (2, 20, 12), (15, 20, 20), (6, 20, 0), (17, 3, 1), (2, 7, 28), (8, 20, 0), (15, 11, 14), (19, 7, 16), (8, 10, 15), (1, 3, 14), (9, 14, 17), (3, 9, 10), (8, 17, 9), (1, 3, 18), (4, 13, 3), (10, 13, 2), (1, 1, 6), (7, 2, 15), (13, 13, 13), (3, 19, 20), (7, 9, 10), (3, 10, 10), (1, 14, 24), (4, 5, 7), (4, 1, 1), (15, 16, 5), (18, 7, 14), (17, 7, 23), (5, 14, 20), (13, 4, 12), (14, 7, 0), (9, 19, 9), (1, 7, 5), (13, 20, 20), (19, 4, 1), (5, 7, 14), (9, 1, 24), (20, 11, 26), (10, 13, 2), (3, 3, 6), (19, 8, 0), (20, 12, 11), (20, 15, 4), (19, 16, 26), (19, 5, 27), (13, 6, 20), (5, 10, 29), (8, 20, 7), (1, 2, 3), (2, 2, 4), (5, 6, 7), (5, 6, 7);

# The computed graph, and the same values as columns.
statement ok
CREATE PROPERTY GRAPH gc VERTEX TABLES (person KEY (id) PROPERTIES (id, name AS fullname, age + 1 AS age_next, lower(name) AS lname, age % 3 = 0 AS third) LABEL Person) EDGE TABLES (knows SOURCE KEY (src) REFERENCES person DESTINATION KEY (dst) REFERENCES person PROPERTIES (w, w * 2 + 1 AS cost, src || '>' || dst AS arrow) LABEL Knows);

statement ok
CREATE TABLE person_m AS SELECT id, name AS fullname, age + 1 AS age_next, lower(name) AS lname, age % 3 = 0 AS third FROM person;

statement ok
CREATE TABLE knows_m AS SELECT src, dst, w, w * 2 + 1 AS cost, src || '>' || dst AS arrow FROM knows;

statement ok
CREATE PROPERTY GRAPH gm VERTEX TABLES (person_m PROPERTIES (id, fullname, age_next, lname, third) LABEL Person) EDGE TABLES (knows_m SOURCE KEY (src) REFERENCES person_m (id) DESTINATION KEY (dst) REFERENCES person_m (id) PROPERTIES (w, cost, arrow) LABEL Knows);

query TTT
SELECT table_name, column_aliases, property_expressions FROM __duckpgq_internal WHERE property_graph = 'gc' ORDER BY table_name;
----
knows	[w, cost, arrow]	[NULL, '((w * 2) + 1)', '((src || \'>\') || dst)']
person	[id, fullname, age_next, lname, third]	[NULL, NULL, '(age + 1)', 'lower("name")', '((age % 3) = 0)']

# Every query: the symmetric difference of the two graphs' answers is empty, and the answer is not.
query II
SELECT (SELECT count(*) FROM (FROM GRAPH_TABLE (gc MATCH (a:Person)-[k:Knows]->(b:Person) COLUMNS (a.fullname, a.age_next, b.lname, k.cost, k.arrow)) EXCEPT ALL FROM GRAPH_TABLE (gm MATCH (a:Person)-[k:Knows]->(b:Person) COLUMNS (a.fullname, a.age_next, b.lname, k.cost, k.arrow)))) + (SELECT count(*) FROM (FROM GRAPH_TABLE (gm MATCH (a:Person)-[k:Knows]->(b:Person) COLUMNS (a.fullname, a.age_next, b.lname, k.cost, k.arrow)) EXCEPT ALL FROM GRAPH_TABLE (gc MATCH (a:Person)-[k:Knows]->(b:Person) COLUMNS (a.fullname, a.age_next, b.lname, k.cost, k.arrow)))), (SELECT count(*) > 0 FROM (FROM GRAPH_TABLE (gc MATCH (a:Person)-[k:Knows]->(b:Person) COLUMNS (a.fullname, a.age_next, b.lname, k.cost, k.arrow))));
----
0	true

query II
SELECT (SELECT count(*) FROM (FROM GRAPH_TABLE (gc MATCH (a:Person)-[k:Knows]->(b:Person) WHERE a.age_next > 30 AND b.third AND k.cost < 40 COLUMNS (a.id, b.id)) EXCEPT ALL FROM GRAPH_TABLE (gm MATCH (a:Person)-[k:Knows]->(b:Person) WHERE a.age_next > 30 AND b.third AND k.cost < 40 COLUMNS (a.id, b.id)))) + (SELECT count(*) FROM (FROM GRAPH_TABLE (gm MATCH (a:Person)-[k:Knows]->(b:Person) WHERE a.age_next > 30 AND b.third AND k.cost < 40 COLUMNS (a.id, b.id)) EXCEPT ALL FROM GRAPH_TABLE (gc MATCH (a:Person)-[k:Knows]->(b:Person) WHERE a.age_next > 30 AND b.third AND k.cost < 40 COLUMNS (a.id, b.id)))), (SELECT count(*) > 0 FROM (FROM GRAPH_TABLE (gc MATCH (a:Person)-[k:Knows]->(b:Person) WHERE a.age_next > 30 AND b.third AND k.cost < 40 COLUMNS (a.id, b.id))));
----
0	true

query II
SELECT (SELECT count(*) FROM (FROM GRAPH_TABLE (gc MATCH (a:Person WHERE a.lname LIKE 'p1%')-[k:Knows WHERE k.cost > 10]->(b:Person) COLUMNS (a.id, b.fullname)) EXCEPT ALL FROM GRAPH_TABLE (gm MATCH (a:Person WHERE a.lname LIKE 'p1%')-[k:Knows WHERE k.cost > 10]->(b:Person) COLUMNS (a.id, b.fullname)))) + (SELECT count(*) FROM (FROM GRAPH_TABLE (gm MATCH (a:Person WHERE a.lname LIKE 'p1%')-[k:Knows WHERE k.cost > 10]->(b:Person) COLUMNS (a.id, b.fullname)) EXCEPT ALL FROM GRAPH_TABLE (gc MATCH (a:Person WHERE a.lname LIKE 'p1%')-[k:Knows WHERE k.cost > 10]->(b:Person) COLUMNS (a.id, b.fullname)))), (SELECT count(*) > 0 FROM (FROM GRAPH_TABLE (gc MATCH (a:Person WHERE a.lname LIKE 'p1%')-[k:Knows WHERE k.cost > 10]->(b:Person) COLUMNS (a.id, b.fullname))));
----
0	true

query II
SELECT (SELECT count(*) FROM (FROM GRAPH_TABLE (gc MATCH (a:Person)-[k:Knows]-(b:Person) WHERE a.third COLUMNS (a.id, b.age_next)) EXCEPT ALL FROM GRAPH_TABLE (gm MATCH (a:Person)-[k:Knows]-(b:Person) WHERE a.third COLUMNS (a.id, b.age_next)))) + (SELECT count(*) FROM (FROM GRAPH_TABLE (gm MATCH (a:Person)-[k:Knows]-(b:Person) WHERE a.third COLUMNS (a.id, b.age_next)) EXCEPT ALL FROM GRAPH_TABLE (gc MATCH (a:Person)-[k:Knows]-(b:Person) WHERE a.third COLUMNS (a.id, b.age_next)))), (SELECT count(*) > 0 FROM (FROM GRAPH_TABLE (gc MATCH (a:Person)-[k:Knows]-(b:Person) WHERE a.third COLUMNS (a.id, b.age_next))));
