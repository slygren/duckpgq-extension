statement error
SELECT cheapest_path_length(10, 5, 0, 12);
----
Invalid Input Error: cheapest path search: vertex 0 or 12 is not a row of the CSR

# A CSR that was never built
statement error
SELECT shortestpath(99, 5, 0, 1);
----
Constraint Error: Invalid ID

# graph_tree_json refuses lists that do not fit together, and TRY catches it
statement error
SELECT graph_tree_json([1, 2], ['a'], []);
----
Invalid Input Error: vertices and vertex_labels must have the same length

query I
SELECT TRY(graph_tree_json([1, 2], ['a'], []));
----
NULL

# A thrown error is never evaluated for a row the query filtered out: the bad vertex is only in a row the WHERE drops

statement ok
SELECT count(CREATE_CSR_EDGE(12, (SELECT count(a.id) FROM Student a),
    CAST ((SELECT sum(CREATE_CSR_VERTEX(12, (SELECT count(a.id) FROM Student a), sub.dense_id, sub.cnt))
           FROM (SELECT a.rowid AS dense_id, count(k.src) AS cnt FROM Student a
                 LEFT JOIN Know k ON k.src = a.id GROUP BY a.rowid) sub) AS BIGINT),
    (SELECT count() FROM Know k JOIN Student a ON a.id = k.src JOIN Student c ON c.id = k.dst),
    a.rowid, c.rowid, k.rowid))
FROM Know k JOIN Student a ON a.id = k.src JOIN Student c ON c.id = k.dst;

query II
SELECT x, iterativelength(12, 5, 0, x) FROM (VALUES (1::BIGINT), (2::BIGINT), (99::BIGINT)) t(x) WHERE x < 5 ORDER BY x;
----
1	1
2	1

# Nothing above invalidated the database
query I
SELECT count(*) FROM Student;
----
5
