# name: test/sql/scalar/fallible_functions.test
# description: The extension's scalar functions are marked fallible. An error one throws while it executes is the
#              error it raises (not an INTERNAL error, which invalidates the database), TRY() catches it, and the
#              optimizer does not evaluate them on rows the query does not produce. Out-of-range vertex ids, which the
#              path functions used to read memory with, are refused.
# group: [scalar]

require duckpgq

statement ok
CREATE TABLE Student(id BIGINT, name VARCHAR);

statement ok
INSERT INTO Student VALUES (0, 'Daniel'), (1, 'Tavneet'), (2, 'Gabor'), (3, 'Peter'), (4, 'David');

statement ok
CREATE TABLE Know(src BIGINT, dst BIGINT, w BIGINT);

statement ok
INSERT INTO Know VALUES (0, 1, 5), (0, 2, 2), (0, 3, 9), (3, 0, 1), (1, 2, 1), (1, 3, 1), (2, 3, 3), (4, 3, 4);

statement ok
SELECT count(CREATE_CSR_EDGE(1, (SELECT count(a.id) FROM Student a),
    CAST ((SELECT sum(CREATE_CSR_VERTEX(1, (SELECT count(a.id) FROM Student a), sub.dense_id, sub.cnt))
           FROM (SELECT a.rowid AS dense_id, count(k.src) AS cnt FROM Student a
                 LEFT JOIN Know k ON k.src = a.id GROUP BY a.rowid) sub) AS BIGINT),
    (SELECT count() FROM Know k JOIN Student a ON a.id = k.src JOIN Student c ON c.id = k.dst),
    a.rowid, c.rowid, k.rowid))
FROM Know k JOIN Student a ON a.id = k.src JOIN Student c ON c.id = k.dst;

query I
SELECT iterativelength(1, 5, 0, 3);
----
1

statement ok
SELECT count(CREATE_CSR_EDGE(2, (SELECT count(a.id) FROM Student a),
    CAST ((SELECT sum(CREATE_CSR_VERTEX(2, (SELECT count(a.id) FROM Student a), sub.dense_id, sub.cnt))
           FROM (SELECT a.rowid AS dense_id, count(k.src) AS cnt FROM Student a
                 LEFT JOIN Know k ON k.src = a.id GROUP BY a.rowid) sub) AS BIGINT),
    (SELECT count() FROM Know k JOIN Student a ON a.id = k.src JOIN Student c ON c.id = k.dst),
    a.rowid, c.rowid, k.rowid))
FROM Know k JOIN Student a ON a.id = k.src JOIN Student c ON c.id = k.dst;

statement error
SELECT iterativelength(2, 5, 0, 99);
----
Invalid Input Error: iterativelength: vertex 99 is not a row of the CSR

statement ok
SELECT count(CREATE_CSR_EDGE(3, (SELECT count(a.id) FROM Student a),
    CAST ((SELECT sum(CREATE_CSR_VERTEX(3, (SELECT count(a.id) FROM Student a), sub.dense_id, sub.cnt))
           FROM (SELECT a.rowid AS dense_id, count(k.src) AS cnt FROM Student a
                 LEFT JOIN Know k ON k.src = a.id GROUP BY a.rowid) sub) AS BIGINT),
    (SELECT count() FROM Know k JOIN Student a ON a.id = k.src JOIN Student c ON c.id = k.dst),
    a.rowid, c.rowid, k.rowid))
FROM Know k JOIN Student a ON a.id = k.src JOIN Student c ON c.id = k.dst;

query I
SELECT TRY(iterativelength(3, 5, 0, 99));
----
NULL

