# name: test/sql/scalar/pagerank.test
# description: Testing the pagerank implementation
# group: [scalar]

require duckpgq

# The SQL/PGQ grammar is connection-local and must be activated explicitly.
statement ok
SET active_grammar_extensions = ['duckpgq'];

statement ok
CREATE TABLE Student(id BIGINT, name VARCHAR);INSERT INTO Student VALUES (0, 'Daniel'), (1, 'Tavneet'), (2, 'Gabor'), (3, 'Peter'), (4, 'David');

statement ok
CREATE TABLE know(src BIGINT, dst BIGINT, createDate BIGINT);INSERT INTO know VALUES (0,1, 10), (0,2, 11), (0,3, 12), (3,0, 13), (1,2, 14), (1,3, 15), (2,3, 16), (4,3, 17);

statement ok
CREATE PROPERTY GRAPH pg
VERTEX TABLES (
    Student
    )
EDGE TABLES (
    know    SOURCE KEY ( src ) REFERENCES Student ( id )
            DESTINATION KEY ( dst ) REFERENCES Student ( id )
    );

# networkx.pagerank (same iteration, damping 0.85, tolerance 1e-6) gives these values. Before the shared machinery
# the iteration also ran over the CSR's two padding slots, as two phantom dangling vertices, and every value came out
# 0.943 of these (0.0283 for vertex 4).
query II
select id, round(pagerank, 10) from pagerank(pg, student, know) ORDER BY id;
----
0	0.3256587646
1	0.1222702859
2	0.1742354796
3	0.3478354698
4	0.03


statement ok
CREATE OR REPLACE TABLE Student (
    id BIGINT
);

statement ok
INSERT INTO Student (id) VALUES
(0),
(1),
(2),
(3),
(4);

statement ok
CREATE OR REPLACE TABLE know (
    src BIGINT,
    dst BIGINT,
    edge BIGINT
);

statement ok
INSERT INTO know (src, dst, edge) VALUES
(2, 1, 4),
(3, 1, 5),
(3, 2, 6),
(1, 2, 4),
(1, 0, 0),
(2, 0, 1),
(3, 0, 2),
(0, 1, 0),
(4, 3, 7),
(0, 3, 3),
(1, 3, 5),
(2, 3, 6),
(3, 4, 7),
(0, 2, 1);

statement ok
CREATE OR REPLACE PROPERTY GRAPH pg
VERTEX TABLES (
    Student
    )
EDGE TABLES (
    know    SOURCE KEY ( src ) REFERENCES Student ( id )
            DESTINATION KEY ( dst ) REFERENCES Student ( id )
    );

query II
select id, round(pagerank, 10) from pagerank(pg, student, know) ORDER BY id;
----
0	0.208527312
1	0.208527312
2	0.208527312
3	0.2840563912
4	0.0903616729

# Options, as networkx.pagerank's alpha / max_iter / tol.
query I
select round(sum(pagerank), 10) from pagerank(pg, student, know, damping := 0.5, tolerance := 1e-10);
----
1.0

query II
select id, round(pagerank, 10) from pagerank(pg, student, know, damping := 0) ORDER BY id;
----
0	0.2
1	0.2
2	0.2
3	0.2
4	0.2

statement error
select * from pagerank(pg, student, know, max_iterations := 3);
----
Invalid Input Error: pagerank: did not converge within 3 iterations

statement error
select * from pagerank(pg, student, know, damping := 1.5);
----
Invalid Input Error: pagerank: damping must be between 0 and 1, not 1.5

# Deleted vertex rows leave rowid gaps, which are not vertices: the ranks still sum to 1 over the 4 left.
statement ok
DELETE FROM Student WHERE id = 4;

statement ok
DELETE FROM know WHERE src = 4 OR dst = 4;

query II
select count(*), round(sum(pagerank), 10) from pagerank(pg, student, know);
----
4	1.0

# No edges: uniform.
statement ok
DELETE FROM know;

query II
select id, pagerank from pagerank(pg, student, know) ORDER BY id;
----
0	0.25
1	0.25
2	0.25
3	0.25