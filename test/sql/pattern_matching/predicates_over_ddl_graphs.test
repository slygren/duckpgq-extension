# name: test/sql/pattern_matching/predicates_over_ddl_graphs.test
# description: Round 3's pattern features (label expressions over several tables, unlabeled multi-table elements,
#              quantified edges across vertex tables, labels(), IS LABELED, PROPERTY_EXISTS, SAME, IS SOURCE OF,
#              selectors) on a graph that uses round 3's DDL: element tables that are views with KEY, extra labels
#              (LABEL Person LABEL Human), renamed and computed properties. Every answer equals the same query over a
#              twin graph of plain tables with one label each, its extra labels written as the main ones -- traversed,
#              and again with ABI artifacts built for both.
# group: [pattern_matching]

require duckpgq

statement ok
SET active_grammar_extensions = ['duckpgq'];

statement ok
CREATE TABLE person_t AS SELECT * FROM (VALUES (1, 'ann', 30), (2, 'bob', 41), (3, 'cy', 25), (4, 'dee', 52)) t(id, name, age) ORDER BY id;

statement ok
CREATE TABLE city_t AS SELECT * FROM (VALUES (10, 'oslo'), (11, 'rome')) t(cid, cname) ORDER BY cid;

statement ok
CREATE TABLE knows_t AS SELECT * FROM (VALUES (1, 2, 5), (2, 3, 1), (3, 1, 2), (1, 3, 7), (3, 4, 1)) t(src, dst, w);

statement ok
CREATE TABLE lives_t AS SELECT * FROM (VALUES (1, 10), (2, 10), (4, 11)) t(p, c);

# The plain twin: the computed and renamed properties materialized, one label per table
statement ok
CREATE TABLE person_p AS SELECT id, name AS pname, age + 1 AS age_next FROM person_t ORDER BY id;

statement ok
CREATE PROPERTY GRAPH gp
VERTEX TABLES (person_p PROPERTIES (id, pname, age_next) LABEL Person, city_t LABEL City)
EDGE TABLES (
    knows_t SOURCE KEY (src) REFERENCES person_p (id) DESTINATION KEY (dst) REFERENCES person_p (id) PROPERTIES (w) LABEL Knows,
    lives_t SOURCE KEY (p) REFERENCES person_p (id) DESTINATION KEY (c) REFERENCES city_t (cid) LABEL LivesIn);

# The DDL graph: views, KEY, extra labels, a renamed and a computed property
statement ok
CREATE VIEW person_v AS FROM person_t;

statement ok
CREATE VIEW city_v AS FROM city_t;

statement ok
CREATE VIEW knows_v AS FROM knows_t;

statement ok
CREATE VIEW lives_v AS FROM lives_t;

statement ok
CREATE PROPERTY GRAPH gd
VERTEX TABLES (
    person_v KEY (id) PROPERTIES (id, name AS pname, age + 1 AS age_next) LABEL Person LABEL Human NO PROPERTIES,
    city_v KEY (cid) LABEL City LABEL Place)
EDGE TABLES (
    knows_v SOURCE KEY (src) REFERENCES person_v (id) DESTINATION KEY (dst) REFERENCES person_v (id) PROPERTIES (w) LABEL Knows LABEL Friend NO PROPERTIES,
    lives_v SOURCE KEY (p) REFERENCES person_v (id) DESTINATION KEY (c) REFERENCES city_v (cid) LABEL LivesIn);

# labels(), IS LABELED and PROPERTY_EXISTS read the DDL: every static label, property names as declared
query ITTTTTTT
FROM GRAPH_TABLE (gd MATCH (x:Human|Place)
    COLUMNS (element_id(x) AS e, label(x) AS l, labels(x) AS ls, x IS LABELED Human AS human, x IS NOT LABELED Place AS not_place,
             PROPERTY_EXISTS(x, age_next) AS has_age_next, PROPERTY_EXISTS(x, pname) AS has_pname, PROPERTY_EXISTS(x, cname) AS has_cname))
ORDER BY l, e;
----
0	City	[City, Place]	false	false	false	false	true
1	City	[City, Place]	false	false	false	false	true
0	Person	[Person, Human]	true	true	true	true	false
1	Person	[Person, Human]	true	true	true	true	false
2	Person	[Person, Human]	true	true	true	true	false
3	Person	[Person, Human]	true	true	true	true	false

query I
FROM GRAPH_TABLE (gd MATCH (x) WHERE x IS LABELED Friend OR x IS LABELED Human COLUMNS (x.id AS id)) ORDER BY id;
----
1
2
3
4

loop pass 0 2

# ── Label expressions over several tables, unlabeled elements, a computed property read across tables ─────────────
statement ok
CREATE OR REPLACE TABLE rd AS FROM GRAPH_TABLE (gd MATCH (x:Human|Place) COLUMNS (label(x) AS l, element_id(x) AS e, x.age_next AS a, x.pname AS n));

statement ok
CREATE OR REPLACE TABLE rp AS FROM GRAPH_TABLE (gp MATCH (x:Person|City) COLUMNS (label(x) AS l, element_id(x) AS e, x.age_next AS a, x.pname AS n));

query II
SELECT (SELECT count(*) FROM rd), (SELECT count(*) FROM ((FROM rd EXCEPT ALL FROM rp) UNION ALL (FROM rp EXCEPT ALL FROM rd)));
----
6	0

statement ok
CREATE OR REPLACE TABLE rd AS FROM GRAPH_TABLE (gd MATCH (x:!Human) COLUMNS (label(x) AS l, element_id(x) AS e));

statement ok
CREATE OR REPLACE TABLE rp AS FROM GRAPH_TABLE (gp MATCH (x:!Person) COLUMNS (label(x) AS l, element_id(x) AS e));

query II
SELECT (SELECT count(*) FROM rd), (SELECT count(*) FROM ((FROM rd EXCEPT ALL FROM rp) UNION ALL (FROM rp EXCEPT ALL FROM rd)));
----
2	0

statement ok
CREATE OR REPLACE TABLE rd AS FROM GRAPH_TABLE (gd MATCH (a:Human)-[e]->(x) COLUMNS (a.id AS a, label(e) AS le, label(x) AS lx, element_id(x) AS x));

statement ok
CREATE OR REPLACE TABLE rp AS FROM GRAPH_TABLE (gp MATCH (a:Person)-[e]->(x) COLUMNS (a.id AS a, label(e) AS le, label(x) AS lx, element_id(x) AS x));

query II
SELECT (SELECT count(*) FROM rd), (SELECT count(*) FROM ((FROM rd EXCEPT ALL FROM rp) UNION ALL (FROM rp EXCEPT ALL FROM rd)));
----
8	0

# ── A quantified edge whose walks cross vertex tables (one id space over the views) ──────────────────────────────────
statement ok
CREATE OR REPLACE TABLE rd AS FROM GRAPH_TABLE (gd MATCH p = (a:Human)-[e:Friend|LivesIn]->{1,3}(b)
    COLUMNS (a.id AS a, label(b) AS lb, element_id(b) AS b, path_length(p) AS len, vertex_labels(p) AS vl, edge_labels(p) AS el));

statement ok
CREATE OR REPLACE TABLE rp AS FROM GRAPH_TABLE (gp MATCH p = (a:Person)-[e:Knows|LivesIn]->{1,3}(b)
    COLUMNS (a.id AS a, label(b) AS lb, element_id(b) AS b, path_length(p) AS len, vertex_labels(p) AS vl, edge_labels(p) AS el));

query II
SELECT (SELECT count(*) FROM rd) > 10, (SELECT count(*) FROM ((FROM rd EXCEPT ALL FROM rp) UNION ALL (FROM rp EXCEPT ALL FROM rd)));
----
true	0

statement ok
CREATE OR REPLACE TABLE rd AS FROM GRAPH_TABLE (gd MATCH ANY SHORTEST (a:Human)-[e:Friend|LivesIn]->{1,3}(b:Place) WHERE a.id = 3
    COLUMNS (element_id(b) AS b, b.cname AS c));

statement ok
CREATE OR REPLACE TABLE rp AS FROM GRAPH_TABLE (gp MATCH ANY SHORTEST (a:Person)-[e:Knows|LivesIn]->{1,3}(b:City) WHERE a.id = 3
    COLUMNS (element_id(b) AS b, b.cname AS c));

query II
SELECT (SELECT count(*) FROM rd), (SELECT count(*) FROM ((FROM rd EXCEPT ALL FROM rp) UNION ALL (FROM rp EXCEPT ALL FROM rd)));
----
2	0

# ── SAME, IS SOURCE OF, selectors over one table with extra labels and computed properties ──────────────────────────
statement ok
CREATE OR REPLACE TABLE rd AS FROM GRAPH_TABLE (gd MATCH (a:Human)-[e:Friend]->(b:Human), (c:Human)-[f:Knows]->(d:Person)
    WHERE SAME(a, c) AND a IS SOURCE OF f AND b IS DESTINATION OF e AND b.age_next > 26
    COLUMNS (a.pname AS a, b.pname AS b, d.pname AS d));

statement ok
CREATE OR REPLACE TABLE rp AS FROM GRAPH_TABLE (gp MATCH (a:Person)-[e:Knows]->(b:Person), (c:Person)-[f:Knows]->(d:Person)
    WHERE SAME(a, c) AND a IS SOURCE OF f AND b IS DESTINATION OF e AND b.age_next > 26
    COLUMNS (a.pname AS a, b.pname AS b, d.pname AS d));

query II
SELECT (SELECT count(*) FROM rd), (SELECT count(*) FROM ((FROM rd EXCEPT ALL FROM rp) UNION ALL (FROM rp EXCEPT ALL FROM rd)));
----
6	0

statement ok
CREATE OR REPLACE TABLE rd AS FROM GRAPH_TABLE (gd MATCH p = SHORTEST 2 GROUPS (a:Human)-[e:Friend]->{1,3}(b:Human) WHERE a.id = 1
    COLUMNS (b.pname AS b, path_length(p) AS len, vertices(p) AS v));

statement ok
CREATE OR REPLACE TABLE rp AS FROM GRAPH_TABLE (gp MATCH p = SHORTEST 2 GROUPS (a:Person)-[e:Knows]->{1,3}(b:Person) WHERE a.id = 1
    COLUMNS (b.pname AS b, path_length(p) AS len, vertices(p) AS v));

query II
SELECT (SELECT count(*) FROM rd) > 3, (SELECT count(*) FROM ((FROM rd EXCEPT ALL FROM rp) UNION ALL (FROM rp EXCEPT ALL FROM rd)));
----
true	0

statement ok
CREATE OR REPLACE TABLE rd AS FROM GRAPH_TABLE (gd MATCH p = ANY 2 (a:Human)-[e:Friend]->{1,3}(b:Human) WHERE a.id = 1
    COLUMNS (b.pname AS b));

statement ok
CREATE OR REPLACE TABLE rp AS FROM GRAPH_TABLE (gp MATCH p = ANY 2 (a:Person)-[e:Knows]->{1,3}(b:Person) WHERE a.id = 1
    COLUMNS (b.pname AS b));

query II
SELECT (SELECT count(*) FROM rd) > 0, (SELECT count(*) FROM ((FROM rd EXCEPT ALL FROM rp) UNION ALL (FROM rp EXCEPT ALL FROM rd)));
----
true	0

# The second pass with ABI artifacts for both graphs
statement ok
SELECT count(*) FROM pgq_abi_build('gd', max_hops := 2, closures := ['Knows']);

statement ok
SELECT count(*) FROM pgq_abi_build('gp', max_hops := 2, closures := ['Knows']);

endloop
