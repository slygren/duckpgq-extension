# name: test/sql/pattern_matching/path_modes.test
# description: Testing path modes: TRAIL, ACYCLIC, SIMPLE are now implemented
# group: [pattern_matching]

#statement ok
#pragma enable_verification

require duckpgq


statement ok
SET active_grammar_extensions = ['duckpgq'];

statement ok
CREATE TABLE Student(id BIGINT, name VARCHAR);

statement ok
CREATE TABLE know(src BIGINT, dst BIGINT, createDate BIGINT);

statement ok
CREATE TABLE School(name VARCHAR, Id BIGINT, Kind VARCHAR);

statement ok
CREATE TABLE StudyAt(personId BIGINT, schoolId BIGINT);

statement ok
INSERT INTO Student VALUES (0, 'Daniel'), (1, 'Tavneet'), (2, 'Gabor'), (3, 'Peter'), (4, 'David');

statement ok
INSERT INTO know VALUES (0,1, 10), (0,2, 11), (0,3, 12), (3,0, 13), (1,2, 14), (1,3, 15), (2,3, 16), (4,3, 17);

statement ok
INSERT INTO School VALUES ('VU', 0, 'University'), ('UVA', 1, 'University');

statement ok
INSERT INTO StudyAt VALUES (0, 0), (1, 0), (2, 1), (3, 1), (4, 1);

statement ok
CREATE PROPERTY GRAPH pg
VERTEX TABLES (
    Student PROPERTIES ( id, name ) LABEL Person,
    School LABEL SCHOOL
    )
EDGE TABLES (
    know    SOURCE KEY ( src ) REFERENCES Student ( id )
            DESTINATION KEY ( dst ) REFERENCES Student ( id )
            LABEL Knows,
    studyAt SOURCE KEY ( personId ) REFERENCES Student ( id )
            DESTINATION KEY ( SchoolId ) REFERENCES School ( id )
            LABEL StudyAt
    );

#statement ok
#-FROM GRAPH_TABLE (pg
#    MATCH
#    p = ANY SHORTEST WALK PATH (a:Person)-[k:knows]-> *(b:Person)
#    WHERE a.name = 'Daniel'
#    COLUMNS (p, a.name as name, b.name as school)
#    ) study;

#statement ok
#-FROM GRAPH_TABLE (pg
#    MATCH
#    p = ANY SHORTEST (a:Person)-[k:knows]-> *(b:Person)
#    WHERE a.name = 'Daniel'
#    COLUMNS (p, a.name as name, b.name as school)
#    ) study;

query II
SELECT name, school FROM GRAPH_TABLE (pg
    MATCH
    p = ALL SHORTEST (a:Person)-[k:knows]-> *(b:Person)
    WHERE a.name = 'Daniel'
    COLUMNS (a.name as name, b.name as school)
    ) study ORDER BY school;
----
Daniel	Daniel
Daniel	Gabor
Daniel	Peter
Daniel	Tavneet

# (a trail may return to its start: Daniel -> Peter -> Daniel uses no edge twice)
query II
SELECT name, school FROM GRAPH_TABLE (pg
    MATCH
    p = ANY SHORTEST TRAIL (a:Person)-[k:knows]->{1,4}(b:Person)
    WHERE a.name = 'Daniel'
    COLUMNS (a.name as name, b.name as school)
    ) study ORDER BY school;
----
Daniel	Daniel
Daniel	Gabor
Daniel	Peter
Daniel	Tavneet

query II
SELECT name, school FROM GRAPH_TABLE (pg
    MATCH
    p = ANY SHORTEST ACYCLIC (a:Person)-[k:knows]->{1,4}(b:Person)
    WHERE a.name = 'Daniel'
    COLUMNS (a.name as name, b.name as school)
    ) study ORDER BY school;
----
Daniel	Gabor
Daniel	Peter
Daniel	Tavneet

query II
SELECT name, school FROM GRAPH_TABLE (pg
    MATCH
    p = ANY SHORTEST SIMPLE (a:Person)-[k:knows]->{1,4}(b:Person)
    WHERE a.name = 'Daniel'
    COLUMNS (a.name as name, b.name as school)
    ) study ORDER BY school;
----
Daniel	Daniel
Daniel	Gabor
Daniel	Peter
Daniel	Tavneet

## https://github.com/cwida/duckpgq-extension/issues/46: SHORTEST k, the k shortest walks per pair (a walk may
## come back to Daniel: 0-3-0, 0-1-3-0, 0-2-3-0, 0-1-2-3-0, 0-3-0-3-0; Tavneet has only four within 4 steps)
query II
SELECT school, count(*) FROM GRAPH_TABLE (pg
    MATCH
    p = SHORTEST 5 (a:Person)-[k:knows]->{1,4}(b:Person)
    WHERE a.name = 'Daniel'
    COLUMNS (a.name as name, b.name as school)
    ) study GROUP BY ALL ORDER BY ALL;
----
Daniel	5
Gabor	5
Peter	5
Tavneet	4



