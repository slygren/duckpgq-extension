+def render_reverse_twin(catalog: str, abi_schema: str, row: dict[str, Any]) -> tuple[str, dict[str, Any]]:
+    """Reverse-sorted twin of an artifact: identical rows, ordered by the destination key.
+
+    Every artifact is ordered by v0, so a destination-anchored lookup ("which tags feed this
+    work order", or any <- pattern) filters v1 against a v0-ordered file and prunes nothing.
+    The twin gives those queries something to prune on. The binder picks it automatically
+    when only the destination endpoint is bound (is_sorted_by_v1 in __pgq_path_catalog).
+
+    Costs a second copy of the family, so enable it per relationship via
+    access_policy.abi.reverse_sorted_twins rather than globally.
+    """
+    twin_name = f"{row['path_table_name']}__rev"
+    twin_table = relation(catalog, abi_schema, twin_name)
+    sql = (
+        f"DROP TABLE IF EXISTS {twin_table};\n"
+        f"CREATE TABLE {twin_table} AS SELECT * FROM {row['full_table']} ORDER BY v1;\n"
+    )
+    twin_row = dict(row)
+    twin_row["path_table_name"] = twin_name
+    twin_row["full_table"] = twin_table
+    twin_row["is_sorted_by_v0"] = False
+    twin_row["is_sorted_by_v1"] = True
+    return sql, twin_row
 
 
