# SQL/PGQ GRAPH_TABLE additions to DuckDB's native grammar.
# Built-in rules are referenced directly; no DuckDB grammar is copied here.
# Keep each rule on one line; CMake embeds them in a header at configure time.

DuckPGQGraphTable <- DuckPGQGraphTableKeyword '(' QualifiedName DuckPGQMatchBlock DuckPGQColumns? DuckPGQUnionBranch* DuckPGQColumns? ')' TableAlias?
# One MATCH block. Each OPTIONAL MATCH group left-joins onto the mandatory patterns; the WHERE follows all of them.
DuckPGQMatchBlock <- 'MATCH' List(DuckPGQPathPattern) DuckPGQOptionalMatch* DuckPGQOneRowPer? WhereClause?
DuckPGQOptionalMatch <- 'OPTIONAL' 'MATCH' List(DuckPGQPathPattern)
# Further MATCH blocks combined with the first. Either each block has its own COLUMNS, or only the last one does and
# all blocks share it.
DuckPGQUnionBranch <- 'UNION' 'ALL'? DuckPGQMatchBlock DuckPGQColumns?

# ONE ROW PER VERTEX (v), ONE ROW PER EDGE (e) or ONE ROW PER STEP (v1, e, v2) unnests the matched paths.
DuckPGQOneRowPer <- 'ONE' 'ROW' 'PER' DuckPGQOneRowPerTarget
DuckPGQOneRowPerTarget <- DuckPGQOneRowPerVertex / DuckPGQOneRowPerEdge / DuckPGQOneRowPerStep
DuckPGQOneRowPerVertex <- 'VERTEX' Parens(Identifier)
DuckPGQOneRowPerEdge <- 'EDGE' Parens(Identifier)
DuckPGQOneRowPerStep <- 'STEP' Parens(List(Identifier))
DuckPGQGraphTableKeyword <- 'GRAPH_TABLE' / ('GRAPH' 'TABLE')
DuckPGQColumns <- 'COLUMNS' Parens(TargetList)

# A path pattern: optional path variable, search prefix and path mode, then the element sequence. Further sequences
# after '|' (path pattern union) or '|+|' (multiset alternation) are alternatives binding the same variables.
DuckPGQPathPattern <- DuckPGQPathVariable? DuckPGQSearchPrefix? DuckPGQPathMode? DuckPGQPathSequence DuckPGQPathUnionOperand*
DuckPGQPathUnionOperand <- DuckPGQPathUnionOperator DuckPGQPathSequence
DuckPGQPathUnionOperator <- '|+|' / ('|' '+' '|') / '|'
DuckPGQPathVariable <- Identifier '='
DuckPGQSearchPrefix <- DuckPGQAllShortest / DuckPGQAnyShortest / DuckPGQTopKShortest / DuckPGQAllCheapest / DuckPGQAnyCheapest
DuckPGQAllShortest <- 'ALL' 'SHORTEST'
DuckPGQAnyShortest <- 'ANY' 'SHORTEST'
DuckPGQTopKShortest <- 'SHORTEST' NumberLiteral
DuckPGQAllCheapest <- 'ALL' 'CHEAPEST'
DuckPGQAnyCheapest <- 'ANY' 'CHEAPEST'
DuckPGQPathMode <- 'WALK' / 'TRAIL' / 'SIMPLE' / 'ACYCLIC'
DuckPGQPathSequence <- DuckPGQPathStart DuckPGQEdgeVertex*
DuckPGQPathStart <- DuckPGQGroupStep / DuckPGQVertex
DuckPGQEdgeVertex <- DuckPGQEdgeVertexStep / DuckPGQGroupStep
# A group may be followed directly by a vertex pattern: (t) ((a)-[e]->(b)){1,3} (z).
DuckPGQGroupStep <- DuckPGQParenthesizedPath DuckPGQVertex?
DuckPGQEdgeVertexStep <- DuckPGQEdge DuckPGQPathStart
# A parenthesized path pattern with an optional WHERE and quantifier: ((a)-[e]->(b) WHERE e.w > 1){1,3}, also
# written with brackets [(a)-[e]->(b)]{1,3}. Adjacent vertex patterns are one vertex, so the group continues the
# path from the vertex before it.
DuckPGQParenthesizedPath <- DuckPGQPathGroupBody DuckPGQQuantifier?
DuckPGQPathGroupBody <- DuckPGQPathGroupParens / DuckPGQPathGroupBrackets
DuckPGQPathGroupParens <- '(' DuckPGQPathPattern WhereClause? ')'
DuckPGQPathGroupBrackets <- '[' DuckPGQPathPattern WhereClause? ']'
DuckPGQEdge <- DuckPGQQuantifiedEdge / DuckPGQAbbreviatedEdge

# Edges with optional quantifiers. The tokenizer reads "->*", "->?", "-*" and "-?" as one operator token, so those
# fused endpoint/quantifier spellings are accepted as a unit.
DuckPGQQuantifiedEdge <- DuckPGQEdgeLeft DuckPGQEdgeBody DuckPGQEdgeTail
DuckPGQEdgeLeft <- ('<' '-') / '-'
DuckPGQEdgeTail <- DuckPGQFusedTail / (DuckPGQEdgeRight DuckPGQQuantifier?)
DuckPGQFusedTail <- '->*' / '->?' / '-*' / '-?'
DuckPGQEdgeRight <- ('-' '>') / '->' / '-'
DuckPGQQuantifier <- DuckPGQFixedQuantifier / DuckPGQRangeQuantifier / '*' / '+' / '?'
DuckPGQFixedQuantifier <- '{' NumberLiteral '}'
DuckPGQRangeQuantifier <- '{' NumberLiteral? ',' NumberLiteral? '}'

# An abbreviated edge is an arrow without a body: an anonymous edge with any label. Arrows may contain spaces.
# The tokenizer fuses a trailing '*' into the arrow ("<-*", "->*"), so those spellings are accepted as a unit.
DuckPGQAbbreviatedEdge <- DuckPGQAbbreviatedFused / (DuckPGQAbbreviatedArrow DuckPGQQuantifier?)
DuckPGQAbbreviatedFused <- '<->*' / ('<' '->*') / ('<' '-' '>*') / '<-*' / ('<' '-*') / '->*' / ('-' '>*') / '-*'
DuckPGQAbbreviatedArrow <- DuckPGQArrowBoth / DuckPGQArrowLeft / DuckPGQArrowRight / DuckPGQArrowAny
DuckPGQArrowBoth <- '<->' / ('<' '->') / ('<' '-' '>')
DuckPGQArrowLeft <- '<' '-'
DuckPGQArrowRight <- '->' / ('-' '>')
DuckPGQArrowAny <- '-'

# Vertex and edge element bodies. The variable and the label are both optional: an anonymous element gets a
# generated variable, and an unlabeled element matches any label.
DuckPGQVertex <- '(' Identifier? DuckPGQElementLabel? WhereClause? DuckPGQCost? ')'
DuckPGQEdgeBody <- '[' Identifier? DuckPGQElementLabel? DuckPGQCypherQuantifier? WhereClause? DuckPGQCost? ']'
# Cypher's quantifier inside the edge body: -[:R*1..5]->, -[:R*]->, -[:R*2]->, -[:R*..3]->, -[:R*1..]->. The tokenizer
# reads "1..5", "..3" and "1.." as one number token, which NumberLiteral rejects; DuckPGQCypherRange is a terminal
# that accepts those tokens (its body here is a placeholder for the matcher that replaces it).
DuckPGQCypherQuantifier <- '*' DuckPGQCypherRange*
DuckPGQCypherRange <- NumberLiteral
# The cost of traversing an element in a CHEAPEST path, and the cost used where the expression is NULL.
DuckPGQCost <- 'COST' Expression DuckPGQCostDefault?
DuckPGQCostDefault <- 'DEFAULT' NumberLiteral
DuckPGQElementLabel <- (':' / 'IS') DuckPGQLabelExpression

# Label expressions: '!' binds tightest, then '&', then '|'. The tokenizer reads "|!" and "&!" as one operator token,
# so those spellings negate the operand that follows them.
DuckPGQLabelExpression <- DuckPGQLabelTerm DuckPGQLabelOrTail*
DuckPGQLabelOrTail <- DuckPGQLabelOrNegated / DuckPGQLabelOrPlain
DuckPGQLabelOrPlain <- '|' DuckPGQLabelTerm
DuckPGQLabelOrNegated <- '|!' DuckPGQLabelTerm
DuckPGQLabelTerm <- DuckPGQLabelFactor DuckPGQLabelAndTail*
DuckPGQLabelAndTail <- DuckPGQLabelAndNegated / DuckPGQLabelAndPlain
DuckPGQLabelAndPlain <- '&' DuckPGQLabelFactor
DuckPGQLabelAndNegated <- '&!' DuckPGQLabelFactor
DuckPGQLabelFactor <- DuckPGQLabelNegation / DuckPGQLabelParens / ColId
DuckPGQLabelNegation <- '!' DuckPGQLabelFactor
DuckPGQLabelParens <- '(' DuckPGQLabelExpression ')'

# Expressions, available wherever the grammar extension is active. IS LABELED and EXISTS { } are bound only inside a
# GRAPH_TABLE; a property projection v.{a, b} or v.link.{a, b} is shorthand for struct_pack(a := v.a, b := v.b).
DuckPGQIsLabeled <- ColId 'IS' 'NOT'? 'LABELED' ColId
DuckPGQExistsPattern <- 'EXISTS' '{' List(DuckPGQPathPattern) WhereClause? '}'
DuckPGQPropertyProjection <- ColId DuckPGQProjectionLink? '.' '{' List(ColId) '}'
DuckPGQProjectionLink <- '.' ColId
