# SQL/PGQ GRAPH_TABLE additions to DuckDB's native grammar.
# Built-in rules are referenced directly; no DuckDB grammar is copied here.
# Keep each rule on one line; CMake embeds them in a header at configure time.

DuckPGQGraphTable <- DuckPGQGraphTableKeyword '(' QualifiedName 'MATCH' List(DuckPGQPathPattern) DuckPGQOptionalMatch* WhereClause? DuckPGQColumns? ')' TableAlias?
# Each OPTIONAL MATCH group left-joins onto the mandatory patterns; the graph-level WHERE follows all of them.
DuckPGQOptionalMatch <- 'OPTIONAL' 'MATCH' List(DuckPGQPathPattern)
DuckPGQGraphTableKeyword <- 'GRAPH_TABLE' / ('GRAPH' 'TABLE')
DuckPGQColumns <- 'COLUMNS' Parens(TargetList)

# A path pattern: optional path variable, search prefix and path mode, then the element sequence.
DuckPGQPathPattern <- DuckPGQPathVariable? DuckPGQSearchPrefix? DuckPGQPathMode? DuckPGQPathSequence
DuckPGQPathVariable <- Identifier '='
DuckPGQSearchPrefix <- DuckPGQAllShortest / DuckPGQAnyShortest / DuckPGQTopKShortest
DuckPGQAllShortest <- 'ALL' 'SHORTEST'
DuckPGQAnyShortest <- 'ANY' 'SHORTEST'
DuckPGQTopKShortest <- 'SHORTEST' NumberLiteral
DuckPGQPathMode <- 'WALK' / 'TRAIL' / 'SIMPLE' / 'ACYCLIC'
DuckPGQPathSequence <- DuckPGQVertex DuckPGQEdgeVertex*
DuckPGQEdgeVertex <- DuckPGQQuantifiedEdge DuckPGQVertex

# Edges with optional quantifiers. The tokenizer reads "->*", "->?", "-*" and "-?" as one operator token, so those
# fused endpoint/quantifier spellings are accepted as a unit.
DuckPGQQuantifiedEdge <- DuckPGQEdgeLeft DuckPGQEdgeBody DuckPGQEdgeTail
DuckPGQEdgeLeft <- ('<' '-') / '-'
DuckPGQEdgeTail <- DuckPGQFusedTail / (DuckPGQEdgeRight DuckPGQQuantifier?)
DuckPGQFusedTail <- '->*' / '->?' / '-*' / '-?'
DuckPGQEdgeRight <- ('-' '>') / '->' / '-'
DuckPGQQuantifier <- DuckPGQFixedQuantifier / DuckPGQRangeQuantifier / '*' / '+' / '?'
DuckPGQFixedQuantifier <- '{' NumberLiteral '}'
DuckPGQRangeQuantifier <- '{' NumberLiteral? ',' NumberLiteral? '}'

# Vertex and edge element bodies. The variable and the label are both optional: an anonymous element gets a
# generated variable, and an unlabeled element matches any label.
DuckPGQVertex <- '(' Identifier? DuckPGQElementLabel? WhereClause? ')'
DuckPGQEdgeBody <- '[' Identifier? DuckPGQElementLabel? WhereClause? ']'
DuckPGQElementLabel <- (':' / 'IS') DuckPGQLabelExpression

# Label expressions: '!' binds tightest, then '&', then '|'. The tokenizer reads "|!" and "&!" as one operator token,
# so those spellings negate the operand that follows them.
DuckPGQLabelExpression <- DuckPGQLabelTerm DuckPGQLabelOrTail*
DuckPGQLabelOrTail <- DuckPGQLabelOrNegated / DuckPGQLabelOrPlain
DuckPGQLabelOrPlain <- '|' DuckPGQLabelTerm
DuckPGQLabelOrNegated <- '|!' DuckPGQLabelTerm
DuckPGQLabelTerm <- DuckPGQLabelFactor DuckPGQLabelAndTail*
DuckPGQLabelAndTail <- DuckPGQLabelAndNegated / DuckPGQLabelAndPlain
DuckPGQLabelAndPlain <- '&' DuckPGQLabelFactor
DuckPGQLabelAndNegated <- '&!' DuckPGQLabelFactor
DuckPGQLabelFactor <- DuckPGQLabelNegation / DuckPGQLabelParens / ColId
DuckPGQLabelNegation <- '!' DuckPGQLabelFactor
DuckPGQLabelParens <- '(' DuckPGQLabelExpression ')'
