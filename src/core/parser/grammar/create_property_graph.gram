# SQL/PGQ CREATE PROPERTY GRAPH additions to DuckDB's native grammar.
# Built-in rules are referenced directly; no DuckDB grammar is copied here.
# Keep each rule on one line; CMake embeds them in a header at configure time.

DuckPGQCreatePropertyGraph <- 'CREATE' OrReplace? 'PROPERTY' 'GRAPH' IfNotExists? QualifiedName DuckPGQVertexTables DuckPGQEdgeTables? DuckPGQAbiClause?

# What pgq_abi_build builds for the graph, with the option names of pgq_abi_build. Declaring it builds nothing.
DuckPGQAbiClause <- 'WITH' 'ABI' Parens(List(DuckPGQAbiOption))
DuckPGQAbiOption <- ColId NamedParameterAssignment Expression

# Vertex and edge tables. NODE and RELATIONSHIP are the standard's synonyms.
DuckPGQVertexTables <- DuckPGQVertexKeyword 'TABLES' Parens(List(DuckPGQVertexTable))
DuckPGQEdgeTables <- DuckPGQEdgeKeyword 'TABLES' Parens(List(DuckPGQEdgeTable))
DuckPGQVertexKeyword <- 'VERTEX' / 'NODE'
DuckPGQEdgeKeyword <- 'EDGE' / 'RELATIONSHIP'
DuckPGQVertexTable <- BaseTableName TableAliasAs? DuckPGQLabelsAndProperties
DuckPGQEdgeTable <- BaseTableName TableAliasAs? DuckPGQSourceReference DuckPGQDestinationReference DuckPGQLabelsAndProperties

# Labels with their properties, in the standard's order (LABEL l PROPERTIES (...), repeated), after an optional
# PROPERTIES clause of the first label in this extension's original order (PROPERTIES (...) LABEL l).
DuckPGQLabelsAndProperties <- DuckPGQProperties? DuckPGQLabelEntry* DuckPGQSubLabels?
DuckPGQLabelEntry <- DuckPGQLabelName DuckPGQSubLabels? DuckPGQProperties?
DuckPGQLabelName <- DuckPGQDefaultLabel / DuckPGQNamedLabel
DuckPGQDefaultLabel <- 'DEFAULT' 'LABEL'
DuckPGQNamedLabel <- 'LABEL' ColId

# Property selection and aliases. Try EXCEPT before its ALL COLUMNS prefix.
DuckPGQProperties <- DuckPGQAllColumnsExcept / DuckPGQAllColumns / DuckPGQAllProperties / DuckPGQNoProperties / DuckPGQPropertyList
DuckPGQAllColumns <- 'PROPERTIES' 'ARE'? 'ALL' 'COLUMNS'
DuckPGQAllColumnsExcept <- 'PROPERTIES' 'ARE'? 'ALL' 'COLUMNS' 'EXCEPT' Parens(List(ColId))
DuckPGQAllProperties <- 'ALL' 'PROPERTIES'
DuckPGQNoProperties <- 'NO' 'PROPERTIES'
DuckPGQPropertyList <- 'PROPERTIES' Parens(List(DuckPGQProperty))
DuckPGQProperty <- ColId DuckPGQPropertyAlias?
DuckPGQPropertyAlias <- 'AS' ColId

# Discriminator sub-labels: rows whose discriminator has bit i set also carry the i-th of these labels.
DuckPGQSubLabels <- 'IN' Identifier Parens(List(ColId))

# Edge endpoint references, with explicit or inferred keys.
DuckPGQSourceReference <- 'SOURCE' DuckPGQReference
DuckPGQDestinationReference <- 'DESTINATION' DuckPGQReference
DuckPGQReference <- DuckPGQKeyReference / BaseTableName
DuckPGQKeyReference <- 'KEY' Parens(List(ColId)) 'REFERENCES' BaseTableName Parens(List(ColId))
